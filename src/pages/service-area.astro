---
import { jsonLd } from '../lib/jsonld.js';
import Base from '../layouts/Base.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import { TOWNS } from '../lib/service-area.js';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Service area', item: `${origin}${base}service-area/` },
  ],
};
---

<Base
  title="Service Area: Saugus, North Shore & Boston | S. Meredith"
  description={`Check whether Shane serves your town. S. Meredith Plumbing & Heating is based in Saugus, MA and serves ${TOWNS.length} North Shore and Boston-area towns.`}
  pageType="service-area"
  current="service-area"
>
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  <main id="main">
    <div class="container page-head">
      <p class="breadcrumb"><a href={base}>Home</a> / Service area</p>
      <h1>Service area</h1>
      <p class="lede">Shane is based in Saugus and serves these towns. Pick yours to check it and open the request form with it filled in. If your town is not listed, contact Shane to confirm availability.</p>
    </div>

    <section class="section" id="area" aria-labelledby="area-h">
      <div class="container">
        <h2 class="section-title" id="area-h">Check your town</h2>
        <ServiceAreaChecker showMap />
      </div>
    </section>

    <section class="band on-dark" aria-labelledby="area-contact-h">
      <div class="container">
        <h2 id="area-contact-h">Not sure if Shane covers you?</h2>
        <p>Call or text and he will tell you. If you are close, ask.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost-dark" href={`${base}contact/`}>Request service</a>
        </div>
      </div>
    </section>
  </main>
</Base>
