---
import { jsonLd } from '../lib/jsonld.js';
import Base from '../layouts/Base.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import { TOWNS } from '../lib/service-area.js';
import areas from '../areas.json';
import townHeating from '../town-heating.json';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');

// Every town page, in the confirmed-list order, with its own one-line summary and its oil-heat share (Census).
const townPages = TOWNS.map((t) => ({ t, a: areas.find((a) => a.slug === t.slug), h: (townHeating.towns as Record<string, { oil: number; pre1940: number }>)[t.slug] }))
  .filter((x) => x.a);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Service area', item: `${origin}${base}service-area/` },
  ],
};
---

<Base
  title="Service Area: Saugus, North Shore & Boston | S. Meredith"
  description={`Check whether Shane serves your town. S. Meredith Plumbing & Heating is based in Saugus, MA and serves ${TOWNS.length} North Shore and Boston-area towns.`}
  pageType="service-area"
  current="service-area"
>
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  <main id="main">
    <div class="container page-head">
      <p class="breadcrumb"><a href={base}>Home</a> / Service area</p>
      <h1>Service area</h1>
      <p class="lede">Shane is based in Saugus. Enter your ZIP code to check your area: confirmed towns open the request form with the town filled in, and anywhere else nearby gets a quick call to confirm.</p>
    </div>

    <section class="section" id="area" aria-labelledby="area-h">
      <div class="container">
        <h2 class="section-title" id="area-h">Check your area</h2>
        <ServiceAreaChecker showMap />
      </div>
    </section>

    <section class="section" id="town-pages" aria-labelledby="towns-h">
      <div class="container">
        <h2 class="section-title" id="towns-h">Town pages</h2>
        <p class="section-note">Each page has Shane's work in that town where there is some, how the town heats and who supplies its gas.</p>
        <ul class="vanlist">
          {townPages.map(({ t, a, h }) => (
            <li>
              <a class="row-main" href={`${base}areas/${t.slug}/`}>
                <span class="row-name">{t.name}</span>
                <span class="row-note">{a!.tagline}{h ? ` ${h.oil}% of homes heat with oil.` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="more-link">Heating questions: <a href={`${base}heating/`}>heating help</a> and the <a href={`${base}services/oil-to-gas-conversion/`}>oil to gas conversion guide</a>. Oil shares: <a href={townHeating.source.census.href} rel="noopener">U.S. Census, 2019-2023</a>.</p>
      </div>
    </section>

    <section class="band on-dark" aria-labelledby="area-contact-h">
      <div class="container">
        <h2 id="area-contact-h">Not sure if Shane covers you?</h2>
        <p>Call or text and he will tell you. If you are close, ask.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost-dark" href={`${base}contact/`}>Request service</a>
        </div>
      </div>
    </section>
  </main>
</Base>
