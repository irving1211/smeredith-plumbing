---
import { jsonLd } from '../../lib/jsonld.js';
import Base from '../../layouts/Base.astro';
import services from '../../services.json';
import areas from '../../areas.json';
import jobs from '../../jobs.json';
import ServiceAreaChecker from '../../components/ServiceAreaChecker.astro';
import { TOWNS } from '../../lib/service-area.js';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent(`Hi Shane — I'd like help with: ${service.title}. `)}`;
// The service travels into the request form by its stable id (the form lets the visitor change it).
const formId = (service as { service_id?: string }).service_id ?? service.slug;
const contactHref = `${base}contact/?service=${formId}`;
const pageUrl = `${origin}${base}services/${service.slug}/`;
const hubUrl = `${origin}${base}services/`;
type Job = (typeof jobs)[number];
type Extra = {
  service_id?: string;
  hub?: string;
  scenarios_title?: string;
  jobs?: string[];
  jobs_title?: string;
  steps_title?: string;
  steps?: Array<{ h: string; b: string }>;
  sections?: Array<{ h: string; p: string[]; list?: string[] }>;
  facts?: { title: string; checked: string; intro?: string; items: Array<{ t: string; src: string; href: string }> };
};
const extra = service as typeof service & Extra;
// A page can name its own job photos (src/jobs.json slugs, in order); otherwise jobs with the same form id or tag.
const relatedJobs: Job[] = extra.jobs
  ? extra.jobs.map((slug) => jobs.find((j) => j.slug === slug)).filter((j): j is Job => Boolean(j))
  : jobs.filter((j) => j.service === formId || (j as { tags?: string[] }).tags?.includes(service.slug)).slice(0, 3);
// Heating pages list the other heating pages first, so the heating cluster links to itself (hub and spokes).
const inHub = (s: typeof service) => (s as Extra).hub === 'heating';
const relatedServices = services.filter((s) => s.slug !== service.slug).sort((a, b) => (extra.hub ? Number(inHub(b)) - Number(inHub(a)) : 0));
const approvedTowns = TOWNS.map((t) => t.name);

// Copy may contain {{target|link text}} markers: a service slug, a site path starting with "/", or an https source.
type Part = string | { href: string; text: string; external?: boolean };
const linkify = (text: string): Part[] =>
  text.split(/(\{\{[^|}]+\|[^}]+\}\})/).map((part) => {
    const m = part.match(/^\{\{([^|}]+)\|([^}]+)\}\}$/);
    if (!m) return part;
    if (/^https:\/\//.test(m[1])) return { href: m[1], text: m[2], external: true };
    if (m[1].startsWith('/')) return { href: `${base}${m[1].replace(/^\//, '')}`, text: m[2] };
    return { href: `${base}services/${m[1]}/`, text: m[2] };
  });
const plain = (text: string) => linkify(text).map((p) => (typeof p === 'string' ? p : p.text)).join('');
const qa = (service as { qa?: Array<{ q: string; a: string; list?: string[] }> }).qa || [];
// FAQPage schema mirrors the visible questions and answers word for word (a test checks this).
const faqs = qa.map((item) => ({ q: item.q, a: plain(item.a) }));

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.title,
  name: service.title,
  description: service.meta_desc,
  url: pageUrl,
  // A reference to the one business node in the base layout (same page), not a second copy of it.
  provider: { '@id': `${origin}/#business` },
  areaServed: approvedTowns.map((town) => ({ '@type': 'City', name: `${town}, MA` })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: hubUrl },
    { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
  ],
};
---

<Base title={service.seo_title} description={service.meta_desc} pageType="service" current={extra.hub === 'heating' ? 'heating' : 'services'} pageMeta={{ service_type: service.slug }} faqs={faqs}>
  <script type="application/ld+json" set:html={jsonLd(serviceJsonLd)} slot="head" />
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href={base}>Home</a> <span aria-hidden="true">›</span> {extra.hub === 'heating' ? <a href={`${base}heating/`}>Heating</a> : <a href={`${base}services/`}>Services</a>} <span aria-hidden="true">›</span> <span class="current" aria-current="page">{service.title}</span>
    </div>
  </nav>

  <main id="main">
  <section class="page-hero">
    <div class="container">
      <h1>{service.h1}</h1>
      <p class="tagline">{service.tagline}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" href={smsHref}>Text photos to Shane</a>
        <a class="btn btn-ghost" href={contactHref}>Request service online</a>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <p class="intro">{service.intro}</p>

      <h2>{extra.scenarios_title || 'What we handle'}</h2>
      <div class="scenario-list">
        {service.scenarios.map((s) => (
          <div class="scenario">
            <h3>{s.h}</h3>
            <p>{s.b}</p>
          </div>
        ))}
      </div>

      {extra.steps && (
        <section class="steps" id="how-it-goes" aria-labelledby="steps-h">
          <h2 id="steps-h">{extra.steps_title || 'How it goes'}</h2>
          <ol class="step-list">
            {extra.steps.map((st) => (
              <li>
                <h3>{st.h}</h3>
                <p>{linkify(st.b).map((p) => (typeof p === 'string' ? p : <a href={p.href} rel={p.external ? 'noopener' : undefined}>{p.text}</a>))}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {extra.sections && extra.sections.map((sec) => (
        <section class="prose-block">
          <h2>{sec.h}</h2>
          {sec.p.map((para) => <p>{linkify(para).map((p) => (typeof p === 'string' ? p : <a href={p.href} rel={p.external ? 'noopener' : undefined}>{p.text}</a>))}</p>)}
          {sec.list && <ul>{sec.list.map((li) => <li>{linkify(li).map((p) => (typeof p === 'string' ? p : <a href={p.href} rel={p.external ? 'noopener' : undefined}>{p.text}</a>))}</li>)}</ul>}
        </section>
      ))}

      {extra.facts && (
        <section class="facts" id="checked-facts" aria-labelledby="facts-h">
          <h2 id="facts-h">{extra.facts.title}</h2>
          <p class="facts-checked">Checked {extra.facts.checked}. Rules and prices change; each line links to its source.</p>
          {extra.facts.intro && <p>{extra.facts.intro}</p>}
          <ul>
            {extra.facts.items.map((it) => <li>{it.t} <a href={it.href} rel="noopener">{it.src}</a></li>)}
          </ul>
        </section>
      )}

      <div class="guarantee">
        <strong>Licensed &amp; code-compliant.</strong> {service.guarantee}
      </div>

      {qa.length > 0 && (
        <section class="homeowner-qa" id="homeowner-questions" aria-labelledby="homeowner-qa-h">
          <h2 id="homeowner-qa-h">{(service as { qa_title?: string }).qa_title}</h2>
          {qa.map((item) => (
            <div class="qa-item">
              <h3>{item.q}</h3>
              {item.list && <ul>{item.list.map((li) => <li>{li}</li>)}</ul>}
              <p>{linkify(item.a).map((p) => (typeof p === 'string' ? p : <a href={p.href} rel={p.external ? 'noopener' : undefined}>{p.text}</a>))}</p>
            </div>
          ))}
          {(service as { send_for_quote?: string }).send_for_quote && (
            <p class="qa-send"><strong>For a faster quote.</strong> {(service as { send_for_quote?: string }).send_for_quote}</p>
          )}
          <div class="hero-cta qa-cta">
            <a class="btn btn-primary" href={contactHref}>Request a quote</a>
            <a class="btn btn-ghost" href={smsHref}>Text photos to Shane</a>
          </div>
        </section>
      )}

      {relatedJobs.length > 0 && (
        <section class="related-work" id="related-work" aria-labelledby="related-work-h">
          <h2 id="related-work-h">{extra.jobs_title || 'Recent jobs like this'}</h2>
          <div class="job-row">
            {relatedJobs.map((job) => (
              <figure class="job-thumb">
                <img src={`${base}${job.photos[0].src.replace(/^\//, '')}`} srcset={`${base}${job.photos[0].src.replace(/^\//, '').replace(/-900\.webp$/, '-480.webp')} 480w, ${base}${job.photos[0].src.replace(/^\//, '')} 900w`} sizes="(min-width: 768px) 236px, 45vw" alt={`${job.title} by S. Meredith Plumbing & Heating`} width={job.photos[0].width} height={job.photos[0].height} loading="lazy" decoding="async" />
                <figcaption>{job.title}</figcaption>
              </figure>
            ))}
          </div>
          <p class="more-link"><a href={`${base}#work`}>See more recent jobs →</a></p>
        </section>
      )}

      <section class="where" id="service-towns" aria-labelledby="service-towns-h">
        <h2 id="service-towns-h">Where Shane does this work</h2>
        <p>Based in Saugus and serving {approvedTowns.slice(1, -1).join(', ')} and {approvedTowns.at(-1)}. Check your town and the request form opens with this service already selected.</p>
        <ServiceAreaChecker service={formId} showMap={false} uid="svc-area" />
        <ul class="link-pills">
          {areas.map((a) => <li><a href={`${base}areas/${a.slug}/`}>Plumber in {a.town}</a></li>)}
        </ul>
      </section>

      <div class="page-cta" id="service-cta">
        <h2>Ready when you are.</h2>
        <p>One number. Owner answers. 24/7 emergency service. Master plumber, MA license #9630040-PL-M.</p>
        <div class="hero-cta">
          <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost big" href={smsHref}>Text photos for a quote</a>
          <a class="btn btn-ghost big" href={contactHref}>Request service</a>
        </div>
      </div>

      <section class="related-services" id="related-services" aria-labelledby="related-services-h">
        {extra.hub === 'heating' && <p class="hub-link">All heating help in one place: <a href={`${base}heating/`}>Heating: oil-to-gas, boilers, no-heat calls →</a></p>}
        <h2 id="related-services-h">Related services</h2>
        <ul class="link-pills">
          {relatedServices.map((s) => <li><a href={`${base}services/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
      </section>

      <p class="back-link"><a href={`${base}services/`}>← All services</a></p>
    </div>
  </section>

  </main>
  <style>
    .breadcrumb { padding: 1rem 0; background: var(--paper-2); border-bottom: 1px solid var(--line); font-size: .88rem; color: var(--ink-muted); }
    .breadcrumb a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .breadcrumb a:hover { color: var(--red); opacity: 1; }
    .breadcrumb span { margin: 0 .35rem; color: var(--ink-muted); }
    .breadcrumb .current { color: var(--ink); font-weight: 500; }

    .page-hero { padding: 5rem 0 3rem; background: var(--paper); }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; max-width: 22ch; }
    .page-hero .tagline { font-size: 1.15rem; color: var(--ink-soft); margin-bottom: 2rem; max-width: 60ch; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; }

    .page-body { padding: 3rem 0 7rem; background: var(--paper); }
    .page-body .container { max-width: 800px; }
    .intro { font-size: 1.15rem; line-height: 1.7; color: var(--ink); margin-bottom: 3rem; padding: 1.6rem 1.8rem; background: var(--paper-2); border-left: 3px solid var(--red); border-radius: 8px; }
    .page-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2.5rem 0 1.5rem; letter-spacing: -0.02em; }
    .scenario-list { display: flex; flex-direction: column; gap: 1.4rem; margin-bottom: 3rem; }
    .scenario { background: var(--color-surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.5rem 1.7rem; transition: border-color .25s ease; }
    .scenario:hover { border-color: var(--line-2); }
    .scenario h3 { font-size: 1.1rem; margin-bottom: .55rem; letter-spacing: -0.015em; }
    .scenario p { color: var(--ink-soft); margin: 0; line-height: 1.6; }

    .guarantee { background: var(--highlight); border-radius: var(--radius-md); padding: 1.4rem 1.7rem; margin-bottom: 3rem; line-height: 1.6; color: var(--ink); border: 1px solid rgba(184,138,58,.25); }
    .guarantee strong { display: inline-block; margin-right: .35rem; color: var(--black); }

    .homeowner-qa { margin: 0 0 3rem; }
    .homeowner-qa .qa-item { padding: 1.4rem 0; border-top: 1px solid var(--line); }
    .homeowner-qa .qa-item:first-of-type { border-top: 0; }
    .homeowner-qa h3 { font-size: 1.12rem; letter-spacing: -0.015em; margin-bottom: .6rem; }
    .homeowner-qa p, .homeowner-qa li { color: var(--ink-soft); line-height: 1.65; }
    .homeowner-qa p { margin: 0; }
    .homeowner-qa ul { margin: 0 0 .8rem; padding-left: 1.2rem; display: grid; gap: .35rem; }
    .homeowner-qa a { color: var(--black); font-weight: 600; text-decoration: underline; text-underline-offset: .18em; }
    .homeowner-qa a.btn { text-decoration: none; }
    .homeowner-qa a.btn-primary { color: #fff; }
    .qa-send { margin-top: 1.4rem !important; padding: 1rem 1.2rem; background: var(--paper-2); border-left: 3px solid var(--gold); border-radius: 6px; }
    .qa-send strong { color: var(--black); }
    .qa-cta { margin-top: 1.4rem; }
    .page-cta { background: var(--paper-2); border-radius: var(--radius-md); padding: 3rem 2rem; text-align: center; margin: 4rem 0 2rem; }
    .page-cta h2 { margin-bottom: 1rem; }
    .page-cta p { color: var(--ink-soft); margin-bottom: 2rem; }
    .page-cta .hero-cta { justify-content: center; }
    .btn.big { font-size: 1.05rem; padding: 1.15rem 2.1rem; }

    .hero-alt { margin: 1rem 0 0; font-weight: 600; }
    .hero-alt a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .link-pills { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
    .link-pills a { display: inline-block; background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius-md); padding: .55rem 1rem; font-weight: 600; font-size: .92rem; color: var(--ink); }
    .link-pills a:hover { border-color: var(--red); color: var(--red); opacity: 1; }
    .where p, .related-services p { color: var(--ink-soft); line-height: 1.65; }
    .job-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: start; }
    .job-thumb { margin: 0; background: var(--color-surface); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
    .job-thumb img { width: 100%; height: auto; }
    .job-thumb figcaption { padding: .7rem .9rem; font-weight: 600; font-size: .92rem; }
    .more-link { margin-top: 1rem; }
    .more-link a { color: var(--black); font-weight: 700; text-decoration: underline; text-underline-offset: .18em; }

    .step-list { list-style: none; counter-reset: step; padding: 0; margin: 0 0 3rem; display: grid; gap: 1.1rem; }
    .step-list li { counter-increment: step; position: relative; padding: 1.2rem 1.4rem 1.2rem 4rem; background: var(--color-surface); border: 1px solid var(--line); border-radius: var(--radius-md); }
    .step-list li::before { content: counter(step); position: absolute; left: 1.2rem; top: 1.05rem; font-family: var(--font-display); font-weight: 700; font-size: 1.8rem; line-height: 1; color: var(--color-action); }
    .step-list h3 { font-size: 1.08rem; margin-bottom: .4rem; }
    .step-list p, .prose-block p, .prose-block li, .facts li, .facts p { color: var(--ink-soft); line-height: 1.65; }
    .step-list p { margin: 0; }
    .prose-block { margin: 0 0 2.5rem; }
    .prose-block p { margin: 0 0 1rem; }
    .prose-block ul, .facts ul { padding-left: 1.2rem; display: grid; gap: .45rem; margin: 0 0 1rem; }
    .prose-block a, .facts a, .step-list a, .hub-link a { color: var(--black); font-weight: 600; text-decoration: underline; text-underline-offset: .18em; }
    .facts { margin: 0 0 3rem; padding: 1.5rem 1.7rem; background: var(--paper-2); border-left: 3px solid var(--color-action); border-radius: 8px; }
    .facts h2 { margin-top: 0; }
    .facts .facts-checked { font-size: .92rem; color: var(--ink-muted); margin: -.8rem 0 1rem; }
    .hub-link { margin: 2rem 0 0; font-weight: 600; }
    .back-link { text-align: center; color: var(--ink-muted); margin-top: 2rem; }
    .back-link a { color: var(--ink-soft); font-weight: 500; }
    .back-link a:hover { color: var(--red); opacity: 1; }

    @media (max-width: 900px) {
      .page-hero { padding: 3rem 0 2rem; }
      .hero-cta { flex-direction: column; gap: .65rem; }
      .hero-cta .btn { justify-content: center; width: 100%; }
      .page-cta { padding: 2.5rem 1.5rem; }
    }
  </style>
</Base>
