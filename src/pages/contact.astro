---
import { jsonLd } from '../lib/jsonld.js';
import Base from '../layouts/Base.astro';
import serviceOptions from '../service-options.json';
import heardAbout from '../heard-about.json';
import { TOWNS } from '../lib/service-area.js';
import { DEFAULT_PLACEHOLDER, ISSUE_SATISFIES_DESCRIPTION, NON_ANSWERS, TIMING, announceFor, fieldName, placeholderFor, questionsFor } from '../lib/request-questions.js';
import questionData from '../request-questions.json';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const publicEmail = 'shane@smeredithplumbing.com';
const publicEmailHref = `mailto:${publicEmail}`;
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent('Hi Shane — ')}`;
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const townNames = Object.fromEntries(TOWNS.map((t) => [t.slug, t.name]));
// Optional bot protection. Renders only when a Turnstile site key is present at build time AND the
// Pages secret TURNSTILE_SECRET_KEY is set (see docs). Off by default: no third-party script loads.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const privacyPublished = import.meta.env.PUBLIC_PRIVACY_PUBLISHED === '1';

// Tile order: the emergency tile first (it is full width), then Shane's priority work, then the catch-alls.
const tileOrder = ['water-heater-replacement', 'boiler-service', 'kitchen-bath-remodels', 'new-construction-plumbing', 'gas-installation', 'general-plumbing', 'not-sure', 'other'];
const byId = (id: string) => serviceOptions.find((o) => o.id === id)!;
const emergency = byId('emergency-plumbing');
const tiles = tileOrder.map((id) => byId(id));
const tileText = (o: { id: string; label: string; short: string }) => (o.id === 'other' ? o.label : o.short);
const questionServices = Object.keys(questionData.services);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Request service', item: `${origin}${base}contact/` },
  ],
};
---

<Base title="Request Plumbing Service in Saugus, MA | S. Meredith" description="Request plumbing or heating service from Shane Meredith in Saugus, MA. Choose the service and your town, or call 781-820-4592 for 24/7 emergency service." pageType="contact">
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  <Fragment slot="head">{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}</Fragment>

  <main id="main" class="request">
    <div class="container request-wrap">
      <div class="page-head">
        <h1>Request service</h1>
        <p class="lede">The details go straight to Shane, who reviews them and calls you back. If it can't wait, call or text.</p>
        <div class="actions quick-contact">
          <a class="btn btn-primary btn-sm" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-secondary btn-sm" href={smsHref} data-contact-text>Text photos</a>
        </div>
      </div>

      <div class="form-status" id="form-status" role="alert" tabindex="-1" hidden>
        <p class="status-title" id="form-status-text"></p>
        <ul class="status-list" id="form-status-list" hidden></ul>
        <div class="status-actions" id="form-status-actions" hidden>
          <a class="btn btn-primary btn-sm" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-secondary btn-sm" href={smsHref} data-contact-text>Text Shane</a>
          <a class="btn btn-secondary btn-sm" id="mailto-fallback" href={publicEmailHref}>Email instead</a>
        </div>
      </div>

      <form
        id="service-request-form"
        action={`${base}api/contact`}
        method="POST"
        enctype="multipart/form-data"
        data-towns={JSON.stringify(townNames)}
        data-issue-satisfies={String(ISSUE_SATISFIES_DESCRIPTION)}
        data-default-placeholder={DEFAULT_PLACEHOLDER}
        data-non-answers={JSON.stringify([...NON_ANSWERS])}
      >
        <div class="hp" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="request_id" value="" data-request-id />
        <input type="hidden" name="utm_source" value="" data-attr />
        <input type="hidden" name="utm_medium" value="" data-attr />
        <input type="hidden" name="utm_campaign" value="" data-attr />
        <input type="hidden" name="landing_page" value="" data-attr />
        <input type="hidden" name="referrer" value="" data-attr />
        <input type="hidden" name="latest_utm_source" value="" data-attr />
        <input type="hidden" name="latest_utm_medium" value="" data-attr />
        <input type="hidden" name="latest_utm_campaign" value="" data-attr />

        <fieldset class="group" id="field-service">
          <legend>What do you need?</legend>
          <p class="hint prefill-note" id="prefill-note" hidden>Filled in from the page you came from. Change anything that's wrong.</p>
          <div class="chosen" id="service-chosen" hidden>
            <p class="chosen-text"><strong id="service-chosen-name"></strong></p>
            <button type="button" class="chosen-change" id="service-change" aria-expanded="false" aria-controls="service-tiles">Change</button>
          </div>
          <div class="tiles" id="service-tiles">
            <label class="tile tile-urgent">
              <input type="radio" name="service_type" value={emergency.id} />
              <span>{emergency.label}</span>
            </label>
            {tiles.map((o) => (
              <label class="tile">
                <input type="radio" name="service_type" value={o.id} />
                <span>{tileText(o)}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <p class="visually-hidden" id="reveal-status" role="status" aria-live="polite"></p>
        {questionServices.map((serviceId) => (
          <div class="q-group" data-service-group={serviceId} data-announce={announceFor(serviceId)} data-placeholder={placeholderFor(serviceId)} hidden>
            {questionsFor(serviceId).map((q) => (
              <fieldset class="group q" data-issue={q.issue ? 'true' : undefined}>
                <legend>{q.label} <span class="optional">(optional)</span></legend>
                <div class="chips">
                  {q.options.map((opt) => (
                    <label class="chip">
                      <input type="radio" name={fieldName(q.id)} value={opt.id} disabled />
                      <span>{opt.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        ))}

        <fieldset class="group" id="field-timing">
          <legend>How soon do you need help? <span class="optional">(optional)</span></legend>
          <div class="chips">
            {TIMING.map((t) => (
              <label class="chip">
                <input type="radio" name="timing" value={t.id} />
                <span>{t.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="notice emergency-note" id="emergency-note" hidden>
          <strong>No heat, a burst pipe or no hot water?</strong> Call Shane now at <a href={`tel:${phoneTel}`}>{phone}</a>. A form can wait; a flooded basement can't. You can still send this request.
        </p>

        <div class="field" id="field-address-wrap">
          <label for="address">Town</label>
          <input type="text" id="address" name="address" required placeholder="e.g. Saugus" autocomplete="address-level2" list="town-list" aria-describedby="town-status" />
          <datalist id="town-list">
            {TOWNS.map((t) => <option value={t.name}></option>)}
          </datalist>
          <p class="hint town-status" id="town-status" role="status" aria-live="polite"></p>
        </div>

        <div class="field" id="field-name-wrap">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" required autocomplete="name" spellcheck="false" />
        </div>

        <div class="field-row">
          <div class="field" id="field-phone-wrap">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="(781) 820-4592" />
          </div>
          <div class="field" id="field-email-wrap">
            <label for="email">Email <span class="optional">(optional)</span></label>
            <input type="email" id="email" name="email" autocomplete="email" inputmode="email" spellcheck="false" />
          </div>
        </div>

        <div class="field" id="field-message-wrap">
          <label for="message"><span id="message-label">Describe the problem</span></label>
          <textarea id="message" name="message" rows="3" required placeholder={DEFAULT_PLACEHOLDER}></textarea>
        </div>

        <div class="field" id="field-photo-wrap">
          <label for="photo">Add a photo <span class="optional">(optional)</span></label>
          <input type="file" id="photo" name="photo" accept="image/*" aria-describedby="photo-help" />
          <p class="hint" id="photo-help">Helps Shane see what he is dealing with.</p>
        </div>

        <details class="more">
          <summary>Add a street address <span class="optional">(optional)</span></summary>
          <div class="field">
            <label for="street">Street address</label>
            <input type="text" id="street" name="street" autocomplete="address-line1" />
          </div>
        </details>

        <div class="field">
          <label for="heard_about">How did you hear about us? <span class="optional">(optional)</span></label>
          <select id="heard_about" name="heard_about">
            <option value="">Choose one</option>
            {heardAbout.map((h) => <option value={h.id}>{h.label}</option>)}
          </select>
        </div>

        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-appearance="interaction-only"></div>}

        <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">Send request</button>
        <p class="form-privacy">What you enter is emailed to Shane so he can answer your request.{privacyPublished && <> <a href={`${base}privacy/`}>Privacy notice</a></>}</p>
      </form>

      <p class="alt-contact">Prefer email? <a href={publicEmailHref}>{publicEmail}</a></p>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('service-request-form');
      if (!form) return;
      const track = (event, params) => window.smTrack && window.smTrack(event, params);
      const $ = (id) => document.getElementById(id);
      const towns = JSON.parse(form.dataset.towns || '{}');
      const issueSatisfies = form.dataset.issueSatisfies === 'true';
      const nonAnswers = JSON.parse(form.dataset.nonAnswers || '[]');
      const defaultPlaceholder = form.dataset.defaultPlaceholder || '';
      const params = new URLSearchParams(window.location.search);
      const serviceRadios = [...form.querySelectorAll('input[name="service_type"]')];
      const timingRadios = [...form.querySelectorAll('input[name="timing"]')];
      const groups = [...form.querySelectorAll('[data-service-group]')];
      const addressInput = $('address');
      const message = $('message');
      const baseTitle = document.title;

      const selectedService = () => (serviceRadios.find((r) => r.checked) || {}).value || '';
      const selectedLabel = () => { const r = serviceRadios.find((x) => x.checked); return r ? r.nextElementSibling.textContent : ''; };
      const selectedTiming = () => (timingRadios.find((r) => r.checked) || {}).value || '';

      // ---- A fresh id per page load, so a double tap or retried post is recognised on the server ----
      const makeId = () => {
        if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
        const b = new Uint8Array(16); crypto.getRandomValues(b);
        b[6] = (b[6] & 0x0f) | 0x40; b[8] = (b[8] & 0x3f) | 0x80;
        const h = [...b].map((x) => x.toString(16).padStart(2, '0')).join('');
        return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
      };
      const requestId = form.querySelector('[data-request-id]');
      requestId.value = makeId();
      const button = $('submit-btn');
      const idleLabel = button.textContent;
      let sending = false;
      const resetSending = () => { sending = false; button.disabled = false; button.textContent = idleLabel; form.removeAttribute('aria-busy'); };
      // Coming back to a finished request with the Back button must not reuse its id, or a new request would be swallowed.
      // A page restored from the back/forward cache still thinks it is mid-send: give it a fresh id and a usable button.
      window.addEventListener('pageshow', (e) => { if (e.persisted) { requestId.value = makeId(); resetSending(); syncAll(false); } });

      // ---- Carry service + town from the page the visitor came from (editable) ----
      let prefilled = false;
      const wanted = serviceRadios.find((r) => r.value === params.get('service'));
      if (wanted) { wanted.checked = true; prefilled = true; }
      const wantedTown = params.get('town');
      // Free-text towns arrive through sessionStorage (town=other) so they never sit in a URL that analytics could record;
      // the plain GET form used without JavaScript still sends ?town_other=.
      let carried = '';
      if (wantedTown === 'other') {
        try { carried = sessionStorage.getItem('sm_town_other') || ''; sessionStorage.removeItem('sm_town_other'); } catch (_) {}
      }
      const otherTown = (carried || params.get('town_other') || '').replace(/[\u0000-\u001F]/g, '').trim().slice(0, 60);
      if (wantedTown && Object.prototype.hasOwnProperty.call(towns, wantedTown) && !addressInput.value) {
        addressInput.value = towns[wantedTown];
        prefilled = true;
      } else if (otherTown && !addressInput.value) {
        addressInput.value = otherTown;
        prefilled = true;
      }
      if (prefilled) $('prefill-note').hidden = false;
      // A service that came from another page is shown as one line with a Change button, so the form starts at the
      // questions that matter. Without JavaScript the full list stays visible.
      const tilesBox = $('service-tiles');
      const chosenBox = $('service-chosen');
      const changeBtn = $('service-change');
      if (wanted) {
        tilesBox.hidden = true;
        chosenBox.hidden = false;
        $('service-chosen-name').textContent = wanted.nextElementSibling.textContent;
        changeBtn.addEventListener('click', () => {
          tilesBox.hidden = false;
          chosenBox.hidden = true;
          changeBtn.setAttribute('aria-expanded', 'true');
          const current = serviceRadios.find((r) => r.checked) || serviceRadios[0];
          current.focus();
        });
      }

      // ---- Questions for the chosen service, the description rule, and the emergency nudge ----
      const status = $('reveal-status');
      const activeGroup = () => groups.find((g) => !g.hidden) || null;
      const issueAnswered = () => {
        const g = activeGroup();
        return !!g && [...g.querySelectorAll('fieldset[data-issue] input:checked')].some((i) => !nonAnswers.includes(i.value));
      };
      const hasIssueQuestion = () => { const g = activeGroup(); return !!g && !!g.querySelector('fieldset[data-issue]'); };
      const syncQuestions = (announce) => {
        const svc = selectedService();
        let shown = null;
        groups.forEach((g) => {
          const on = g.dataset.serviceGroup === svc;
          g.hidden = !on;
          g.querySelectorAll('input').forEach((i) => { i.disabled = !on; if (!on) i.checked = false; });
          if (on) shown = g;
        });
        // Say that questions appeared; focus is never moved on its own.
        status.textContent = announce && shown ? shown.dataset.announce : '';
        message.placeholder = shown ? shown.dataset.placeholder : defaultPlaceholder;
      };
      const syncMessageRule = () => {
        const optional = issueSatisfies && issueAnswered();
        message.required = !optional;
        $('message-label').textContent = optional ? 'Anything else Shane should know? (optional)' : hasIssueQuestion() ? 'Or describe the problem' : 'Describe the problem';
      };
      const syncEmergency = () => { $('emergency-note').hidden = !(selectedService() === 'emergency-plumbing' || selectedTiming() === 'now'); };
      const textLinks = document.querySelectorAll('[data-contact-text]');
      const syncTextLinks = () => {
        const svc = selectedService();
        const where = addressInput.value.trim();
        const body = `Hi Shane — ${svc && svc !== 'other' && svc !== 'not-sure' ? `I need help with: ${selectedLabel()}` : 'I need a plumber'}${where ? ` (${where})` : ''}. `;
        textLinks.forEach((a) => { a.href = `sms:+17818204592?body=${encodeURIComponent(body)}`; });
      };
      function syncAll(announce) { syncQuestions(announce); syncMessageRule(); syncEmergency(); syncTextLinks(); }
      syncAll(false);

      // ---- Town coverage, in words, as you leave the field (never blocks the request) ----
      const townList = Object.entries(towns).map(([slug, name]) => [slug, name, name.toLowerCase()]);
      const normalize = (s) => s.toLowerCase().replace(/\./g, ' ').replace(/\s+/g, ' ').trim();
      const townFrom = (text) => {
        const segments = text.split(/[,;\n]+/).map((s) => s.trim()).filter(Boolean);
        for (let i = segments.length - 1; i >= 0; i--) {
          const key = normalize(segments[i]).replace(/^(?:the\s+)?(?:city|town)\s+of\s+/, '').replace(/,?\s*(?:ma|mass|massachusetts)\b.*$/, '').replace(/,?\s*\d{5}(?:-\d{4})?$/, '').trim();
          if (!key || /^(?:ma|mass|massachusetts|\d{5}(?:-\d{4})?)$/.test(key)) continue;
          return townList.find(([slug, , lower]) => lower === key || slug === key) || null;
        }
        return null;
      };
      const townStatus = $('town-status');
      const checkTown = () => {
        const value = addressInput.value.trim();
        if (!value) { townStatus.textContent = ''; return; }
        const hit = townFrom(value);
        townStatus.textContent = hit ? `Shane serves ${hit[1]}.` : "That town isn't on Shane's list yet. Send the request anyway and he will confirm.";
        syncTextLinks();
      };
      addressInput.addEventListener('change', checkTown);
      addressInput.addEventListener('blur', checkTown);
      addressInput.addEventListener('input', syncTextLinks);
      if (addressInput.value) checkTown();

      // ---- Lead attribution (first touch this visit + a separate later-campaign tag) ----
      let attr = {};
      try { attr = JSON.parse(sessionStorage.getItem('sm_attr') || '{}'); } catch (_) {}
      const first = attr.first || {};
      const latest = attr.latest || {};
      const values = {
        utm_source: first.utm_source, utm_medium: first.utm_medium, utm_campaign: first.utm_campaign,
        landing_page: first.landing_page, referrer: first.referrer,
        latest_utm_source: latest.utm_source, latest_utm_medium: latest.utm_medium, latest_utm_campaign: latest.utm_campaign,
      };
      form.querySelectorAll('[data-attr]').forEach((input) => { input.value = values[input.name] || ''; });

      track('request_form_open', { service_type: prefilled ? selectedService() : '' });
      let started = false;
      const markStarted = () => {
        if (started) return;
        started = true;
        track('form_start', { form_id: 'service_request', service_type: selectedService() });
      };
      form.addEventListener('focusin', markStarted);
      serviceRadios.forEach((r) => r.addEventListener('change', () => {
        markStarted();
        syncAll(true);
        track('service_select', { service_type: r.value });
      }));
      timingRadios.forEach((r) => r.addEventListener('change', syncEmergency));
      groups.forEach((g) => g.addEventListener('change', syncMessageRule));

      // ---- Errors: a summary that takes focus, a message at each field, and every answer kept ----
      const statusBox = $('form-status');
      const statusText = $('form-status-text');
      const statusList = $('form-status-list');
      const statusActions = $('form-status-actions');
      const messages = {
        validation: 'Something in the form needs another look: check the highlighted answers, remove extra links, and make sure any photo is a JPG, PNG, WebP or HEIC image under 6 MB. Or just call or text Shane.',
        photo: 'That photo is too large to send here (over 6 MB). Remove it and send the request, then text the photo to Shane.',
        delivery: 'Your request did not go through, and Shane has not received it. Try again in a minute, or call, text or email Shane directly.',
        network: 'We could not reach the server, so your request has not been sent. Check your connection and try again, or call, text or email Shane directly.',
        rate: 'Too many requests came from this connection in a short time. Please wait a few minutes, or call or text Shane.',
        verification: 'We could not confirm the request came from a person. Reload the page and try again, or call or text Shane.',
        blocked: 'This request was blocked for safety. Reload this page and try again, or call or text Shane.',
      };
      const clearFieldErrors = () => {
        form.querySelectorAll('.field-error').forEach((e) => e.remove());
        form.querySelectorAll('[aria-invalid]').forEach((el) => {
          el.removeAttribute('aria-invalid');
          const ids = (el.getAttribute('aria-describedby') || '').split(' ').filter((x) => x && !x.endsWith('-error'));
          if (ids.length) el.setAttribute('aria-describedby', ids.join(' ')); else el.removeAttribute('aria-describedby');
        });
        statusList.replaceChildren();
        statusList.hidden = true;
        document.title = baseTitle;
      };
      const showStatus = () => {
        statusBox.hidden = false;
        document.title = `Error: ${baseTitle}`;
        statusBox.focus();
        statusBox.scrollIntoView({ block: 'center' });
      };

      const EMAIL = /^[^\s@<>,;:"()[\]\\]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$/;
      const validate = () => {
        const problems = [];
        const add = (id, text) => problems.push({ id, text });
        if (!$('address').value.trim()) add('address', 'Enter your town');
        if (!$('name').value.trim()) add('name', 'Enter your name');
        const digits = $('phone').value.replace(/\D/g, '').length;
        if (!$('phone').value.trim()) add('phone', 'Enter a phone number Shane can call or text');
        else if (digits < 7) add('phone', 'Enter a phone number with at least 7 digits');
        const email = $('email').value.trim();
        if (email && !EMAIL.test(email)) add('email', 'Enter an email address like name@example.com, or leave it empty');
        if (message.required && !message.value.trim()) add('message', hasIssueQuestion() ? 'Choose what is going on above, or describe the problem' : 'Describe the problem');
        return problems;
      };
      const showProblems = (problems) => {
        clearFieldErrors();
        statusText.textContent = 'There is a problem';
        statusActions.hidden = true;
        problems.forEach((p) => {
          const input = $(p.id);
          const err = document.createElement('p');
          err.className = 'field-error';
          err.id = `${p.id}-error`;
          err.textContent = p.text;
          input.insertAdjacentElement('afterend', err);
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', [input.getAttribute('aria-describedby'), err.id].filter(Boolean).join(' '));
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${p.id}`;
          a.textContent = p.text;
          a.addEventListener('click', (e) => { e.preventDefault(); input.focus(); input.scrollIntoView({ block: 'center' }); });
          li.append(a);
          statusList.append(li);
        });
        statusList.hidden = false;
        showStatus();
        track('form_validation_error', { form_id: 'service_request', error_fields: problems.map((p) => p.id).join(','), error_count: String(problems.length), service_type: selectedService() });
      };

      // retained = the fetch path, where the page (and the visitor's answers) stay put. After a plain
      // form post the page reloads empty, so we must not claim their answers are still there.
      const showError = (code, retained) => {
        const key = Object.prototype.hasOwnProperty.call(messages, code) ? code : 'delivery';
        clearFieldErrors();
        statusText.textContent = messages[key] + (retained ? ' Your answers are still in the form.' : '');
        statusActions.hidden = key === 'validation';
        const label = selectedLabel() || 'Service request';
        const lines = [message.value.trim(), '', `Name: ${$('name').value.trim()}`, `Phone: ${$('phone').value.trim()}`, `Town/address: ${addressInput.value.trim()}`].join('\n');
        $('mailto-fallback').href = `mailto:shane@smeredithplumbing.com?subject=${encodeURIComponent('Service request - ' + label)}&body=${encodeURIComponent(lines)}`;
        showStatus();
        track('form_error', { form_id: 'service_request', error_type: key, service_type: selectedService() });
        // A Turnstile token can be used once; get a fresh one for the retry.
        try { if (window.turnstile && window.turnstile.reset) window.turnstile.reset(); } catch (_) {}
      };

      const initial = params.get('status');
      if (initial && Object.prototype.hasOwnProperty.call(messages, initial)) showError(initial);

      // ---- Submit: fetch when available (keeps the form on failure), native post otherwise ----
      // From here on the script owns validation, so the browser's own pop-up bubbles are switched off. If anything above
      // had failed, this line is never reached and the native checks (and the server's) stay as the fallback.
      form.noValidate = true;
      form.addEventListener('submit', async (event) => {
        if (!window.fetch || !window.FormData) return;
        event.preventDefault();
        if (sending) return;
        const problems = validate();
        if (problems.length) { showProblems(problems); return; }
        clearFieldErrors();
        statusBox.hidden = true;
        sending = true;
        button.disabled = true;
        button.textContent = 'Sending…';
        form.setAttribute('aria-busy', 'true');
        // An attempt, not a lead: leads are counted only from the confirmed thank-you page.
        track('form_submit_attempt', { form_id: 'service_request', service_type: selectedService(), timing: selectedTiming() });
        const finish = resetSending;
        try {
          const data = new FormData(form);
          // Phone photos are often 3-8 MB. Shrink big ones in the browser (longest side 1800 px, JPEG) so the
          // upload is fast and the server never has to handle a huge file. Anything we can't decode is sent as-is.
          const photo = data.get('photo');
          if (photo instanceof File && photo.size > 1500000 && /^image\/(jpeg|png|webp)$/.test(photo.type) && window.createImageBitmap) {
            try {
              const bitmap = await createImageBitmap(photo);
              const scale = Math.min(1, 1800 / Math.max(bitmap.width, bitmap.height));
              const canvas = document.createElement('canvas');
              canvas.width = Math.round(bitmap.width * scale);
              canvas.height = Math.round(bitmap.height * scale);
              canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
              const small = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.82));
              if (small && small.size < photo.size) data.set('photo', small, 'photo.jpg');
            } catch (_) { /* keep the original */ }
          }
          const sendingPhoto = data.get('photo');
          if (sendingPhoto instanceof File && sendingPhoto.size > 6 * 1024 * 1024) {
            showError('photo', true);
            finish();
            return;
          }
          const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          let body = null;
          try { body = await response.json(); } catch (_) {}
          if (response.ok && body && body.ok && body.redirect && new URL(body.redirect, location.href).origin === location.origin) {
            window.location.assign(body.redirect);
            return;
          }
          showError(body && body.error ? body.error : 'delivery', true);
        } catch (_) {
          showError('network', true);
        }
        finish();
      });
    });
  </script>

