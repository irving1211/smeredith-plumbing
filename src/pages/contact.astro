---
import Base from '../layouts/Base.astro';
import serviceOptions from '../service-options.json';
import heardAbout from '../heard-about.json';
import { TOWNS } from '../lib/service-area.js';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const publicEmail = 'shane@smeredithplumbing.com';
const publicEmailHref = `mailto:${publicEmail}`;
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent('Hi Shane — ')}`;
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const townNames = Object.fromEntries(TOWNS.map((t) => [t.slug, t.name]));
// Optional bot protection. Renders only when a Turnstile site key is present at build time AND the
// Pages secret TURNSTILE_SECRET_KEY is set (see docs). Off by default: no third-party script loads.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const privacyPublished = import.meta.env.PUBLIC_PRIVACY_PUBLISHED === '1';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Request service', item: `${origin}${base}contact/` },
  ],
};
---

<Base title="Request Plumbing Service in Saugus, MA | S. Meredith" description="Request plumbing or heating service from Shane Meredith in Saugus, MA. Send the details and a photo, or call 781-820-4592 for 24/7 emergency service." pageType="contact">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  <Fragment slot="head">{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}</Fragment>
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href={base}>
        <img class="brand-icon" src={`${base}images/logo-icon-128.webp`} alt="" width="40" height="40" />
        <span class="brand-wordmark">
          <strong>S. Meredith</strong>
          <em>Plumbing &amp; Heating</em>
        </span>
      </a>
      <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
    </div>
  </header>

  <main class="contact-main">
    <div class="container">
      <div class="contact-layout">

        <!-- Trust & Information Column -->
        <div class="contact-info">
          <span class="trust-badge">Licensed & Insured · MA #9630040-PL-M</span>
          <h1>Need service? <span class="display-serif">Shane will call</span> you back fast.</h1>

          <p class="lede">
            No automated switchboards or third-party call centers. When you request service below, the details go directly to Shane so he can review them and call you back shortly.
          </p>

          <div class="owner-card">
            <div class="owner-header">
              <img class="owner-image" src={`${base}images/shane.webp`} alt="Shane Meredith, owner-operator of S. Meredith Plumbing & Heating" width="112" height="112" loading="lazy" decoding="async" />
              <div class="owner-meta">
                <strong>Shane Meredith</strong>
                <span>Owner & Licensed Plumber</span>
              </div>
            </div>
            <p class="owner-quote">
              "I pride myself on clean craftsmanship, honest advice, and upfront pricing. I carry common parts on my truck to handle most boiler, water heater, and general plumbing repairs on the first visit."
            </p>
            <div class="owner-rating">
              <span class="stars">★★★★★</span>
              <span>5-star Google reviews</span>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="form-card">
          <div class="quick-contact">
            <p><strong>Rather talk or text?</strong> Shane answers his phone.</p>
            <div class="quick-contact-actions">
              <a class="btn btn-dark" href={`tel:${phoneTel}`}>Call {phone}</a>
              <a class="btn btn-secondary" href={smsHref} data-contact-text>Text photos</a>
            </div>
          </div>

          <div class="form-status" id="form-status" role="alert" tabindex="-1" hidden>
            <p id="form-status-text"></p>
            <div class="status-actions" id="form-status-actions" hidden>
              <a class="btn btn-dark" href={`tel:${phoneTel}`}>Call {phone}</a>
              <a class="btn btn-secondary" href={smsHref} data-contact-text>Text Shane</a>
              <a class="btn btn-secondary" id="mailto-fallback" href={publicEmailHref}>Email instead</a>
            </div>
          </div>
          <p class="prefill-note" id="prefill-note" hidden>We filled in the service and town from the page you came from. Change anything that's wrong.</p>

          <form
            id="service-request-form"
            action={`${base}api/contact`}
            method="POST"
            enctype="multipart/form-data"
            data-towns={JSON.stringify(townNames)}
          >
            <div class="hp" aria-hidden="true">
              <label>Leave this field empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
            </div>
            <input type="hidden" name="utm_source" value="" data-attr />
            <input type="hidden" name="utm_medium" value="" data-attr />
            <input type="hidden" name="utm_campaign" value="" data-attr />
            <input type="hidden" name="landing_page" value="" data-attr />
            <input type="hidden" name="referrer" value="" data-attr />
            <input type="hidden" name="latest_utm_source" value="" data-attr />
            <input type="hidden" name="latest_utm_medium" value="" data-attr />
            <input type="hidden" name="latest_utm_campaign" value="" data-attr />

            <div class="form-group">
              <label for="name">Your Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Your full name" autocomplete="name" />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="phone">Phone Number <span class="required">*</span></label>
                <input type="tel" id="phone" name="phone" required placeholder="(781) 820-4592" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="email">Email <span class="optional">(Optional)</span></label>
                <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" />
              </div>
            </div>

            <div class="form-group">
              <label for="address">Town or Address <span class="required">*</span></label>
              <input type="text" id="address" name="address" required placeholder="Where do you need service?" autocomplete="address-level2" list="town-list" />
              <datalist id="town-list">
                {TOWNS.map((t) => <option value={t.name}></option>)}
              </datalist>
            </div>

            <div class="form-group">
              <label for="service_type">What do you need?</label>
              <select id="service_type" name="service_type">
                {serviceOptions.map((o) => <option value={o.id} selected={Boolean((o as { default?: boolean }).default)}>{o.label}</option>)}
              </select>
              <p class="emergency-note" id="emergency-note" hidden>
                <strong>No heat, a burst pipe or no hot water?</strong> Call Shane now at <a href={`tel:${phoneTel}`}>{phone}</a>. A form can wait; a flooded basement can't.
              </p>
            </div>

            <div class="form-group">
              <label for="message">Describe the problem <span class="required">*</span></label>
              <textarea id="message" name="message" required rows="4" placeholder="Tell Shane what's going on (e.g. leaking pipe, boiler has no pressure, upgrading water heater)..."></textarea>
            </div>

            <div class="form-group">
              <label for="photo">Add a photo <span class="optional">(Optional — helps Shane triage)</span></label>
              <input type="file" id="photo" name="photo" accept="image/*" aria-describedby="photo-help" />
              <span class="file-help" id="photo-help">Take a photo of the leaking pipe, boiler, or water heater tag to help Shane diagnose it faster. Up to 10 MB.</span>
            </div>

            <div class="form-group">
              <label for="heard_about">How did you hear about us? <span class="optional">(Optional)</span></label>
              <select id="heard_about" name="heard_about">
                <option value="">Choose one</option>
                {heardAbout.map((h) => <option value={h.id}>{h.label}</option>)}
              </select>
            </div>

            {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-appearance="interaction-only"></div>}

            <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
              Send Request to Shane
            </button>
            <p class="form-privacy">What you enter is emailed to Shane so he can answer your request.{privacyPublished && <> <a href={`${base}privacy/`}>Privacy notice</a></>}</p>
          </form>

          <div class="direct-call-alt">
            <p>Immediate emergency? Call directly for 24/7 priority response:</p>
            <a class="btn btn-dark call-btn" href={`tel:${phoneTel}`}>Call {phone}</a>
            <p class="direct-email-alt">Prefer email? <a href={publicEmailHref}>{publicEmail}</a></p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('service-request-form');
      if (!form) return;
      const track = (event, params) => window.smTrack && window.smTrack(event, params);
      const $ = (id) => document.getElementById(id);
      const serviceSel = $('service_type');
      const addressInput = $('address');
      const towns = JSON.parse(form.dataset.towns || '{}');
      const params = new URLSearchParams(window.location.search);

      // ---- Carry service + town from the page the visitor came from (editable) ----
      let prefilled = false;
      const wantedService = params.get('service');
      if (wantedService && [...serviceSel.options].some((o) => o.value === wantedService)) {
        serviceSel.value = wantedService;
        prefilled = true;
      }
      const wantedTown = params.get('town');
      const otherTown = (params.get('town_other') || '').replace(/[\u0000-\u001F]/g, '').trim().slice(0, 60);
      if (wantedTown && Object.prototype.hasOwnProperty.call(towns, wantedTown) && !addressInput.value) {
        addressInput.value = towns[wantedTown];
        prefilled = true;
      } else if (otherTown && !addressInput.value) {
        addressInput.value = otherTown;
        prefilled = true;
      }
      if (prefilled) $('prefill-note').hidden = false;

      // ---- Emergency nudge: a form can wait, a flood can't ----
      const emergencyNote = $('emergency-note');
      const syncEmergency = () => { emergencyNote.hidden = serviceSel.value !== 'emergency-plumbing'; };
      serviceSel.addEventListener('change', syncEmergency);
      syncEmergency();

      // ---- Text link carries the chosen service/town ----
      const textLinks = document.querySelectorAll('[data-contact-text]');
      const syncTextLinks = () => {
        const label = serviceSel.options[serviceSel.selectedIndex]?.textContent || '';
        const where = addressInput.value.trim();
        const body = `Hi Shane — ${serviceSel.value && serviceSel.value !== 'other' ? `I need help with: ${label}` : 'I need a plumber'}${where ? ` (${where})` : ''}. `;
        textLinks.forEach((a) => { a.href = `sms:+17818204592?body=${encodeURIComponent(body)}`; });
      };
      serviceSel.addEventListener('change', syncTextLinks);
      addressInput.addEventListener('input', syncTextLinks);
      syncTextLinks();

      // ---- Lead attribution (first touch this visit + a separate later-campaign tag) ----
      let attr = {};
      try { attr = JSON.parse(sessionStorage.getItem('sm_attr') || '{}'); } catch (_) {}
      const first = attr.first || {};
      const latest = attr.latest || {};
      const values = {
        utm_source: first.utm_source, utm_medium: first.utm_medium, utm_campaign: first.utm_campaign,
        landing_page: first.landing_page, referrer: first.referrer,
        latest_utm_source: latest.utm_source, latest_utm_medium: latest.utm_medium, latest_utm_campaign: latest.utm_campaign,
      };
      form.querySelectorAll('[data-attr]').forEach((input) => { input.value = values[input.name] || ''; });

      track('request_form_open', { service_type: prefilled ? serviceSel.value : '' });
      let started = false;
      form.addEventListener('focusin', () => {
        if (started) return;
        started = true;
        track('form_start', { form_id: 'service_request', service_type: serviceSel.value });
      });

      // ---- Honest error handling: keep what they typed, say what happened, offer another route ----
      const statusBox = $('form-status');
      const statusText = $('form-status-text');
      const statusActions = $('form-status-actions');
      const messages = {
        validation: 'Something in the form needs another look: check the required fields, remove extra links, and make sure any photo is a JPG, PNG, HEIC or PDF under 10 MB. Or just call or text Shane.',
        delivery: 'Your request did not go through, and Shane has not received it. Try again in a minute, or call, text or email Shane directly.',
        network: 'We could not reach the server, so your request has not been sent. Check your connection and try again, or call, text or email Shane directly.',
        rate: 'Too many requests came from this connection in a short time. Please wait a few minutes, or call or text Shane.',
        verification: 'We could not confirm the request came from a person. Reload the page and try again, or call or text Shane.',
        blocked: 'This request was blocked for safety. Reload this page and try again, or call or text Shane.',
      };
      // retained = the fetch path, where the page (and the visitor's answers) stay put. After a plain
      // form post the page reloads empty, so we must not claim their answers are still there.
      const showError = (code, retained) => {
        const key = messages[code] ? code : 'delivery';
        statusText.textContent = messages[key] + (retained ? ' Your answers are still in the form.' : '');
        statusActions.hidden = key === 'validation';
        const label = serviceSel.options[serviceSel.selectedIndex]?.textContent || 'Service request';
        const lines = [$('message').value.trim(), '', `Name: ${$('name').value.trim()}`, `Phone: ${$('phone').value.trim()}`, `Town/address: ${addressInput.value.trim()}`].join('\n');
        $('mailto-fallback').href = `mailto:shane@smeredithplumbing.com?subject=${encodeURIComponent('Service request - ' + label)}&body=${encodeURIComponent(lines)}`;
        statusBox.hidden = false;
        statusBox.focus();
        statusBox.scrollIntoView({ block: 'center' });
        track('form_error', { form_id: 'service_request', error_type: key, service_type: serviceSel.value });
      };

      const initial = params.get('status');
      if (initial && messages[initial]) showError(initial);

      // ---- Submit: fetch when available (keeps the form on failure), native post otherwise ----
      const button = $('submit-btn');
      let sending = false;
      form.addEventListener('submit', async (event) => {
        if (!window.fetch || !window.FormData) return;
        event.preventDefault();
        if (sending) return;
        sending = true;
        const idle = button.textContent;
        button.disabled = true;
        button.textContent = 'Sending…';
        statusBox.hidden = true;
        // An attempt, not a lead: leads are counted only from the confirmed thank-you page.
        track('form_submit_attempt', { form_id: 'service_request', service_type: serviceSel.value });
        try {
          const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          let body = null;
          try { body = await response.json(); } catch (_) {}
          if (response.ok && body && body.ok && body.redirect && new URL(body.redirect, location.href).origin === location.origin) {
            window.location.assign(body.redirect);
            return;
          }
          showError(body && body.error ? body.error : 'delivery', true);
        } catch (_) {
          showError('network', true);
        }
        sending = false;
        button.disabled = false;
        button.textContent = idle;
      });
    });
  </script>

  <style>
    .topbar {
      background: rgba(250, 247, 242, 0.86);
      backdrop-filter: saturate(160%) blur(14px);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .topbar-row {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 0.8rem 1.75rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      color: var(--black);
    }
    .brand-icon {
      width: 40px;
      height: 40px;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }
    .brand:hover .brand-icon {
      transform: rotate(-4deg) scale(1.06);
    }
    .brand-wordmark {
      display: flex;
      flex-direction: column;
      line-height: 1.05;
    }
    .brand-wordmark strong {
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: -0.02em;
      color: var(--black);
    }
    .brand-wordmark em {
      font-style: normal;
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 500;
      font-size: 0.7rem;
      color: var(--ink-muted);
      letter-spacing: 0.04em;
      margin-top: 1px;
    }
    .topbar-call {
      padding: 0.55rem 1rem;
      background: var(--black);
      color: #fff;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.92rem;
      margin-left: auto;
      white-space: nowrap;
    }
    .topbar-call:hover {
      background: var(--red);
      color: #fff;
      opacity: 1;
    }

    .contact-main {
      padding: 4rem 0 6rem;
      background: var(--paper);
    }
    .contact-layout {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
      align-items: start;
    }

    .contact-info {
      max-width: 500px;
    }
    .trust-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--red-dark);
      background: var(--highlight);
      padding: 0.35rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 1.25rem;
    }
    .contact-info h1 {
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
    }
    .lede {
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--ink-soft);
      margin-bottom: 2.5rem;
    }

    .owner-card {
      background: var(--paper-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.75rem;
    }
    .owner-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .owner-image {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #ffffff;
      box-shadow: 0 4px 10px rgba(17, 17, 17, 0.08);
    }
    .owner-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
    .owner-meta strong {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--black);
    }
    .owner-meta span {
      font-size: 0.82rem;
      color: var(--ink-soft);
    }
    .owner-quote {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--ink);
      font-style: italic;
      margin: 0 0 1.25rem 0;
    }
    .owner-rating {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--black);
    }
    .owner-rating .stars {
      color: var(--gold);
      letter-spacing: 1px;
    }

    .form-card {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 2.5rem;
      box-shadow: 0 4px 12px rgba(17, 17, 17, 0.02), 0 16px 40px rgba(17, 17, 17, 0.04);
    }
    .form-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.25rem;
    }
    .form-status {
      margin-bottom: 1rem;
      padding: 0.9rem 1rem;
      border-radius: 8px;
      border: 1px solid rgba(183, 28, 28, 0.18);
      background: #fff1f1;
      color: #7f1d1d;
      font-size: 0.92rem;
      line-height: 1.5;
      font-weight: 600;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-bottom: 1.25rem;
      min-width: 0;
    }
    .form-group label {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-soft);
    }
    .form-group label .required {
      color: var(--red);
    }
    .form-group label .optional {
      font-weight: 500;
      color: var(--ink-muted);
      text-transform: none;
      letter-spacing: normal;
    }
    .form-group input[type="text"],
    .form-group input[type="tel"],
    .form-group input[type="email"],
    .form-group select,
    .form-group textarea {
      font-family: inherit;
      font-size: 1rem;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1rem;
      border: 2px solid var(--line-2);
      border-radius: 6px;
      background: #ffffff;
      color: var(--black);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      outline: none;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.1);
    }
    .form-group select {
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 24 24' width='24' height='24' xmlns='http://www.w3.org/2000/svg' fill='none' stroke='%234b5563' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
      background-repeat: no-repeat;
      background-position: right 0.85rem center;
      background-size: 1.1rem;
      padding-right: 2.5rem;
    }
    .form-group input[type="file"] {
      min-height: 44px;
      padding: 0.5rem 0;
      font-size: 0.9rem;
    }
    .file-help {
      font-size: 0.82rem;
      line-height: 1.4;
      color: var(--ink-muted);
    }
    .submit-btn {
      width: 100%;
      justify-content: center;
      padding: 1.1rem;
      font-size: 1.05rem;
      margin-top: 0.5rem;
    }

    .direct-call-alt {
      margin-top: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line-2);
      text-align: center;
    }
    .direct-call-alt p {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--ink-soft);
      margin-bottom: 0.85rem;
    }
    .direct-email-alt {
      margin: 1rem 0 0;
      font-size: 0.92rem;
      color: var(--ink-muted);
      font-weight: 500;
    }
    .direct-email-alt a {
      color: var(--black);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
    .direct-email-alt a:hover {
      color: var(--red);
      opacity: 1;
    }
    .call-btn {
      width: 100%;
      justify-content: center;
      padding: 1rem;
    }

    @media (max-width: 900px) {
      .contact-main {
        padding: 2rem 0 4rem;
      }
      .contact-layout {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
      }
      .contact-info {
        max-width: 100%;
      }
      .lede {
        margin-bottom: 1.5rem;
      }
      .form-card {
        padding: 1.5rem;
      }
    }

    @media (max-width: 600px) {
      .form-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }
