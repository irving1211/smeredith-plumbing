---
// Review-only: the full home page with hero option 3. Built only when PUBLIC_REVIEW_ROUTES=1 (see ./[...compare].astro).
import HomePage from '../../components/HomePage.astro';
import HeroMechanical from '../../components/heroes/HeroMechanical.astro';

export function getStaticPaths() {
  return import.meta.env.PUBLIC_REVIEW_ROUTES === '1' ? [{ params: { o3: 'hero-3' } }] : [];
}
---

<HomePage hero="3" review>
  <HeroMechanical slot="hero" />
</HomePage>
