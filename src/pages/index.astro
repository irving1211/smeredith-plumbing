    .topbar.scrolled .topbar-row { padding: .55rem 1.75rem; }

    /* Brand: icon mark (house + wrenches, no text) paired with a real wordmark.
       The full logo wordmark appears prominently in the hero where it can breathe. */
    .brand { display: flex; align-items: center; gap: .7rem; color: var(--black); }
    .brand-icon { width: 44px; height: 44px; transition: transform .3s cubic-bezier(0.22, 0.61, 0.36, 1); flex-shrink: 0; }
    .brand:hover .brand-icon { transform: rotate(-4deg) scale(1.06); }
    .brand-wordmark { display: flex; flex-direction: column; line-height: 1.05; }
