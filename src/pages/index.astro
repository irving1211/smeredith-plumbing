---
import Base from '../layouts/Base.astro';
import jobsRaw from '../jobs.json';
import services from '../services.json';
import areas from '../areas.json';

const base = import.meta.env.BASE_URL;
const jobs = jobsRaw.map((j) => ({
  ...j,
  images: j.images.map((src) => `${base}${src.replace(/^\//, '')}`),
}));

const phone = '781-820-4592';
const phoneTel = '+17818204592';
const publicEmail = 'shane@smeredithplumbing.com';
const publicEmailHref = `mailto:${publicEmail}`;
const facebookUrl = 'https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/';
const instagramUrl = 'https://www.instagram.com/s.meredith_plumbing_heating/';
const builderInstagramUrl = 'https://www.instagram.com/icbizsystems/';
const contactPage = `${base}contact/`;
const heroImageSrc = `${base}images/shane.webp`;
const heroImageSmallSrc = `${base}images/shane-640.webp`;
const heroImageSrcSet = `${heroImageSmallSrc} 640w, ${heroImageSrc} 960w`;
const heroImageSizes = '(max-width: 900px) 88vw, (max-width: 1240px) 42vw, 430px';
const aboutImageSizes = '(max-width: 900px) 86vw, 360px';
const vanImageSrc = `${base}images/van/van-side.webp`;
const vanImageSmallSrc = `${base}images/van/van-side-800.webp`;
const vanImageSrcSet = `${vanImageSmallSrc} 800w, ${vanImageSrc} 1100w`;
const vanImageSizes = '(max-width: 900px) 92vw, (max-width: 1240px) 48vw, 560px';
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent('Hi Shane — ')}`;
// Owner-confirmed Google Business Profile share link (2026-05-28).
const googleReviewsUrl = 'https://share.google/1tEzgdGC624rLynKF';

// Verbatim (lightly trimmed) from Shane's verified 5-star Google reviews. Source screenshots
// in _context/harvest/2026-05-28-owner-photo-drop/Reviews screenshot/.
const reviews = [
  { name: 'Steven B.', tag: 'Bathroom remodel', body: 'Shane did a great job with the plumbing for my bathroom remodel. On time, good communication, and minded every detail. Will definitely keep his name and number for the future.' },
  { name: 'Daniel M.', tag: 'Winter furnace emergency', body: 'Shane responded quickly to an urgent furnace repair in the middle of a winter deep freeze. Other plumbers said it could not be fixed — Shane said “I can fix it,” and he did.' },
  { name: 'Clare G.', tag: 'Last-minute issue', body: 'We had a last-minute plumbing issue in our bathroom and Shane came out the same day without hesitation. Incredibly fair, honest, and responsive from start to finish. 10/10 service.' },
  { name: 'Carly C.', tag: 'Water heater replacement', body: 'Shane came out quickly and replaced the water heater without any delays. He was so understanding of my situation with four kids at home and got our hot water back as soon as possible.' },
  { name: 'Luke B.', tag: 'Same-day emergency visit', body: 'Same-day visit, and he arrived exactly when he said he would. Quickly diagnosed and resolved the problem, explained it in plain terms, and his pricing was very reasonable.' },
  { name: 'Iva V.', tag: 'Holiday morning emergency', body: 'Great job on a holiday morning for a plumbing emergency. Fast, quality work that started even before the visit via video, so we didn’t waste time. Very accommodating.' },
  { name: 'Val K.', tag: 'Attention to detail', body: 'Very professional and pays close attention to detail. He added safety, functionality, and modernity to our plumbing at a very fair price, and explained red flags to watch for.' },
  { name: 'Laura C.', tag: 'Complex system repair', body: 'After more than a week and multiple professionals trying to fix a complex problem in our building, Shane did it. Professional, knowledgeable, and willing to take the time to get it right.' },
  { name: 'Amy C.', tag: 'Repeat customer', body: 'Excellent at his craft, smart, and a true problem solver. Honest, dependable, and operates with real integrity. I’ve used his services multiple times and referred him to others.' },
  { name: 'Emilio D.', tag: 'Property manager', body: 'As a facilities manager responsible for multiple properties, I can say S. Meredith Plumbing is one of the best. Always prompt and dependable, and their pricing is very fair.' },
];

const trustPillars = [
  { strong: 'Licensed', soft: 'MA-licensed plumber + gas fitter, fully insured.' },
  { strong: 'Owner-operated', soft: 'You call, Shane answers. No call center. No dispatcher.' },
  { strong: 'Free written quotes', soft: 'Upfront pricing in writing. Zero surprise charges.' },
  { strong: 'Parts on the truck', soft: 'Most jobs done same-visit. No “we’ll be back tomorrow.”' },
  { strong: '1-hour callback', soft: 'Miss the live call? Returned within the hour, every time.' },
];

const faqs = [
  { q: 'Do you offer free estimates?', a: 'Yes. Every job starts with a free, written estimate. No surprise pricing, no upsell scripts, and no third-party dispatcher.' },
  { q: 'Are you licensed and insured?', a: 'Yes. Fully licensed in Massachusetts and fully insured. MA license #9630040-PL-M is listed on every written estimate and invoice.' },
  { q: 'How fast do you respond?', a: 'Calls are answered live during business hours and returned within one hour after-hours. For true emergencies like no heat in January, a burst pipe, or no hot water, we come out nights and weekends too.' },
  { q: 'What areas do you serve?', a: 'Based in Saugus, MA. Working homes and jobsites across the Northshore and into Boston, including Lynn, Revere, Malden, Melrose, Wakefield, Peabody, Stoneham, Everett, Somerville, Boston, Lexington, Tewksbury, Haverhill, and beyond. Outside the list? Call. If we’re close, we’ll help.' },
  { q: 'Do you stand behind your work?', a: 'Yes. Shane is licensed and insured, and work is done to code and inspected where required. Manufacturer warranties apply to the equipment installed, and workmanship is gone over with you in writing for each job. No boilerplate.' },
  { q: 'Do you handle new construction and additions?', a: 'Yes. From rough-in to finish, Shane handles plumbing for new builds, additions, and gut renovations. Inspected, signed off, and ready to occupy.' },
  { q: 'Do you work weekends and holidays?', a: '24/7 for true emergencies. Same-day Saturday for boiler and water heater failures whenever possible. You call, Shane answers.' },
];

const whyShane = [
  { h: 'You get Shane. Not a call center.', b: 'Big national chains route you through a dispatcher who books a sub-contractor who shows up when they show up. Here, you call the same person who shows up every time.' },
  { h: 'Upfront written quotes. Never bait-and-switch.', b: 'Every job is priced in writing before work starts. No “we found another problem” surprise add-ons. If something changes, we stop and talk through it before continuing.' },
  { h: 'A decade of jobs in your town.', b: 'Saugus, Lynn, Revere, Malden, Peabody, Wakefield. We know the local housing stock, the common boiler models, the inspectors. That shows up in faster diagnosis and cleaner work.' },
  { h: 'Parts on the truck. Most jobs done same visit.', b: 'Common boiler parts, water heater fittings, gas connectors, and valves. We stock the truck for what the calls actually look like, not for what catalogs say to stock.' },
];
