    .brand-wordmark em { font-style: normal; font-family: 'Fraunces', Georgia, serif; font-weight: 500; font-size: .72rem; color: var(--ink-muted); letter-spacing: .04em; margin-top: 1px; }

    /* Hero lockup & navigation layout */
    .nav { display: flex; gap: 1.4rem; margin-left: auto; }
    .nav a { color: var(--ink-soft); font-weight: 600; font-size: .95rem; position: relative; padding: .25rem 0; transition: color .2s ease; text-transform: uppercase; letter-spacing: 0.05em; }
    .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -.35rem; height: 2px; background: var(--red); transform: scaleX(0); transform-origin: center; transition: transform .25s cubic-bezier(0.22, 0.61, 0.36, 1); border-radius: 2px; }
    .nav a:hover { color: var(--black); opacity: 1; }
    .nav a:hover::after { transform: scaleX(.55); }
    .nav a.active { color: var(--black); font-weight: 700; }
    .nav a.active::after { transform: scaleX(1); }

    .topbar-call { padding: .55rem 1rem; background: var(--black); color: #fff; border-radius: 4px; font-weight: 700; font-size: .92rem; letter-spacing: 0.02em; transition: background .18s ease, transform .18s ease; text-transform: uppercase; white-space: nowrap; }
    .topbar-call:hover { background: var(--red); color: #fff; opacity: 1; transform: scale(1.03); }
    .topbar-call-num { color: #fff; }
    .topbar-actions { display: flex; align-items: center; gap: .6rem; }
    .menu-toggle {
      display: none;
      align-items: center;
      gap: .45rem;
      padding: .55rem .8rem;
      border: 1px solid var(--line-2);
      border-radius: 4px;
      background: rgba(255,255,255,.7);
      color: var(--black);
      font: inherit;
      font-size: .8rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .18s ease, border-color .18s ease, transform .18s ease;
    }
    .menu-toggle:hover { background: #fff; border-color: var(--red); opacity: 1; }
    .menu-toggle:active { transform: scale(.98); }
    .menu-toggle-box { position: relative; width: 18px; height: 14px; display: flex; align-items: center; justify-content: center; }
    .menu-toggle-line {
      position: absolute;
      top: 50%;
      left: 0;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 999px;
      transform: translateY(-50%);
      transition: background .15s ease;
    }
    .menu-toggle-line::before,
    .menu-toggle-line::after {
      content: '';
      position: absolute;
      left: 0;
      width: 18px;
      height: 2px;
      background: currentColor;
      border-radius: 999px;
      transition: transform .25s cubic-bezier(0.16, 1, 0.3, 1), top .25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .menu-toggle-line::before { top: -6px; }
    .menu-toggle-line::after { top: 6px; }

    .topbar.menu-open .menu-toggle-line { background: transparent; }
    .topbar.menu-open .menu-toggle-line::before { top: 0; transform: rotate(45deg); }
    .topbar.menu-open .menu-toggle-line::after { top: 0; transform: rotate(-45deg); }
    .menu-toggle-text { line-height: 1; }
    .mobile-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper-2);
      border-top: 1px solid var(--line);
      border-bottom: 2px solid var(--black);
      box-shadow: 0 14px 36px rgba(17,17,17,.14);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      pointer-events: none;
      transition: opacity .18s ease, transform .22s cubic-bezier(0.16, 1, 0.3, 1), visibility .22s ease;
    }
    .topbar.menu-open .mobile-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }
    .mobile-menu-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
    }
