---
import Base from '../layouts/Base.astro';
import jobsRaw from '../jobs.json';

const base = import.meta.env.BASE_URL;
// Prefix every job image path with the GitHub Pages base ('/smeredith-plumbing/' in prod, '/' in dev).
// `base` always ends with '/', so strip the leading '/' from raw paths to avoid double-slashes.
const jobs = jobsRaw.map((j) => ({
  ...j,
  images: j.images.map((src) => `${base}${src.replace(/^\//, '')}`),
}));

const phone = '781-820-4592';
const phoneTel = '+17818204592';
const email = 'ShaneMeredith17@gmail.com';

const services = [
  {
    title: 'Plumbing Service & Repair',
    body: 'The everyday stuff that ruins a day — leaks, clogs, low pressure, running toilets, frozen pipes, garbage disposals. Fast, fixed, done right.',
  },
  {
    title: 'Water Heaters',
    body: 'Tank, tankless, gas, electric, power-vent. Same-day replacements when yours quits. We pull the old, set the new, haul it away.',
  },
  {
    title: 'High-Efficiency Boilers',
    body: 'Service, repair, full replacements. Multi-zone systems, indirect tanks, Combi units. Heat back on the same day — even Saturdays.',
  },
  {
    title: 'Kitchen & Bath Remodels',
    body: 'Rough plumbing for renovations and additions. Fixtures, valves, drain lines, vanities. Done to code, done once.',
  },
  {
    title: 'New Construction',
    body: 'Plumbing for new builds and additions — rough-in to finish. Done right from the studs out, inspected and ready to occupy.',
  },
  {
    title: 'Gas Installation',
    body: 'Licensed gas line installation, repairs, and appliance hookups. Code-compliant, pressure-tested, signed off.',
  },
  {
    title: '24/7 Emergency',
    body: 'Frozen pipe at midnight. No hot water Saturday morning. Boiler out in January. Call — we answer.',
  },
  {
    title: 'Service & Maintenance',
    body: 'Annual inspections, preventive maintenance, peace-of-mind once-overs. Catch the small things before they become emergencies.',
  },
];

const reviews = [
  {
    name: 'Christina C.',
    body: 'Reliable and quick to respond every single time. Shane has done extensive work for us and we won’t call anyone else.',
  },
  {
    name: 'Rob F.',
    body: 'Professional, responsive, and there when you need him — even after hours. Hard to find that anymore.',
  },
  {
    name: 'Clare G.',
    body: 'Fair, honest, and skilled. Friendly on top of it. Exactly what you want in a plumber.',
  },
  {
    name: 'Sarah S.',
    body: 'Quick, knowledgeable, and honest. Easy to work with from the first call to the finished job.',
  },
];

const trustPillars = [
  { strong: 'Licensed', soft: 'MA-licensed plumber + gas fitter, fully insured.' },
  { strong: 'Owner-operated', soft: 'You call, Shane answers. No call center. No dispatcher.' },
  { strong: 'Free written quotes', soft: 'Upfront pricing in writing. Zero surprise charges.' },
  { strong: 'Parts on the truck', soft: 'Most jobs done same-visit. No “we’ll be back tomorrow.”' },
  { strong: '1-hour callback', soft: 'Miss the live call? Returned within the hour, every time.' },
];

const faqs = [
  { q: 'Do you offer free estimates?', a: 'Yes — every job starts with a free, written estimate. No surprise pricing, no upsell scripts, no third-party dispatcher.' },
  { q: 'Are you licensed and insured?', a: 'Yes. Fully licensed in Massachusetts and fully insured. License number provided on every written estimate and invoice.' },
  { q: 'How fast do you respond?', a: 'Calls answered live during business hours, and returned within one hour after-hours. True emergencies (no heat in January, burst pipe, no hot water) — we come out, including nights and weekends.' },
  { q: 'What areas do you serve?', a: 'Based in Saugus, MA. Working homes and jobsites across the Northshore and into Boston — Lynn, Revere, Malden, Melrose, Wakefield, Peabody, Stoneham, Everett, Somerville, Boston, Lexington, Tewksbury, Georgetown, Haverhill, and beyond. Outside the list? Call — if we’re close, we’ll help.' },
  { q: 'What payment methods do you take?', a: 'Cash, check, all major credit cards, and Venmo. Payment is due on completion of the work.' },
  { q: 'Do you guarantee your work?', a: 'Yes. One-year guarantee on all labor. Manufacturer warranty covers parts and equipment (typically 5–12 years on boilers and water heaters — we’ll spell out the exact warranty before install).' },
  { q: 'Do you handle new construction and additions?', a: 'Yes — rough-in to finish. Plumbing for new builds, additions, and gut renovations. Inspected, signed off, ready to occupy.' },
  { q: 'Do you work weekends and holidays?', a: '24/7 for true emergencies. Same-day Saturday for boiler and water heater failures whenever possible. You call, Shane answers.' },
];

// jobs imported from src/jobs.json — each job has multiple photos grouped together
---

<Base>
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="S. Meredith Plumbing & Heating — back to top">
        <img src={`${base}images/logo.jpg`} alt="" width="44" height="44" />
        <span class="brand-text">S. Meredith</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#reviews">Reviews</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="topbar-call" href={`tel:${phoneTel}`}>
        <span class="topbar-call-num">{phone}</span>
      </a>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-inner">
      <span class="eyebrow">★★★★★ · 10+ years on the Northshore · Licensed &amp; Insured</span>
      <h1>The plumber <span class="display-serif">who answers</span> the phone.</h1>
      <p class="hero-lede">
        S. Meredith Plumbing &amp; Heating is owner-operated by Shane Meredith — every call, every job, every detail. Plumbing, heating, gas, and new construction across the Northshore and Boston. Same-day boilers. 24/7 emergencies. Free written quotes, every time.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" href="#services">See Services</a>
      </div>
      <ul class="hero-stats">
        <li><strong>24/7</strong><span>Emergency service</span></li>
        <li><strong>10+</strong><span>Years on the Northshore</span></li>
        <li><strong>1:1</strong><span>You call, Shane answers</span></li>
      </ul>
    </div>
  </section>

  <section class="trust-band" aria-label="What you get every time">
    <div class="container">
      <ul class="trust-grid">
        {trustPillars.map((p) => (
          <li>
            <strong>{p.strong}</strong>
            <span>{p.soft}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>Everything that <span class="display-serif">carries</span> water, gas, or heat.</h2>
        <p class="section-sub">From a leaky faucet to a full new build — one number, one craftsman, one standard.</p>
      </div>
      <div class="service-grid">
        {services.map((s, i) => (
          <article class="service-card">
            <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <div class="services-cta">
        <p>Don’t see what you need? Call — odds are we’ve fixed it before.</p>
        <a class="btn btn-dark" href={`tel:${phoneTel}`}>Call {phone}</a>
      </div>
    </div>
  </section>

  <section class="work" id="work">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Recent work</span>
        <h2>The <span class="display-serif">details</span>, every time.</h2>
        <p class="section-sub">A look at jobs across the Northshore and Boston — remodels, boilers, water heaters, full builds.</p>
      </div>
      <div class="work-grid">
        {jobs.map((job, ji) => (
          <figure class="work-card" data-carousel data-job-idx={ji}>
            <div class="carousel-track" data-track>
              {job.images.map((src, i) => (
                <img src={src} alt={`${job.title} — photo ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
              ))}
            </div>
            <button class="carousel-arrow prev" data-prev aria-label="Previous photo">‹</button>
            <button class="carousel-arrow next" data-next aria-label="Next photo">›</button>
            <div class="carousel-dots" data-dots>
              {job.images.map((_, i) => (
                <span class={i === 0 ? 'dot active' : 'dot'} data-dot data-idx={i}></span>
              ))}
            </div>
            <figcaption>
              <strong>{job.title}</strong>
              <span>{job.desc}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <script is:inline>
        document.querySelectorAll('[data-carousel]').forEach((card) => {
          const track = card.querySelector('[data-track]');
          const dots = card.querySelectorAll('[data-dot]');
          const prev = card.querySelector('[data-prev]');
          const next = card.querySelector('[data-next]');
          const total = dots.length;
          let idx = 0;
          let startX = 0;
          let currentX = 0;
          let isDragging = false;
          let dragMoved = false;
          let cardWidth = 0;
          const TRANSITION = 'transform .45s cubic-bezier(0.22, 0.61, 0.36, 1)';

          const update = () => {
            track.style.transition = TRANSITION;
            track.style.transform = `translateX(-${idx * 100}%)`;
            dots.forEach((d, i) => d.classList.toggle('active', i === idx));
          };

          const onDown = (clientX) => {
            isDragging = true;
            dragMoved = false;
            startX = clientX;
            currentX = clientX;
            cardWidth = card.getBoundingClientRect().width;
            track.style.transition = 'none';
          };
          const onMove = (clientX) => {
            if (!isDragging) return;
            currentX = clientX;
            const delta = currentX - startX;
            if (Math.abs(delta) > 5) dragMoved = true;
            const pct = (delta / cardWidth) * 100;
            track.style.transform = `translateX(calc(-${idx * 100}% + ${pct}%))`;
          };
          const onUp = () => {
            if (!isDragging) return;
            isDragging = false;
            const delta = currentX - startX;
            const threshold = cardWidth * 0.18;
            if (delta < -threshold && idx < total - 1) idx++;
            else if (delta > threshold && idx > 0) idx--;
            else if (delta < -threshold && idx === total - 1) idx = 0;
            else if (delta > threshold && idx === 0) idx = total - 1;
            update();
          };

          card.addEventListener('touchstart', (e) => onDown(e.touches[0].clientX), { passive: true });
          card.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
          card.addEventListener('touchend', onUp);

          card.addEventListener('mousedown', (e) => { e.preventDefault(); onDown(e.clientX); });
          window.addEventListener('mousemove', (e) => { if (isDragging) onMove(e.clientX); });
          window.addEventListener('mouseup', onUp);
          card.addEventListener('mouseleave', () => { if (isDragging) onUp(); });

          prev?.addEventListener('click', (e) => { e.stopPropagation(); idx = (idx - 1 + total) % total; update(); });
          next?.addEventListener('click', (e) => { e.stopPropagation(); idx = (idx + 1) % total; update(); });
          dots.forEach((d) => d.addEventListener('click', (e) => { e.stopPropagation(); idx = parseInt(d.dataset.idx, 10); update(); }));

          card.addEventListener('click', (e) => {
            if (dragMoved) { e.preventDefault(); return; }
            if (e.target.closest('button') || e.target.closest('[data-dot]')) return;
            idx = (idx + 1) % total;
            update();
          });
        });
      </script>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={`${base}images/shane.jpg`} alt="Shane Meredith, owner of S. Meredith Plumbing & Heating" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">About Shane</span>
        <h2>One craftsman. One <span class="display-serif">standard</span>. A decade of it.</h2>
        <p>
          Shane Meredith runs S. Meredith Plumbing &amp; Heating personally. Over ten years of water heaters in basements, boilers in January, gas hookups, full remodels, and the kind of everyday emergencies that don’t care what time it is.
        </p>
        <p>
          No call centers. No bait-and-switch quotes. No subcontractor roulette. You call, Shane shows up — fully licensed, fully insured, parts on the truck, ready to work. The job gets done right the first time, the workspace gets cleaned up, and the work gets stood behind.
        </p>
        <p class="about-pull">
          <span class="display-serif">The promise:</span> if you can’t get me on the first ring, I’ll call you back. If it’s an emergency, I’ll come out — even if it’s 2 AM.
        </p>
      </div>
    </div>
  </section>

  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-head">
        <span class="kicker">From neighbors</span>
        <h2>What people in <span class="display-serif">Saugus</span> say.</h2>
      </div>
      <div class="review-grid">
        {reviews.map((r) => (
          <article class="review-card">
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>— {r.name}</cite>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Questions</span>
        <h2>What to <span class="display-serif">know</span> before you call.</h2>
        <p class="section-sub">If you don’t see it answered here, dial — Shane will pick up.</p>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="area" id="area">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Service area</span>
        <h2>All of <span class="display-serif">Northshore</span> MA &amp; Boston.</h2>
        <p class="section-sub">Based in Saugus. Working homes and job sites across:</p>
      </div>
      <ul class="towns">
        <li>Saugus</li><li>Lynn</li><li>Revere</li><li>Malden</li><li>Melrose</li><li>Wakefield</li><li>Peabody</li><li>Stoneham</li><li>Everett</li><li>Somerville</li><li>Boston</li><li>Lexington</li><li>Tewksbury</li><li>Georgetown</li><li>Haverhill</li>
      </ul>
      <p class="towns-note">Outside this list? Call anyway — if we’re close, we’ll help.</p>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="container contact-inner">
      <span class="kicker dark">Get in touch</span>
      <h2>The fastest way is a <span class="display-serif">phone call</span>.</h2>
      <p>
        Pipes don’t wait. No forms. No third-party dispatcher. No upsell scripts. Just Shane.
      </p>
      <div class="contact-cta">
        <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost-dark big" href={`mailto:${email}`}>Email Shane</a>
      </div>
      <ul class="contact-list">
        <li><span class="lbl">Phone</span><a href={`tel:${phoneTel}`}>{phone}</a></li>
        <li><span class="lbl">Email</span><a href={`mailto:${email}`}>{email}</a></li>
        <li><span class="lbl">Hours</span><span>24/7 — call anytime</span></li>
        <li><span class="lbl">Area</span><span>Northshore MA &amp; Boston</span></li>
      </ul>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src={`${base}images/logo.jpg`} alt="" width="40" height="40" />
        <div>
          <strong>S. Meredith Plumbing &amp; Heating</strong>
          <span>Saugus, MA · Licensed &amp; Insured · Owner-operated</span>
        </div>
      </div>
      <div class="footer-links">
        <a href={`tel:${phoneTel}`}>{phone}</a>
        <span class="dot">·</span>
        <a href={`mailto:${email}`}>{email}</a>
        <span class="dot">·</span>
        <a href="https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/" rel="noopener" target="_blank">Facebook</a>
        <span class="dot">·</span>
        <a href="https://www.instagram.com/s.meredith_plumbing_heating/" rel="noopener" target="_blank">Instagram</a>
      </div>
      <div class="footer-fineprint">© {new Date().getFullYear()} S. Meredith Plumbing &amp; Heating · Built for the Northshore</div>
    </div>
  </footer>

  <a class="sticky-call" href={`tel:${phoneTel}`} aria-label={`Call ${phone}`}>Call {phone}</a>

  <script is:inline>
    // Sticky topbar scroll-state
    (() => {
      const topbar = document.querySelector('.topbar');
      if (!topbar) return;
      const onScroll = () => {
        if (window.scrollY > 30) topbar.classList.add('scrolled');
        else topbar.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    // Intersection-Observer scroll-reveal
    (() => {
      if (!('IntersectionObserver' in window)) return;
      const targets = document.querySelectorAll('section, .work-card, .service-card, .review-card, .faq-item, .trust-grid li');
      targets.forEach((el) => el.classList.add('reveal'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      targets.forEach((el) => io.observe(el));
    })();

    // FAQ accordion — close siblings on open
    (() => {
      const items = document.querySelectorAll('.faq-item');
      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) items.forEach((other) => { if (other !== item) other.open = false; });
        });
      });
    })();
  </script>

  <style>
    .topbar { background: rgba(250,247,242,.78); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid transparent; position: sticky; top: 0; z-index: 50; transition: background .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .topbar.scrolled { background: rgba(250,247,242,.94); border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(0,0,0,.02), 0 6px 20px rgba(42,31,20,.05); }
    .topbar-row { display: flex; align-items: center; gap: 1.5rem; padding: .8rem 1.75rem; transition: padding .25s ease; }
    .topbar.scrolled .topbar-row { padding: .55rem 1.75rem; }
    .brand { display: flex; align-items: center; gap: .65rem; color: var(--black); }
    .brand img { width: 36px; height: 36px; border-radius: 6px; object-fit: contain; background: #fff; }
    .brand-text { font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; }
    .nav { display: flex; gap: 1.4rem; margin-left: auto; }
    .nav a { color: var(--ink-soft); font-weight: 500; font-size: .95rem; }
    .nav a:hover { color: var(--black); opacity: 1; }
    .topbar-call { padding: .55rem 1rem; background: var(--black); color: #fff; border-radius: 999px; font-weight: 600; font-size: .92rem; letter-spacing: -0.01em; transition: background .18s ease, transform .18s ease; }
    .topbar-call:hover { background: var(--red); color: #fff; opacity: 1; transform: scale(1.03); }
    .topbar-call-num { color: #fff; }

    .hero { padding: 8rem 0 7rem; background: var(--paper); position: relative; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at top, rgba(244,228,201,.45), transparent 60%); pointer-events: none; }
    .hero-inner { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; text-align: center; position: relative; z-index: 1; }
    .eyebrow { display: inline-block; font-size: .82rem; font-weight: 600; color: var(--ink-muted); letter-spacing: .02em; margin-bottom: 1.6rem; padding: .5rem 1rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); }
    .hero h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); margin: 0 auto 1.4rem; max-width: 14ch; }
    .hero h1 .display-serif { color: var(--red); }
    .hero-lede { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--ink-soft); max-width: 660px; margin: 0 auto 2.4rem; line-height: 1.6; font-weight: 400; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; margin-bottom: 4rem; }
    .hero-stats { list-style: none; padding: 0; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; max-width: 720px; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); padding: 2.4rem 0; }
    .hero-stats li { display: flex; flex-direction: column; align-items: center; gap: .35rem; }
    .hero-stats strong { font-size: 2.8rem; font-weight: 800; letter-spacing: -0.04em; color: var(--black); line-height: 1; }
    .hero-stats span { font-size: .88rem; color: var(--ink-muted); letter-spacing: -0.005em; }

    /* Trust band — sits between hero and services. 5 quick credentials. */
    .trust-band { padding: 3rem 0; background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .trust-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 2rem; max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
    .trust-grid li { display: flex; flex-direction: column; gap: .4rem; padding-left: 1rem; border-left: 2px solid var(--red); }
    .trust-grid strong { font-size: 1rem; font-weight: 700; color: var(--black); letter-spacing: -0.01em; }
    .trust-grid span { font-size: .88rem; color: var(--ink-soft); line-height: 1.45; }

    .section-head { text-align: center; max-width: 760px; margin: 0 auto 4rem; }
    .kicker { font-size: .72rem; font-weight: 600; color: var(--red); letter-spacing: .12em; text-transform: uppercase; display: inline-block; margin-bottom: 1.2rem; }
    .kicker.dark { color: #f4b08e; }
    .section-head h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; max-width: 20ch; margin-left: auto; margin-right: auto; }
    .section-head h2 .display-serif { color: var(--red); font-weight: 700; }
    .section-sub { color: var(--ink-soft); font-size: 1.08rem; margin: 0 auto; max-width: 560px; }

    .services { padding: 7rem 0; background: var(--paper); }
    .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
    .service-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 2rem 1.7rem; transition: transform .25s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow .25s ease, border-color .25s ease; position: relative; box-shadow: 0 1px 2px rgba(42,31,20,.03); }
