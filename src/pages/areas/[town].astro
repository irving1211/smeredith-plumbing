---
import { jsonLd } from '../../lib/jsonld.js';
import Base from '../../layouts/Base.astro';
import areas from '../../areas.json';
import services from '../../services.json';
import jobsRaw from '../../jobs.json';
import { monthLabel } from '../../lib/job-dates.js';
import townHeating from '../../town-heating.json';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { town: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent(`Hi Shane — calling from ${area.town}. `)}`;
const otherTowns = areas.filter((a) => a.slug !== area.slug);
const contactHref = `${base}contact/?town=${area.slug}`;
// Real jobs in this town (src/jobs.json, "town" = this slug). A town page only exists when there is something real to show.
const townJobs = jobsRaw
  .filter((j) => (j as { town?: string }).town === area.slug)
  .map((j) => ({ ...j, photos: j.photos.map((p) => ({ ...p, src: `${base}${p.src.replace(/^\//, '')}` })) }));
const recent = (area as { recent?: Array<{ when: string; text: string }> }).recent || [];
// Pages without photos from this town can show Shane's related work from other towns, always labelled with the real
// town (or none when the post did not name one), never presented as work in this town.
const townName = (slug?: string) => areas.find((a) => a.slug === slug)?.town;
const relatedJobs = ((area as { related_jobs?: string[] }).related_jobs || [])
  .map((slug) => jobsRaw.find((j) => j.slug === slug))
  .filter((j): j is (typeof jobsRaw)[number] => Boolean(j))
  .map((j) => ({ ...j, where: townName((j as { town?: string }).town), photo: { ...j.photos[0], src: `${base}${j.photos[0].src.replace(/^\//, '')}` } }));
// How the town heats: Census shares and the gas company (src/town-heating.json, every number sourced there).
type Heat = { homes: number; gas: number; oil: number; oilHomes: number; electric: number; pre1940: number; pre1960: number; twoToFour: number; utility: string; note?: string };
const heat = (townHeating.towns as Record<string, Heat>)[area.slug];
const n = (x: number) => x.toLocaleString('en-US');

// Breadcrumb schema only references real pages; the visible "Service area" link is a homepage section.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: `Plumber in ${area.town}`, item: `${origin}${base}areas/${area.slug}/` },
  ],
};
---

<Base title={area.seo_title} description={area.meta_desc} pageType="town" current="service-area" pageMeta={{ town: area.slug }}>
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href={base}>Home</a> <span aria-hidden="true">›</span> <a href={`${base}#area`}>Service area</a> <span aria-hidden="true">›</span> <span class="current" aria-current="page">{area.town}</span>
    </div>
  </nav>

  <main id="main">
  <section class="page-hero">
    <div class="container">
      <h1>{area.h1}</h1>
      <p class="tagline">{area.tagline}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" href={smsHref}>Text Shane from {area.town}</a>
      </div>
      <p class="hero-alt"><a href={contactHref}>Or request service online →</a></p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <p class="intro">{area.intro}</p>

      <h2>What we see in {area.town}</h2>
      <div class="scenario-list">
        {area.local_hooks.map((s) => (
          <div class="scenario">
            <h3>{s.h}</h3>
            <p>{s.b}</p>
          </div>
        ))}
      </div>

      {townJobs.length > 0 && (
        <section class="town-jobs" id="town-jobs" aria-labelledby="town-jobs-h">
          <h2 id="town-jobs-h">Recent work in {area.town}</h2>
          {townJobs.map((job) => (
            <figure class="town-job">
              <div class="town-photos">
                {job.photos.map((photo, i) => (
                  <img src={photo.src} srcset={`${photo.src.replace(/-900\.webp$/, '-480.webp')} 480w, ${photo.src} ${photo.width}w`} sizes="(min-width: 800px) 190px, 45vw" alt={(photo as { alt?: string }).alt || `${job.title}, photo ${i + 1}`} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                ))}
              </div>
              <figcaption>
                <strong>{job.title}</strong>
                <span class="when">Photos from {monthLabel((job as { date?: string }).date)}</span>
                <span>{job.desc}</span>
              </figcaption>
            </figure>
          ))}
          <p class="more-link"><a href={`${base}work/`}>All recent jobs →</a></p>
        </section>
      )}

      {relatedJobs.length > 0 && (
        <section class="town-jobs" id="related-jobs" aria-labelledby="related-jobs-h">
          <h2 id="related-jobs-h">{(area as { related_jobs_title?: string }).related_jobs_title || 'Related work by Shane'}</h2>
          <div class="job-row">
            {relatedJobs.map((job) => (
              <figure class="job-thumb">
                <img src={job.photo.src} srcset={`${job.photo.src.replace(/-900\.webp$/, '-480.webp')} 480w, ${job.photo.src} ${job.photo.width}w`} sizes="(min-width: 800px) 240px, 45vw" alt={(job.photo as { alt?: string }).alt || job.title} width={job.photo.width} height={job.photo.height} loading="lazy" decoding="async" />
                <figcaption>{job.title}{job.where ? ` (${job.where})` : ''}</figcaption>
              </figure>
            ))}
          </div>
          <p class="more-link"><a href={`${base}work/`}>All recent jobs →</a></p>
        </section>
      )}

      {recent.length > 0 && (
        <ul class="recent-notes">
          {recent.map((r) => <li><span class="when">{monthLabel(r.when)}</span> {r.text}</li>)}
        </ul>
      )}

      {heat && (
        <section class="town-heat-block" id="town-heating" aria-labelledby="town-heating-h">
          <h2 id="town-heating-h">How {area.town} heats</h2>
          <p>Of about {n(heat.homes)} occupied homes in {area.town}, {heat.oil}% heat with oil (about {n(heat.oilHomes)} homes), {heat.gas}% with gas and {heat.electric}% with electricity. {heat.pre1940}% were built before 1940 and {heat.pre1960}% before 1960{heat.twoToFour >= 15 ? `; ${heat.twoToFour}% are in buildings with two to four units` : ''}.</p>
          <p>Gas company: {heat.utility}.{heat.note ? ` ${heat.note}` : ''}</p>
          <ul class="heat-links">
            <li><a href={`${base}services/oil-to-gas-conversion/`}>Still on oil? The oil to gas conversion guide</a></li>
            <li><a href={`${base}services/no-heat-emergency/`}>No heat right now: what to check, 24/7 calls</a></li>
            <li><a href={`${base}services/boiler-replacement/`}>Boiler replacement</a></li>
            {heat.pre1940 >= 40 && <li><a href={`${base}services/steam-boiler-heating/`}>Steam heat: {heat.pre1940}% of homes here predate 1940, when steam was standard</a></li>}
            <li><a href={`${base}heating/`}>All heating help</a></li>
          </ul>
          <p class="source-line">Sources: <a href={townHeating.source.census.href} rel="noopener">{townHeating.source.census.label}</a>; <a href={townHeating.source.gas.href} rel="noopener">{townHeating.source.gas.label}</a>{area.slug === 'lexington' && <>; <a href={townHeating.notesSource.href} rel="noopener">{townHeating.notesSource.label}</a></>}.</p>
        </section>
      )}

      <h2>Job types seen in {area.town}</h2>
      <ul class="common-calls">
        {area.common_calls.map((c) => <li>{c}</li>)}
      </ul>

      <section class="town-services" id="town-services" aria-labelledby="town-services-h">
        <h2 id="town-services-h">Services in {area.town}</h2>
        <ul class="link-pills">
          {services.map((s) => <li><a href={`${base}services/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
        <p class="more-link"><a href={`${base}work/`}>See recent jobs →</a></p>
      </section>

      <div class="page-cta" id="town-cta">
        <h2>{area.town} homeowners — one number.</h2>
        <p>Owner answers. 24/7 emergency service. Master plumber, MA license #9630040-PL-M.</p>
        <div class="hero-cta">
          <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost big" href={smsHref}>Text photos for a quote</a>
          <a class="btn btn-ghost big" href={contactHref}>Request service</a>
        </div>
      </div>

      <section class="nearby" id="nearby-towns" aria-labelledby="nearby-h">
        <h2 id="nearby-h">Nearby towns</h2>
        <ul class="link-pills">
          {otherTowns.map((a) => <li><a href={`${base}areas/${a.slug}/`}>Plumber in {a.town}</a></li>)}
        </ul>
      </section>

      <p class="back-link"><a href={`${base}services/`}>← All services</a></p>
    </div>
  </section>

  </main>
  <style>
    .breadcrumb { padding: 1rem 0; background: var(--paper-2); border-bottom: 1px solid var(--line); font-size: .88rem; color: var(--ink-muted); }
    .breadcrumb a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .breadcrumb a:hover { color: var(--red); opacity: 1; }
    .breadcrumb span { margin: 0 .35rem; color: var(--ink-muted); }
    .breadcrumb .current { color: var(--ink); font-weight: 500; }

    .page-hero { padding: 5rem 0 3rem; background: var(--paper); }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; max-width: 22ch; }
    .page-hero .tagline { font-size: 1.15rem; color: var(--ink-soft); margin-bottom: 2rem; max-width: 60ch; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; }

    .page-body { padding: 3rem 0 7rem; background: var(--paper); }
    .page-body .container { max-width: 800px; }
    .intro { font-size: 1.15rem; line-height: 1.7; color: var(--ink); margin-bottom: 3rem; padding: 1.6rem 1.8rem; background: var(--paper-2); border-left: 3px solid var(--red); border-radius: 8px; }
    .page-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2.5rem 0 1.5rem; letter-spacing: -0.02em; }
    .scenario-list { display: flex; flex-direction: column; gap: 1.4rem; margin-bottom: 3rem; }
    .scenario { background: var(--color-surface); border: 1px solid var(--line); border-radius: var(--radius-md); padding: 1.5rem 1.7rem; transition: border-color .25s ease; }
    .scenario:hover { border-color: var(--line-2); }
    .scenario h3 { font-size: 1.1rem; margin-bottom: .55rem; letter-spacing: -0.015em; }
    .scenario p { color: var(--ink-soft); margin: 0; line-height: 1.6; }

    .common-calls { list-style: none; padding: 0; margin: 0 0 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .65rem; }
    .common-calls li { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: .85rem 1.1rem; color: var(--ink); font-weight: 500; font-size: .95rem; }

    .page-cta { background: var(--paper-2); border-radius: var(--radius-md); padding: 3rem 2rem; text-align: center; margin: 4rem 0 2rem; }
    .page-cta h2 { margin-bottom: 1rem; }
    .page-cta p { color: var(--ink-soft); margin-bottom: 2rem; }
    .page-cta .hero-cta { justify-content: center; }
    .btn.big { font-size: 1.05rem; padding: 1.15rem 2.1rem; }

    .hero-alt { margin: 1rem 0 0; font-weight: 600; }
    .hero-alt a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .link-pills { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
    .link-pills a { display: inline-block; background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--radius-md); padding: .55rem 1rem; font-weight: 600; font-size: .92rem; color: var(--ink); }
    .link-pills a:hover { border-color: var(--red); color: var(--red); opacity: 1; }
    .where p, .related-services p { color: var(--ink-soft); line-height: 1.65; }
    .town-job { margin: 0 0 2rem; }
    .town-photos { display: flex; flex-wrap: wrap; gap: .5rem; align-items: flex-start; }
    .town-photos img { width: auto; max-width: 100%; height: 13rem; border-radius: var(--radius-sm); background: var(--paper-2); }
    .town-job figcaption { display: grid; gap: .2rem; padding-top: .6rem; }
    .town-job figcaption span { color: var(--ink-soft); line-height: 1.55; }
    .town-job .when, .recent-notes .when { color: var(--ink-muted); font-size: .88rem; }
    .recent-notes { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .5rem; }
    .recent-notes li { color: var(--ink-soft); }
    .job-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: start; }
    .job-thumb { margin: 0; background: var(--color-surface); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
    .job-thumb img { width: 100%; height: auto; }
    .job-thumb figcaption { padding: .7rem .9rem; font-weight: 600; font-size: .92rem; }
    .more-link { margin-top: 1rem; }
    .more-link a { color: var(--black); font-weight: 700; text-decoration: underline; text-underline-offset: .18em; }

    .town-heat-block { margin: 0 0 3rem; padding: 1.5rem 1.7rem; background: var(--color-surface); border: 1px solid var(--line); border-top: 3px solid var(--color-action); border-radius: var(--radius-md); }
    .town-heat-block h2 { margin-top: 0; }
    .town-heat-block p { color: var(--ink-soft); line-height: 1.65; }
    .heat-links { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: .35rem; }
    .heat-links a, .source-line a { color: var(--black); font-weight: 600; text-decoration: underline; text-underline-offset: .18em; }
    .heat-links a { display: inline-flex; align-items: center; min-height: 44px; }
    .source-line { font-size: .88rem; color: var(--ink-muted) !important; margin: 0; }
    .back-link { text-align: center; color: var(--ink-muted); margin-top: 2rem; }
    .back-link a { color: var(--ink-soft); font-weight: 500; }
    .back-link a:hover { color: var(--red); opacity: 1; }

    @media (max-width: 900px) {
      .page-hero { padding: 3rem 0 2rem; }
      .hero-cta { flex-direction: column; gap: .65rem; }
      .hero-cta .btn { justify-content: center; width: 100%; }
      .page-cta { padding: 2.5rem 1.5rem; }
    }
  </style>
</Base>
