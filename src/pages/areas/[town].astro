---
import Base from '../../layouts/Base.astro';
import SubpageHeader from '../../components/SubpageHeader.astro';
import areas from '../../areas.json';
import services from '../../services.json';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { town: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const base = import.meta.env.BASE_URL;
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const smsHref = `sms:${phoneTel}?body=${encodeURIComponent(`Hi Shane — calling from ${area.town}. `)}`;
const otherTowns = areas.filter((a) => a.slug !== area.slug);

// Breadcrumb schema only references real pages; the visible "Service area" link is a homepage section.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: `Plumber in ${area.town}`, item: `${origin}${base}areas/${area.slug}/` },
  ],
};
---

<Base title={area.seo_title} description={area.meta_desc} pageType="town" pageMeta={{ town: area.slug }}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />

  <SubpageHeader />

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href={base}>Home</a> <span aria-hidden="true">›</span> <a href={`${base}#area`}>Service area</a> <span aria-hidden="true">›</span> <span class="current" aria-current="page">{area.town}</span>
    </div>
  </nav>

  <main>
  <section class="page-hero">
    <div class="container">
      <h1>{area.h1}</h1>
      <p class="tagline">{area.tagline}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-ghost" href={smsHref}>Text Shane from {area.town}</a>
      </div>
      <p class="hero-alt"><a href={`${base}contact/`}>Or request service online →</a></p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <p class="intro">{area.intro}</p>

      <h2>What we see in {area.town}</h2>
      <div class="scenario-list">
        {area.local_hooks.map((s) => (
          <div class="scenario">
            <h3>{s.h}</h3>
            <p>{s.b}</p>
          </div>
        ))}
      </div>

      <h2>Common calls from {area.town}</h2>
      <ul class="common-calls">
        {area.common_calls.map((c) => <li>{c}</li>)}
      </ul>

      <section class="town-services" id="town-services" aria-labelledby="town-services-h">
        <h2 id="town-services-h">Services in {area.town}</h2>
        <ul class="link-pills">
          {services.map((s) => <li><a href={`${base}services/${s.slug}/`}>{s.title}</a></li>)}
        </ul>
        <p class="more-link"><a href={`${base}#work`}>See recent jobs →</a></p>
      </section>

      <div class="page-cta" id="town-cta">
        <h2>{area.town} homeowners — one number.</h2>
        <p>Owner answers. Free written quote on every job. Same-day where possible. Licensed &amp; insured — MA license #9630040-PL-M.</p>
        <div class="hero-cta">
          <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost big" href={smsHref}>Text photos for a quote</a>
          <a class="btn btn-ghost big" href={`${base}contact/`}>Request service</a>
        </div>
      </div>

      <section class="nearby" id="nearby-towns" aria-labelledby="nearby-h">
        <h2 id="nearby-h">Nearby towns</h2>
        <ul class="link-pills">
          {otherTowns.map((a) => <li><a href={`${base}areas/${a.slug}/`}>Plumber in {a.town}</a></li>)}
        </ul>
      </section>

      <p class="back-link"><a href={`${base}services/`}>← All services</a></p>
    </div>
  </section>

  </main>

  <a class="sticky-call" href={`tel:${phoneTel}`} aria-label={`Call ${phone}`}>Call {phone}</a>

  <style>
    .breadcrumb { padding: 1rem 0; background: var(--paper-2); border-bottom: 1px solid var(--line); font-size: .88rem; color: var(--ink-muted); }
    .breadcrumb a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .breadcrumb a:hover { color: var(--red); opacity: 1; }
    .breadcrumb span { margin: 0 .35rem; color: var(--ink-muted); }
    .breadcrumb .current { color: var(--ink); font-weight: 500; }

    .page-hero { padding: 5rem 0 3rem; background: var(--paper); }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; max-width: 22ch; }
    .page-hero .tagline { font-size: 1.15rem; color: var(--ink-soft); margin-bottom: 2rem; max-width: 60ch; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; }

    .page-body { padding: 3rem 0 7rem; background: var(--paper); }
    .page-body .container { max-width: 800px; }
    .intro { font-size: 1.15rem; line-height: 1.7; color: var(--ink); margin-bottom: 3rem; padding: 1.6rem 1.8rem; background: var(--paper-2); border-left: 3px solid var(--red); border-radius: 8px; }
    .page-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2.5rem 0 1.5rem; letter-spacing: -0.02em; }
    .scenario-list { display: flex; flex-direction: column; gap: 1.4rem; margin-bottom: 3rem; }
    .scenario { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem 1.7rem; transition: border-color .25s ease, transform .2s ease; }
    .scenario:hover { border-color: var(--line-2); transform: translateX(2px); }
    .scenario h3 { font-size: 1.1rem; margin-bottom: .55rem; letter-spacing: -0.015em; }
    .scenario p { color: var(--ink-soft); margin: 0; line-height: 1.6; }

    .common-calls { list-style: none; padding: 0; margin: 0 0 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .65rem; }
    .common-calls li { background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: .85rem 1.1rem; color: var(--ink); font-weight: 500; font-size: .95rem; }

    .page-cta { background: var(--paper-2); border-radius: 16px; padding: 3rem 2rem; text-align: center; margin: 4rem 0 2rem; }
    .page-cta h2 { margin-bottom: 1rem; }
    .page-cta p { color: var(--ink-soft); margin-bottom: 2rem; }
    .page-cta .hero-cta { justify-content: center; }
    .btn.big { font-size: 1.05rem; padding: 1.15rem 2.1rem; }

    .hero-alt { margin: 1rem 0 0; font-weight: 600; }
    .hero-alt a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: .18em; }
    .link-pills { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
    .link-pills a { display: inline-block; background: var(--paper-2); border: 1px solid var(--line); border-radius: 999px; padding: .55rem 1rem; font-weight: 600; font-size: .92rem; color: var(--ink); }
    .link-pills a:hover { border-color: var(--red); color: var(--red); opacity: 1; }
    .where p, .related-services p { color: var(--ink-soft); line-height: 1.65; }
    .job-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
    .job-thumb { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .job-thumb img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
    .job-thumb figcaption { padding: .7rem .9rem; font-weight: 600; font-size: .92rem; }
    .more-link { margin-top: 1rem; }
    .more-link a { color: var(--black); font-weight: 700; text-decoration: underline; text-underline-offset: .18em; }

    .back-link { text-align: center; color: var(--ink-muted); margin-top: 2rem; }
    .back-link a { color: var(--ink-soft); font-weight: 500; }
    .back-link a:hover { color: var(--red); opacity: 1; }

    .sticky-call { display: none; position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); background: var(--red); color: #fff; padding: 1rem 1.8rem; border-radius: 999px; font-weight: 600; box-shadow: 0 12px 30px rgba(194,73,44,.4); z-index: 100; min-width: 240px; text-align: center; }
    .sticky-call:hover { background: var(--red-dark); color: #fff; opacity: 1; }

    @media (max-width: 900px) {
      .page-hero { padding: 3rem 0 2rem; }
      .hero-cta { flex-direction: column; gap: .65rem; }
      .hero-cta .btn { justify-content: center; width: 100%; }
      .sticky-call { display: block; }
      body { padding-bottom: 5rem; }
      .page-cta { padding: 2.5rem 1.5rem; }
    }
  </style>
</Base>
