---
import { jsonLd } from '../lib/jsonld.js';
import Base from '../layouts/Base.astro';
import jobsRaw from '../jobs.json';
import services from '../services.json';
import serviceOptions from '../service-options.json';
import { townBySlug } from '../lib/service-area.js';
import { monthLabel } from '../lib/job-dates.js';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const origin = (Astro.site?.toString() || 'https://smeredithplumbing.com').replace(/\/$/, '');
const request = (service: string) => `${base}contact/?service=${service}`;

// Jobs grouped by the service they show, in the order Shane's work is listed on the home page.
const groupOrder = ['water-heater-replacement', 'boiler-service', 'kitchen-bath-remodels', 'general-plumbing'];
const headings: Record<string, string> = { 'water-heater-replacement': 'Water heaters', 'boiler-service': 'Boilers', 'kitchen-bath-remodels': 'Kitchen and bath remodels', 'general-plumbing': 'General plumbing, repairs and pumps' };
const where = (job: { town?: string; date?: string }) => [job.town ? townBySlug(job.town)?.name : '', monthLabel(job.date)].filter(Boolean).join(' · ');
const groups = groupOrder
  .map((id) => ({
    id,
    option: serviceOptions.find((o) => o.id === id)!,
    service: services.find((s) => s.slug === id),
    jobs: jobsRaw.filter((j) => j.service === id).map((j) => ({ ...j, photos: j.photos.map((p) => ({ ...p, src: `${base}${p.src.replace(/^\//, '')}` })) })),
  }))
  .filter((g) => g.jobs.length);

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}${base}` },
    { '@type': 'ListItem', position: 2, name: 'Our work', item: `${origin}${base}work/` },
  ],
};
---

<Base
  title="Recent Plumbing & Heating Jobs | S. Meredith, Saugus MA"
  description="Photos of recent water heater, boiler, remodel and repair plumbing jobs by Shane Meredith in Saugus, Lynn, Somerville, Stoneham and across the North Shore."
  pageType="work"
  current="work"
>
  <script type="application/ld+json" set:html={jsonLd(breadcrumb)} slot="head" />
  <main id="main">
    <div class="container page-head">
      <p class="breadcrumb"><a href={base}>Home</a> / Our work</p>
      <h1>Recent jobs</h1>
      <p class="lede">Photos from jobs Shane has finished. Tap a photo to see it larger.</p>
    </div>

    {groups.map((g) => (
      <section class="section" aria-labelledby={`${g.id}-h`}>
        <div class="container">
          <h2 class="section-title" id={`${g.id}-h`}>{headings[g.id] ?? g.option.short}</h2>
          <div class="jobs">
            {g.jobs.map((job) => (
              <figure class="job-card">
                <div class="job-media" role="group" aria-label={`${job.title}: ${job.photos.length} ${job.photos.length === 1 ? 'photo' : 'photos'}`}>
                  {[
                    job.photos.length === 2 ? [] : [0],
                    job.photos.length === 2 ? [0, 1] : job.photos.map((_, i) => i).slice(1),
                  ].map((idx, rowNo) => idx.length > 0 && (
                    <div class={rowNo === 0 ? 'ph-lead' : 'ph-row'}>
                      {idx.map((i) => {
                        const photo = job.photos[i];
                        return (
                          <a class="ph" style={`--ar:${(photo.width / photo.height).toFixed(4)}`} href={photo.src} data-lightbox>
                            <img src={photo.src} srcset={`${photo.src.replace(/-900\.webp$/, '-480.webp')} 480w, ${photo.src} ${photo.width}w`} sizes={rowNo === 0 ? '(min-width: 900px) 440px, 92vw' : '(min-width: 900px) 220px, 45vw'} alt={(photo as { alt?: string }).alt || `${job.title}, photo ${i + 1} of ${job.photos.length}`} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                          </a>
                        );
                      })}
                    </div>
                  ))}
                </div>
                <figcaption>
                  <strong>{job.title}</strong>
                  {where(job) && <span class="where-when">{where(job)}</span>}
                  <span>{job.desc}</span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class="actions group-actions">
            <a class="btn btn-primary" href={request(g.id)}>Request {g.option.short.toLowerCase()} service</a>
            {g.service && <a class="btn btn-secondary" href={`${base}services/${g.id}/`}>What it covers</a>}
          </div>
        </div>
      </section>
    ))}

    <section class="band on-dark" aria-labelledby="work-contact-h">
      <div class="container">
        <h2 id="work-contact-h">Have a job like these?</h2>
        <p>Call Shane, or send the details and a photo with the request form.</p>
        <div class="actions">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost-dark" href={`${base}contact/`}>Request service</a>
        </div>
      </div>
    </section>
  </main>
  <dialog id="lightbox" class="lightbox" aria-label="Job photo">
    <div class="lb-frame">
      <button type="button" class="lb-close" aria-label="Close photo">×</button>
      <button type="button" class="lb-nav lb-prev" aria-label="Previous photo">‹</button>
      <div class="lb-stage"></div>
      <button type="button" class="lb-nav lb-next" aria-label="Next photo">›</button>
      <p class="lb-cap" aria-live="polite"></p>
    </div>
  </dialog>
</Base>

<script>
  // Progressive enhancement: without JavaScript each photo is a plain link to the larger image.
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    // The enlarged photo is created here, so the page itself carries no empty image.
    const img = document.createElement('img');
    img.className = 'lb-img';
    (dlg.querySelector('.lb-stage') as HTMLElement).append(img);
    const cap = dlg.querySelector('.lb-cap') as HTMLElement;
    const prev = dlg.querySelector('.lb-prev') as HTMLButtonElement;
    const next = dlg.querySelector('.lb-next') as HTMLButtonElement;
    let items: HTMLAnchorElement[] = [];
    let at = 0;
    let opener: HTMLElement | null = null;
    const show = (n: number) => {
      at = (n + items.length) % items.length;
      const a = items[at];
      const thumb = a.querySelector('img') as HTMLImageElement;
      img.src = a.href;
      img.alt = thumb.alt;
      cap.textContent = items.length > 1 ? `${thumb.alt} (${at + 1} of ${items.length})` : thumb.alt;
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[data-lightbox]') as HTMLAnchorElement | null;
      if (!a) return;
      e.preventDefault();
      opener = a;
      items = [...(a.closest('.job-media') as HTMLElement).querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
      prev.hidden = next.hidden = items.length < 2;
      show(items.indexOf(a));
      dlg.showModal();
    });
    prev.addEventListener('click', () => show(at - 1));
    next.addEventListener('click', () => show(at + 1));
    (dlg.querySelector('.lb-close') as HTMLButtonElement).addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && items.length > 1) show(at - 1);
      if (e.key === 'ArrowRight' && items.length > 1) show(at + 1);
    });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); opener?.focus(); });
  }
</script>

<style>
  .jobs { display: grid; gap: 1.75rem; margin: 0 0 1.5rem; }
  @media (min-width: 900px) { .jobs { grid-template-columns: 1fr 1fr; gap: 2.25rem 2.5rem; } }
  .job-card { margin: 0; min-width: 0; }
  /* Every photo of a job is visible at once and shown whole (nothing is cropped or zoomed): one lead, then a row that shares one height. No sideways scrolling. */
  .job-media { display: grid; gap: .4rem; }
  .ph-lead, .ph-row { display: flex; gap: .4rem; align-items: flex-start; }
  .ph { display: block; overflow: hidden; border-radius: var(--radius-sm); background: var(--paper-2); flex: var(--ar, 1) 1 0; min-width: 0; }
  .ph img { display: block; width: 100%; height: auto; aspect-ratio: var(--ar); }
  .ph-lead { display: block; }
  .ph-lead .ph { display: block; width: fit-content; max-width: 100%; }
  .ph-lead .ph img { width: auto; max-width: 100%; height: auto; max-height: 28rem; }
  .ph:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100%; height: 100%; }
  .lightbox::backdrop { background: rgba(10, 10, 10, .88); }
  .lb-frame { position: relative; display: grid; grid-template-rows: 1fr auto; justify-items: center; width: 100%; height: 100%; padding: 3rem 3.25rem 1rem; box-sizing: border-box; }
  .lb-stage { display: flex; justify-content: center; align-items: center; min-height: 0; max-width: 100%; height: 100%; }
  .lb-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--radius-sm); }
  .lb-cap { margin: .75rem 0 0; color: #f3f1ec; font-size: .95rem; text-align: center; max-width: 40rem; }
  .lb-close, .lb-nav { position: absolute; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .16); color: #fff; font-size: 1.9rem; line-height: 1; cursor: pointer; }
  .lb-close { top: .75rem; right: .75rem; }
  .lb-nav { top: 50%; transform: translateY(-50%); }
  .lb-nav[hidden] { display: none; }
  .lb-prev { left: .5rem; }
  .lb-next { right: .5rem; }
  .lb-close:hover, .lb-nav:hover { background: rgba(255, 255, 255, .3); }
  .lb-close:focus-visible, .lb-nav:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  @media (max-width: 600px) { .lb-frame { padding: 3rem .5rem 1rem; } .lb-nav { top: auto; bottom: 4.5rem; transform: none; } }
  .job-card figcaption { display: grid; gap: .15rem; padding-top: .6rem; }
  .job-card figcaption span { color: var(--color-text-muted); font-size: .95rem; max-width: 36rem; }
  .group-actions { margin-top: .5rem; }
  .job-card figcaption .where-when { color: var(--color-text-muted); font-size: .85rem; }
</style>
