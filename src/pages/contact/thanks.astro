---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const phone = '781-820-4592';
const phoneTel = '+17818204592';
const publicEmail = 'shane@smeredithplumbing.com';
const publicEmailHref = `mailto:${publicEmail}`;
---

<Base title="Request Received | S. Meredith Plumbing & Heating" description="Thank you for your service request. Shane will be in touch with you shortly." noindex pageType="lead-confirmation">
  <main id="main" class="thanks-main">
    <div class="container thanks">
      <h1>We've got it.</h1>
      <p class="thanks-message">Your request has been sent to Shane. He will review the details and call you back. For anything urgent, call or text him.</p>
      <div class="actions">
        <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        <a class="btn btn-secondary" href={base}>Back to home</a>
      </div>
      <p class="thanks-more">Need to send more details or photos? Text <a href={`sms:${phoneTel}`}>{phone}</a> or email <a href={publicEmailHref}>{publicEmail}</a>.</p>
    </div>
  </main>

  <script is:inline>
    // A lead is counted ONLY when the server confirmed delivery: it redirects here with a one-time
    // random lead id. Visits without that id (direct, refresh, bookmark, bots) count nothing.
    // The id is stripped from the address bar at once and remembered on this device (random ids only), so a
    // reload, back/forward, duplicated or re-opened tab can't count the same lead twice. Only enumerated values are sent
    // to analytics: no name, phone, email, address, message text, or the lead id itself.
    document.addEventListener('DOMContentLoaded', () => {
      try {
        const q = new URLSearchParams(location.search);
        const lead = q.get('lead');
        if (!lead) return;
        history.replaceState(null, '', location.pathname);
        if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(lead)) return;
        const counted = JSON.parse(localStorage.getItem('sm_leads_counted') || '[]');
        if (counted.includes(lead)) return;
        counted.push(lead);
        localStorage.setItem('sm_leads_counted', JSON.stringify(counted.slice(-20)));
        const id = (v) => (/^[a-z0-9_-]{1,60}$/.test(v || '') ? v : '');
        if (window.smTrack) {
          window.smTrack('generate_lead', {
            form_id: 'service_request',
            service_type: id(q.get('svc')),
            lead_source: id(q.get('src')),
            heard_about: id(q.get('ha')),
          });
        }
      } catch (_) {}
    });
  </script>

  <style>
    .thanks-main { padding: 2.5rem 0 1rem; }
    .thanks { max-width: 40rem; }
    .thanks h1 { margin-bottom: .75rem; }
    .thanks-message { margin: 0 0 1.5rem; font-size: 1.1rem; color: var(--color-text-muted); }
    .thanks-more { margin: 1.5rem 0 0; color: var(--color-text-muted); }
    .thanks-more a { font-weight: 700; text-decoration: underline; text-underline-offset: .18em; }
  </style>
</Base>
