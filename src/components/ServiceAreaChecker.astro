---
// Town-level coverage checker + outline map.
//  - Coverage comes ONLY from src/service-area.json (owner-confirmed towns). An unlisted town is
//    told to contact Shane, never turned away.
//  - Without JavaScript the form is a plain GET to /contact/ with the town and service carried over.
//  - The outlines are real municipal boundaries (src/service-area-geo.json, built by
//    scripts/build-service-area-geo.mjs) and are drawn as town coverage, not a service radius.
//  - An interactive Google Map loads only on request, and only if PUBLIC_GOOGLE_MAPS_KEY was set when
//    the site was built. Shane's home address is never used or shown.
import { TOWNS, HOME_TOWN, CONFIRMED_ON } from '../lib/service-area.js';
import areas from '../areas.json';
import geo from '../service-area-geo.json';

interface Props {
  /** A service id from service-options.json, carried into the request form. */
  service?: string;
  /** Show the outline map and town links (full variant). */
  showMap?: boolean;
  /** Unique id prefix when the component appears twice on a page. */
  uid?: string;
}
const { service = '', showMap = true, uid = 'area' } = Astro.props;
const base = import.meta.env.BASE_URL;
const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '';
const pageSlugs = new Set(areas.map((a) => a.slug));
const [vx, vy, vw, vh] = geo.viewBox;
const townNames = TOWNS.map((t) => t.name).join(', ');
---

<div class="area-checker" data-area-checker data-base={base} data-service={service} data-maps-key={mapsKey}>
  <form class="area-form" action={`${base}contact/`} method="get" data-area-form>
    <div class="area-field">
      <label for={`${uid}-town`}>Check your town</label>
      <select id={`${uid}-town`} name="town" data-area-select>
        <option value="">Choose your town…</option>
        {TOWNS.map((t) => <option value={t.slug}>{t.name}</option>)}
      </select>
    </div>
    <div class="area-field">
      <label for={`${uid}-other`}>Not on the list? Type your town</label>
      <input id={`${uid}-other`} name="town_other" type="text" maxlength="60" autocomplete="address-level2" data-area-other />
    </div>
    {service && <input type="hidden" name="service" value={service} />}
    <button type="submit" class="btn btn-primary">Check my town</button>
  </form>

  <div class="area-result" data-area-result role="status" aria-live="polite" hidden>
    <p class="area-message" data-area-message></p>
    <p class="area-note" data-area-note hidden></p>
    <div class="area-actions">
      <a class="btn btn-primary" data-area-cta href={`${base}contact/`}>Request service</a>
      <a class="btn btn-ghost" data-area-call href="tel:+17818204592">Call 781-820-4592</a>
    </div>
  </div>

  {showMap && (
    <figure class="area-map">
      <svg class="area-svg" viewBox={`${vx} ${vy} ${vw} ${vh}`} role="img" aria-labelledby={`${uid}-map-title ${uid}-map-desc`} focusable="false">
        <title id={`${uid}-map-title`}>Map of the towns Shane serves</title>
        <desc id={`${uid}-map-desc`}>Town outlines for {townNames}. Coloured towns are on Shane's confirmed list. Uncoloured neighbouring towns are not on the list yet, so contact Shane to confirm availability. Use the town selector above for the same information as text.</desc>
        <path class="ctx" d={geo.context} />
        {TOWNS.map((t) => <path class="town" data-town={t.slug} data-cx={geo.towns[t.slug].cx} data-cy={geo.towns[t.slug].cy} d={geo.towns[t.slug].d} />)}
        <text class="lbl" data-label x={geo.towns[HOME_TOWN].cx} y={geo.towns[HOME_TOWN].cy} text-anchor="middle">Saugus</text>
      </svg>
      <figcaption>
        <span class="key key-served" aria-hidden="true"></span> Towns on Shane's confirmed list
        <span class="key key-other" aria-hidden="true"></span> Nearby, not on the list: contact Shane to confirm.
        <span class="credit">Town outlines: U.S. Census Bureau legal boundaries (they include some harbor water). Coverage is by town; large towns may need a call to confirm your street.</span>
      </figcaption>
      {mapsKey && (
        <div class="gmap-wrap">
          <button type="button" class="btn btn-secondary" data-gmap-open>Show interactive map</button>
          <p class="gmap-status" data-gmap-status role="status" aria-live="polite"></p>
          <div class="gmap" data-gmap hidden></div>
        </div>
      )}
    </figure>
  )}

  {showMap && (
    <ul class="area-towns">
      {TOWNS.map((t) => (
        <li class={pageSlugs.has(t.slug) ? '' : 'town-plain'}>
          {pageSlugs.has(t.slug) ? <a href={`${base}areas/${t.slug}/`}>{t.name}</a> : t.name}
        </li>
      ))}
    </ul>
  )}
  {showMap && <p class="area-confirmed">Service area confirmed by Shane {CONFIRMED_ON}. Outside this list? Call anyway: if it's close, he'll tell you.</p>}
</div>

<script>
  import { checkTown } from '../lib/service-area.js';

  type Track = (event: string, params?: Record<string, string>) => void;
  const track: Track = (event, params) => (window as unknown as { smTrack?: Track }).smTrack?.(event, params);

  document.querySelectorAll<HTMLElement>('[data-area-checker]').forEach((root) => {
    const base = root.dataset.base || '/';
    const service = root.dataset.service || '';
    const select = root.querySelector<HTMLSelectElement>('[data-area-select]')!;
    const other = root.querySelector<HTMLInputElement>('[data-area-other]')!;
    const form = root.querySelector<HTMLFormElement>('[data-area-form]')!;
    const box = root.querySelector<HTMLElement>('[data-area-result]')!;
    const message = root.querySelector<HTMLElement>('[data-area-message]')!;
    const note = root.querySelector<HTMLElement>('[data-area-note]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-area-cta]')!;
    const paths = Array.from(root.querySelectorAll<SVGPathElement>('path.town'));
    const label = root.querySelector<SVGTextElement>('[data-label]');
    let selectedSlug = '';
    let refreshMap: (() => void) | null = null;

    const highlight = (slug: string) => {
      selectedSlug = slug;
      paths.forEach((p) => p.classList.toggle('is-selected', p.dataset.town === slug));
      if (label) {
        const target = paths.find((p) => p.dataset.town === slug);
        if (target) {
          label.textContent = select.selectedOptions[0]?.textContent || '';
          label.setAttribute('x', target.dataset.cx || '0');
          label.setAttribute('y', target.dataset.cy || '0');
          label.classList.add('is-selected');
        } else {
          label.classList.remove('is-selected');
        }
      }
      refreshMap?.();
    };

    const run = (value: string) => {
      const result = checkTown(value, service, { base });
      box.hidden = false;
      message.textContent = result.message;
      note.textContent = result.note || '';
      note.hidden = !result.note;
      cta.href = result.cta.href;
      cta.textContent = result.cta.label;
      cta.dataset.typedTown = result.cta.typed || '';
      highlight(result.status === 'confirmed' && result.town ? result.town.slug : '');
      // Only the enumerated town slug (or "other") is reported; typed text never leaves the page.
      track('service_area_check', { town: result.town ? result.town.slug : 'other', result: result.status, service_type: service });
    };

    cta.addEventListener('click', () => {
      try {
        if (cta.dataset.typedTown) sessionStorage.setItem('sm_town_other', cta.dataset.typedTown);
        else sessionStorage.removeItem('sm_town_other');
      } catch (_) { /* storage unavailable: the visitor can type the town on the next page */ }
    });

    select.addEventListener('change', () => {
      if (select.value) {
        other.value = '';
        run(select.value);
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = select.value || other.value.trim();
      if (!value) {
        select.focus();
        return;
      }
      run(value);
    });
    paths.forEach((p) => {
      p.addEventListener('click', () => {
        select.value = p.dataset.town || '';
        other.value = '';
        run(select.value);
      });
    });

    // ---- Interactive Google Map: on request only, never required ----
    const openBtn = root.querySelector<HTMLButtonElement>('[data-gmap-open]');
    const mapEl = root.querySelector<HTMLElement>('[data-gmap]');
    const status = root.querySelector<HTMLElement>('[data-gmap-status]');
    const key = root.dataset.mapsKey || '';
    if (openBtn && mapEl && status && key) {
      const fail = () => {
        mapEl.hidden = true;
        openBtn.disabled = false;
        status.textContent = "The interactive map couldn't load. The town checker above works without it.";
        track('service_area_map_error');
      };
      const loadGoogle = () =>
        new Promise<void>((resolve, reject) => {
          const w = window as unknown as Record<string, unknown> & { google?: { maps?: unknown } };
          if (w.google && w.google.maps) return resolve();
          const timer = window.setTimeout(() => reject(new Error('timeout')), 10000);
          w.__smMapsReady = () => { window.clearTimeout(timer); resolve(); };
          w.gm_authFailure = () => { window.clearTimeout(timer); reject(new Error('auth')); fail(); };
          const s = document.createElement('script');
          s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&callback=__smMapsReady&loading=async&v=weekly`;
          s.async = true;
          s.onerror = () => { window.clearTimeout(timer); reject(new Error('load')); };
          document.head.appendChild(s);
        });

      openBtn.addEventListener('click', async () => {
        openBtn.disabled = true;
        status.textContent = 'Loading map…';
        track('service_area_map_open');
        try {
          await loadGoogle();
          const g = (window as unknown as { google: any }).google;
          const { Map } = await g.maps.importLibrary('maps');
          const response = await fetch(`${base}data/service-area.geojson`);
          if (!response.ok) throw new Error('geojson');
          const geojson = await response.json();
          mapEl.hidden = false;
          const map = new Map(mapEl, { center: { lat: 42.47, lng: -71.03 }, zoom: 10, gestureHandling: 'cooperative', mapTypeControl: false, streetViewControl: false, clickableIcons: false });
          map.data.addGeoJson(geojson);
          const style = (feature: any) => ({
            fillColor: '#D32B2C',
            fillOpacity: feature.getProperty('slug') === selectedSlug ? 0.5 : 0.16,
            strokeColor: '#B11F20',
            strokeWeight: 1.2,
          });
          map.data.setStyle(style);
          map.data.addListener('click', (e: any) => {
            select.value = e.feature.getProperty('slug');
            other.value = '';
            run(select.value);
          });
          refreshMap = () => map.data.setStyle(style);
          status.textContent = 'Click a coloured town to check it.';
        } catch {
          fail();
        }
      });
    }

    root.setAttribute('data-ready', 'true');
  });
</script>

<style>
  .area-checker { display: grid; gap: 1.5rem; }
  .area-form { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: end; max-width: 44rem; }
  @media (min-width: 700px) { .area-form { grid-template-columns: 1fr 1fr auto; max-width: none; } }
  .area-field { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
  .area-field label { font-weight: 700; }
  .area-field select, .area-field input { font: inherit; font-size: 1rem; width: 100%; min-height: 50px; padding: .65rem .85rem; border: 2px solid var(--color-control); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); }
  .area-field select:focus, .area-field input:focus { border-color: var(--color-text); }
  .area-result { max-width: 44rem; background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-action); border-radius: var(--radius-sm); padding: 1rem 1.1rem; }
  .area-message { margin: 0 0 .35rem; font-weight: 700; font-size: 1.08rem; }
  .area-note { margin: 0 0 .6rem; color: var(--color-text-muted); font-size: .95rem; }
  .area-actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: .8rem; }
  .area-actions .btn { flex: 1 1 11rem; }
  .area-form .btn { min-height: 50px; }
  .area-map { margin: 0; display: grid; gap: .8rem; justify-items: center; }
  .area-svg { width: 100%; max-width: 440px; height: auto; max-height: 600px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .area-svg .ctx { fill: var(--color-border); stroke: var(--color-surface); stroke-width: .8; }
  .area-svg .town { fill: var(--color-tint); stroke: var(--color-action-hover); stroke-width: 1.2; stroke-linejoin: round; cursor: pointer; }
  .area-svg .town:hover { fill: #EDC3BF; }
  .area-svg .town.is-selected { fill: var(--color-action); }
  .area-svg .lbl { font: 700 17px 'Inter Variable', 'Inter', system-ui, sans-serif; fill: var(--color-text); paint-order: stroke; stroke: var(--color-surface); stroke-width: 4px; pointer-events: none; }
  .area-svg .lbl.is-selected { font-size: 20px; }
  .area-map figcaption { font-size: .9rem; color: var(--color-text-muted); line-height: 1.6; max-width: 56ch; text-align: center; }
  .area-map .key { display: inline-block; width: .9rem; height: .9rem; border-radius: 3px; vertical-align: -2px; margin: 0 .3rem 0 .6rem; border: 1px solid var(--color-action-hover); }
  .area-map .key-served { background: var(--color-tint); }
  .area-map .key-other { background: var(--color-border); border-color: var(--color-control); }
  .area-map .credit { display: block; margin-top: .35rem; font-size: .82rem; }
  .gmap-wrap { width: 100%; max-width: 640px; display: grid; gap: .6rem; justify-items: center; }
  .gmap { width: 100%; height: 420px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
  .gmap-status { margin: 0; min-height: 1.2em; font-size: .9rem; color: var(--color-text-muted); }
  .area-towns { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; }
  .area-towns li { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-weight: 600; font-size: .95rem; }
  .area-towns li a, .area-towns li.town-plain { display: flex; align-items: center; min-height: 44px; padding: 0 1rem; }
  .area-towns li a { text-decoration: underline; text-underline-offset: .2em; }
  .area-towns li.town-plain { color: var(--color-text-muted); }
  .area-confirmed { margin: 0; text-align: center; color: var(--color-text-muted); font-size: .9rem; }
</style>
