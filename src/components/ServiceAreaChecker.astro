---
// Coverage checker: ZIP first, with an approximate pin and the next action.
//  - Coverage comes ONLY from src/service-area.json (owner-confirmed towns). A valid ZIP is not automatically covered,
//    and an unconfirmed town is never refused: the answer is "Call Shane to confirm". Logic: src/lib/zip-coverage.js.
//  - ZIP geography (Census ZCTA -> town overlaps, public domain) is fetched from /data/zip-coverage.json only when a
//    ZIP is checked; the map image is lazy and inside a hidden box, so it loads only when there is a pin to show.
//  - The pin is the ZIP's approximate centre, labelled as such; no geolocation, no street-level position.
//  - The typed ZIP never reaches a link, analytics or storage. Analytics gets only an enumerated result state.
//  - Without JavaScript: a town picker (plain GET to /contact/ with the town and service) and the phone number.
//  - The town links stay in the HTML (an expandable list) so search engines can always reach the town pages.
import { TOWNS, HOME_TOWN, CONFIRMED_ON } from '../lib/service-area.js';
import areas from '../areas.json';
import geo from '../service-area-geo.json';

interface Props {
  /** A service id from service-options.json, carried into the request form. */
  service?: string;
  /** Show the large clickable outline map (Service area page). */
  showMap?: boolean;
  /** Unique id prefix when the component appears twice on a page. */
  uid?: string;
}
const { service = '', showMap = true, uid = 'area' } = Astro.props;
const base = import.meta.env.BASE_URL;
const mapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '';
const pageSlugs = new Set(areas.map((a) => a.slug));
const [vx, vy, vw, vh] = geo.viewBox;
const townNames = TOWNS.map((t) => t.name).join(', ');
const proj = JSON.stringify({ proj: geo.proj, viewBox: geo.viewBox });
---

<div class="area-checker" data-area-checker data-base={base} data-service={service} data-maps-key={mapsKey} data-proj={proj}>
  <form class="zip-form js-only" data-zip-form novalidate>
    <label for={`${uid}-zip`}>Your ZIP code</label>
    <div class="zip-row">
      <input id={`${uid}-zip`} name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" spellcheck="false" aria-describedby={`${uid}-zip-hint`} data-zip-input />
      <button type="submit" class="btn btn-primary">Check</button>
    </div>
    <p class="hint" id={`${uid}-zip-hint`}>Only used to check the area on this page. It isn't saved or sent anywhere.</p>
  </form>

  <noscript>
    <form class="area-form nojs-town" action={`${base}contact/`} method="get">
      <div class="area-field">
        <label for={`${uid}-town-nojs`}>Pick your town</label>
        <select id={`${uid}-town-nojs`} name="town">
          <option value="">Choose your town…</option>
          {TOWNS.map((t) => <option value={t.slug}>{t.name}</option>)}
        </select>
      </div>
      {service && <input type="hidden" name="service" value={service} />}
      <button type="submit" class="btn btn-primary">Request service</button>
    </form>
    <p class="nojs-call">Town not listed? <a href="tel:+17818204592">Call 781-820-4592</a> and Shane will tell you.</p>
  </noscript>

  <p class="visually-hidden" role="status" aria-live="polite" data-area-live></p>
  <div class="area-result" data-area-result hidden>
    <p class="area-message" data-area-message></p>
    <p class="area-note" data-area-note hidden></p>
    <div class="pinmap" data-pinmap hidden>
      <div class="pinmap-frame">
        <img data-pinmap-img src={`${base}data/area-map.svg`} alt="" width={vw} height={vh} loading="lazy" decoding="async" />
        <span class="pin" data-pin aria-hidden="true"><span class="pin-ring"></span><span class="pin-dot"></span></span>
      </div>
      <p class="pinmap-cap" data-pin-caption></p>
    </div>
    <div class="area-actions">
      <a class="btn btn-primary" data-area-cta href={`${base}contact/`}>Request service</a>
      <a class="btn btn-ghost" data-area-call href="tel:+17818204592">Call 781-820-4592</a>
      <button type="button" class="btn btn-secondary" data-zip-retry hidden>Try again</button>
    </div>
  </div>

  <details class="area-manual js-only">
    <summary>No ZIP handy? Pick your town</summary>
    <form class="area-form" action={`${base}contact/`} method="get" data-area-form>
      <div class="area-field">
        <label for={`${uid}-town`}>Your town</label>
        <select id={`${uid}-town`} name="town" data-area-select>
          <option value="">Choose your town…</option>
          {TOWNS.map((t) => <option value={t.slug}>{t.name}</option>)}
        </select>
      </div>
      <div class="area-field">
        <label for={`${uid}-other`}>Not on the list? Type your town</label>
        <input id={`${uid}-other`} name="town_other" type="text" maxlength="60" autocomplete="address-level2" data-area-other />
      </div>
      {service && <input type="hidden" name="service" value={service} />}
      <button type="submit" class="btn btn-secondary">Check my town</button>
    </form>
  </details>

  {showMap && (
    <figure class="area-map">
      <svg class="area-svg" viewBox={`${vx} ${vy} ${vw} ${vh}`} role="img" aria-labelledby={`${uid}-map-title ${uid}-map-desc`} focusable="false">
        <title id={`${uid}-map-title`}>Map of the towns Shane serves</title>
        <desc id={`${uid}-map-desc`}>Town outlines for {townNames}. Coloured towns are on Shane's confirmed list. Uncoloured neighbouring towns are not on the list yet, so contact Shane to confirm availability. Use the ZIP or town checker above for the same information as text.</desc>
        <path class="ctx" d={geo.context} />
        {TOWNS.map((t) => <path class="town" data-town={t.slug} data-cx={geo.towns[t.slug].cx} data-cy={geo.towns[t.slug].cy} d={geo.towns[t.slug].d} />)}
        <text class="lbl" data-label x={geo.towns[HOME_TOWN].cx} y={geo.towns[HOME_TOWN].cy} text-anchor="middle">Saugus</text>
      </svg>
      <figcaption>
        <span class="key key-served" aria-hidden="true"></span> Towns on Shane's confirmed list
        <span class="key key-other" aria-hidden="true"></span> Nearby, not on the list: contact Shane to confirm.
        <span class="credit">Town outlines: U.S. Census Bureau legal boundaries (they include some harbor water). Coverage is by town; large towns may need a call to confirm your street.</span>
      </figcaption>
      {mapsKey && (
        <div class="gmap-wrap">
          <button type="button" class="btn btn-secondary" data-gmap-open>Show interactive map</button>
          <p class="gmap-status" data-gmap-status role="status" aria-live="polite"></p>
          <div class="gmap" data-gmap hidden></div>
        </div>
      )}
    </figure>
  )}

  <details class="area-townlist" open={showMap ? true : undefined}>
    <summary>Towns Shane serves ({TOWNS.length})</summary>
    <ul class="area-towns">
      {TOWNS.map((t) => (
        <li class={pageSlugs.has(t.slug) ? '' : 'town-plain'}>
          {pageSlugs.has(t.slug) ? <a href={`${base}areas/${t.slug}/`}>{t.name}</a> : t.name}
        </li>
      ))}
    </ul>
    <p class="area-confirmed">Confirmed by Shane {CONFIRMED_ON}. Towns with a page are linked. Somewhere else nearby? Call: if it's close, he'll tell you.</p>
  </details>
</div>

<script>
  import { checkTown } from '../lib/service-area.js';
  // The ZIP logic (and the coverage lists it reads) loads only when someone uses the ZIP box, not with the page.
  const zipLib = () => import('../lib/zip-coverage.js');

  type Track = (event: string, params?: Record<string, string>) => void;
  const track: Track = (event, params) => (window as unknown as { smTrack?: Track }).smTrack?.(event, params);

  // One shared fetch for every checker on the page. A failed load is forgotten so "Try again" really retries.
  let zipData: Promise<unknown> | null = null;
  const loadZipData = (url: string) => {
    if (!zipData) {
      zipData = (async () => {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 8000);
        try {
          const res = await fetch(url, { signal: controller.signal });
          if (!res.ok) throw new Error(String(res.status));
          return await res.json();
        } finally {
          window.clearTimeout(timer);
        }
      })().catch((error) => {
        zipData = null;
        throw error;
      });
    }
    return zipData;
  };

  document.querySelectorAll<HTMLElement>('[data-area-checker]').forEach((root) => {
    const base = root.dataset.base || '/';
    const service = root.dataset.service || '';
    const projection = JSON.parse(root.dataset.proj || '{}');
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const zipForm = $<HTMLFormElement>('[data-zip-form]');
    const zipInput = $<HTMLInputElement>('[data-zip-input]');
    const select = $<HTMLSelectElement>('[data-area-select]');
    const other = $<HTMLInputElement>('[data-area-other]');
    const form = $<HTMLFormElement>('[data-area-form]');
    const box = $<HTMLElement>('[data-area-result]');
    const live = $<HTMLElement>('[data-area-live]');
    const message = $<HTMLElement>('[data-area-message]');
    const note = $<HTMLElement>('[data-area-note]');
    const cta = $<HTMLAnchorElement>('[data-area-cta]');
    const second = $<HTMLAnchorElement>('[data-area-call]');
    const retry = $<HTMLButtonElement>('[data-zip-retry]');
    const pinmap = $<HTMLElement>('[data-pinmap]');
    const pinImg = $<HTMLImageElement>('[data-pinmap-img]');
    const pin = $<HTMLElement>('[data-pin]');
    const pinCaption = $<HTMLElement>('[data-pin-caption]');
    const paths = Array.from(root.querySelectorAll<SVGPathElement>('path.town'));
    const label = root.querySelector<SVGTextElement>('[data-label]');
    let selectedSlug = '';
    let refreshMap: (() => void) | null = null;
    let pinAt: { x: number; y: number } | null = null;

    const highlight = (slug: string, name = '') => {
      selectedSlug = slug;
      paths.forEach((p) => p.classList.toggle('is-selected', p.dataset.town === slug));
      if (label) {
        const target = paths.find((p) => p.dataset.town === slug);
        if (target) {
          label.textContent = name;
          label.setAttribute('x', target.dataset.cx || '0');
          label.setAttribute('y', target.dataset.cy || '0');
          label.classList.add('is-selected');
        } else {
          label.classList.remove('is-selected');
        }
      }
      refreshMap?.();
    };

    type Action = { kind: string; href: string; label: string; townName?: string } | null;
    const setButton = (el: HTMLAnchorElement, action: Action, primary: boolean) => {
      el.hidden = !action;
      if (!action) return;
      el.href = action.href;
      el.textContent = action.label;
      el.className = `btn ${primary ? 'btn-primary' : 'btn-ghost'}`;
      el.dataset.typedTown = action.townName || '';
    };

    const show = (text: string, noteText: string, primary: Action, secondary: Action) => {
      box.hidden = false;
      message.textContent = text;
      note.textContent = noteText;
      note.hidden = !noteText;
      setButton(cta, primary, true);
      setButton(second, secondary, false);
      // Repeat the same words in the polite live region (it exists from page load, so screen readers announce it).
      live.textContent = '';
      window.setTimeout(() => { live.textContent = noteText ? `${text} ${noteText}` : text; }, 50);
    };

    // Frame the map so the pin sits in view, zoomed in around the ZIP's approximate centre.
    const placePin = () => {
      if (!pinAt || pinmap.hidden) return;
      const frame = pinImg.parentElement as HTMLElement;
      const fw = frame.clientWidth, fh = frame.clientHeight;
      const [, , vw, vh] = projection.viewBox;
      const width = Math.max(fw * 1.8, 320);
      const height = width * (vh / vw);
      const px = (pinAt.x / vw) * width, py = (pinAt.y / vh) * height;
      const left = Math.min(0, Math.max(fw - width, fw / 2 - px));
      const top = Math.min(0, Math.max(fh - height, fh / 2 - py));
      pinImg.style.width = `${width}px`;
      pinImg.style.transform = `translate(${left}px, ${top}px)`;
      pin.style.transform = `translate(${left + px}px, ${top + py}px)`;
    };
    window.addEventListener('resize', placePin, { passive: true });

    const showPin = (zip: string, at: { x: number; y: number } | null) => {
      pinAt = at;
      pinmap.hidden = !at;
      if (!at) return;
      pinCaption.textContent = `The pin marks the approximate centre of ZIP ${zip}, not your address. Red towns are on Shane's confirmed list.`;
      placePin();
    };

    const runZip = async () => {
      const value = zipInput.value;
      retry.hidden = true;
      zipInput.removeAttribute('aria-invalid');
      let data: unknown = null;
      // Clear the previous answer at once so an old result is never read as the answer to the new ZIP.
      show('Checking…', '', null, null);
      showPin('', null);
      let lib: Awaited<ReturnType<typeof zipLib>>;
      try {
        lib = await zipLib();
      } catch {
        // The lookup code itself could not load (offline, flaky network): same honest answer as a failed data load.
        show("The ZIP lookup didn't load. Try again, pick your town instead, or call Shane.", '', { kind: 'call', href: 'tel:+17818204592', label: 'Call 781-820-4592' }, null);
        retry.hidden = false;
        showPin('', null);
        track('service_area_check', { method: 'zip', result: 'lookup_error', service_type: service });
        return;
      }
      const { checkZip, pinPosition } = lib;
      // Validation does not need the data: answer bad input at once.
      const quick = checkZip(value, {}, service, { base });
      if (quick.state === 'invalid') {
        show(quick.message, '', null, null);
        showPin('', null);
        zipInput.setAttribute('aria-invalid', 'true');
        zipInput.focus();
        track('service_area_check', { method: 'zip', result: quick.state, service_type: service });
        return;
      }
      show('Checking…', '', null, null);
      try {
        data = await loadZipData(`${base}data/zip-coverage.json`);
      } catch {
        data = null;
      }
      const result = checkZip(value, data as never, service, { base });
      show(result.message, result.note, result.primary, result.secondary);
      retry.hidden = !result.retry;
      showPin(result.zip, pinPosition(result.pin, projection));
      highlight(result.state === 'covered' && result.towns[0] ? result.towns[0].slug : '', result.towns[0]?.name || '');
      track('service_area_check', { method: 'zip', result: result.state, service_type: service });
    };

    zipForm.addEventListener('submit', (event) => {
      event.preventDefault();
      runZip();
    });
    retry.addEventListener('click', () => runZip());
    // Start the small data download as soon as the visitor shows intent, so the answer is instant.
    zipInput.addEventListener('focus', () => { zipLib().catch(() => {}); loadZipData(`${base}data/zip-coverage.json`).catch(() => {}); }, { once: true });

    // ---- Town picker (no ZIP handy) ----
    const runTown = (value: string) => {
      const result = checkTown(value, service, { base });
      show(result.message, result.note || '', { kind: 'request', href: result.cta.href, label: result.cta.label, townName: result.cta.typed || '' }, { kind: 'call', href: result.callHref, label: 'Call 781-820-4592' });
      retry.hidden = true;
      showPin('', null);
      highlight(result.status === 'confirmed' && result.town ? result.town.slug : '', select.selectedOptions[0]?.textContent || '');
      // Only the enumerated town slug (or "other") is reported; typed text never leaves the page.
      track('service_area_check', { method: 'town', town: result.town ? result.town.slug : 'other', result: result.status, service_type: service });
    };

    [cta, second].forEach((link) =>
      link.addEventListener('click', () => {
        try {
          if (link.dataset.typedTown) sessionStorage.setItem('sm_town_other', link.dataset.typedTown);
          else sessionStorage.removeItem('sm_town_other');
        } catch (_) { /* storage unavailable: the visitor can type the town on the next page */ }
      }),
    );

    select.addEventListener('change', () => {
      if (select.value) {
        other.value = '';
        runTown(select.value);
      }
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = select.value || other.value.trim();
      if (!value) {
        select.focus();
        return;
      }
      runTown(value);
    });
    paths.forEach((p) => {
      p.addEventListener('click', () => {
        select.value = p.dataset.town || '';
        other.value = '';
        runTown(select.value);
      });
    });

    // ---- Interactive Google Map: on request only, never required ----
    const openBtn = root.querySelector<HTMLButtonElement>('[data-gmap-open]');
    const mapEl = root.querySelector<HTMLElement>('[data-gmap]');
    const status = root.querySelector<HTMLElement>('[data-gmap-status]');
    const key = root.dataset.mapsKey || '';
    if (openBtn && mapEl && status && key) {
      const fail = () => {
        mapEl.hidden = true;
        openBtn.disabled = false;
        status.textContent = "The interactive map couldn't load. The checker above works without it.";
        track('service_area_map_error');
      };
      const loadGoogle = () =>
        new Promise<void>((resolve, reject) => {
          const w = window as unknown as Record<string, unknown> & { google?: { maps?: unknown } };
          if (w.google && w.google.maps) return resolve();
          const timer = window.setTimeout(() => reject(new Error('timeout')), 10000);
          w.__smMapsReady = () => { window.clearTimeout(timer); resolve(); };
          w.gm_authFailure = () => { window.clearTimeout(timer); reject(new Error('auth')); fail(); };
          const s = document.createElement('script');
          s.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(key)}&callback=__smMapsReady&loading=async&v=weekly`;
          s.async = true;
          s.onerror = () => { window.clearTimeout(timer); reject(new Error('load')); };
          document.head.appendChild(s);
        });

      openBtn.addEventListener('click', async () => {
        openBtn.disabled = true;
        status.textContent = 'Loading map…';
        track('service_area_map_open');
        try {
          await loadGoogle();
          const g = (window as unknown as { google: any }).google;
          const { Map } = await g.maps.importLibrary('maps');
          const response = await fetch(`${base}data/service-area.geojson`);
          if (!response.ok) throw new Error('geojson');
          const geojson = await response.json();
          mapEl.hidden = false;
          const map = new Map(mapEl, { center: { lat: 42.47, lng: -71.03 }, zoom: 10, gestureHandling: 'cooperative', mapTypeControl: false, streetViewControl: false, clickableIcons: false });
          map.data.addGeoJson(geojson);
          const style = (feature: any) => ({
            fillColor: '#D32B2C',
            fillOpacity: feature.getProperty('slug') === selectedSlug ? 0.5 : 0.16,
            strokeColor: '#B11F20',
            strokeWeight: 1.2,
          });
          map.data.setStyle(style);
          map.data.addListener('click', (e: any) => {
            select.value = e.feature.getProperty('slug');
            other.value = '';
            runTown(select.value);
          });
          refreshMap = () => map.data.setStyle(style);
          status.textContent = 'Click a coloured town to check it.';
        } catch {
          fail();
        }
      });
    }

    root.setAttribute('data-ready', 'true');
  });
</script>

<style>
  .area-checker { display: grid; gap: 1.25rem; }
  .zip-form { display: grid; gap: .35rem; max-width: 30rem; }
  .zip-form label { font-weight: 700; }
  .zip-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .5rem; }
  .zip-row input { font: inherit; font-size: 1.15rem; letter-spacing: .06em; width: 100%; min-height: 50px; padding: .6rem .85rem; border: 2px solid var(--color-control); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); }
  .zip-row input:focus { border-color: var(--color-text); }
  .zip-row input[aria-invalid='true'] { border-color: var(--color-action-hover); }
  .zip-row .btn { min-height: 50px; padding-inline: 1.4rem; }
  .zip-form .hint { margin: 0; font-size: .88rem; color: var(--color-text-muted); }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .area-form { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: end; max-width: 44rem; padding-top: .75rem; }
  @media (min-width: 700px) { .area-form { grid-template-columns: 1fr 1fr auto; max-width: none; } }
  .nojs-town { padding-top: 0; }
  .nojs-call { margin: .5rem 0 0; }
  .nojs-call a { font-weight: 700; text-decoration: underline; }
  .area-field { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
  .area-field label { font-weight: 700; }
  .area-field select, .area-field input { font: inherit; font-size: 1rem; width: 100%; min-height: 50px; padding: .65rem .85rem; border: 2px solid var(--color-control); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); }
  .area-field select:focus, .area-field input:focus { border-color: var(--color-text); }
  .area-result { max-width: 44rem; background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--color-action); border-radius: var(--radius-sm); padding: 1rem 1.1rem; }
  .area-message { margin: 0 0 .35rem; font-weight: 700; font-size: 1.08rem; }
  .area-note { margin: 0 0 .6rem; color: var(--color-text-muted); font-size: .95rem; }
  .area-actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: .8rem; }
  .area-actions .btn { flex: 1 1 11rem; }
  .area-form .btn { min-height: 50px; }
  .pinmap { margin: .6rem 0 0; }
  .pinmap-frame { position: relative; height: 190px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #E4E1DA; }
  @media (min-width: 700px) { .pinmap-frame { height: 230px; } }
  .pinmap-frame img { position: absolute; left: 0; top: 0; max-width: none; height: auto; transform-origin: 0 0; }
  .pin { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .pin-dot { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: var(--color-text); border: 3px solid #fff; box-shadow: 0 0 0 1px var(--color-text); }
  /* A wide, faint circle says "somewhere around here" rather than "your house". */
  .pin-ring { position: absolute; left: -34px; top: -34px; width: 68px; height: 68px; border-radius: 50%; border: 2px dashed var(--color-text); background: rgba(49, 49, 49, .08); }
  .pinmap-cap { margin: .4rem 0 0; font-size: .85rem; color: var(--color-text-muted); }
  .area-manual summary, .area-townlist summary { display: flex; align-items: center; min-height: 44px; cursor: pointer; font-weight: 700; text-decoration: underline; text-underline-offset: .2em; width: fit-content; }
  .area-map { margin: 0; display: grid; gap: .8rem; justify-items: center; }
  .area-svg { width: 100%; max-width: 440px; height: auto; max-height: 600px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
  .area-svg .ctx { fill: var(--color-border); stroke: var(--color-surface); stroke-width: .8; }
  .area-svg .town { fill: var(--color-tint); stroke: var(--color-action-hover); stroke-width: 1.2; stroke-linejoin: round; cursor: pointer; }
  .area-svg .town:hover { fill: #EDC3BF; }
  .area-svg .town.is-selected { fill: var(--color-action); }
