---
// Option 5: a plumber answers (a proposed brand character; needs Shane's approval). Rules every hero follows are in ./README.md (shared copy, unchanged logo,
// one-shot CSS-only motion whose resting state is the static design, aria-hidden drawings).
import HeroCopy from '../HeroCopy.astro';
import LogoPicture from '../LogoPicture.astro';
---

  <section class="home-hero hv5" id="top" aria-labelledby="hero-h" data-hero="5">
    <div class="container hv5-grid">
      <div class="hv5-art">
        <svg class="hv5-svg" viewBox="0 0 240 280" aria-hidden="true" focusable="false">
          <g class="hv5-rings" fill="none" stroke-linecap="round">
            <path d="M190 70 a 26 26 0 0 1 10 22" />
            <path d="M202 56 a 44 44 0 0 1 16 36" />
          </g>
          <path class="hv5-shirt" d="M30 280 V 196 Q 30 146 84 136 H 156 Q 210 146 210 196 V 280 Z" />
          <rect class="hv5-skin" x="106" y="112" width="28" height="28" rx="6" />
          <path class="hv5-collar" d="M102 136 L120 162 L138 136" />
          <rect class="hv5-pocket" x="60" y="190" width="34" height="5" rx="2" />
          <circle class="hv5-skin" cx="120" cy="86" r="36" />
          <ellipse class="hv5-ear" cx="86" cy="92" rx="6" ry="9" />
          <path class="hv5-cap" d="M84 84 a 36 36 0 0 1 72 0 Z" />
          <path class="hv5-brim" d="M90 78 H 62 a 5 5 0 0 0 0 10 H 90 Z" />
          <g class="hv5-arm">
            <path class="hv5-sleeve" d="M186 176 Q 206 132 166 104" />
            <rect class="hv5-phonebody" x="148" y="70" width="16" height="34" rx="4" transform="rotate(14 156 87)" />
            <circle class="hv5-skin" cx="164" cy="103" r="14" />
          </g>
        </svg>
        <div class="hv5-logo"><LogoPicture class="hero-logo" sizes="(min-width: 900px) 200px, 38vw" /></div>
      </div>
      <HeroCopy />
    </div>
  </section>

<style>

  .home-hero { padding: 1.25rem 0 2rem; }
  @media (min-width: 900px) { .home-hero { padding: 3rem 0 3.25rem; } }

  /* ---------- Option 5: a plumber answers ---------- */
  .hv5-grid { display: grid; gap: 1rem; }
  .hv5-art { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: .5rem; max-width: 24rem; }
  .hv5-svg { width: 100%; height: auto; aspect-ratio: 240 / 280; align-self: end; }
  .hv5-logo { align-self: center; }
  .hv5-shirt { fill: var(--color-text); }
  .hv5-skin, .hv5-ear { fill: #E2B48C; }
  .hv5-ear { stroke: #C8946A; stroke-width: 2; }
  .hv5-collar { fill: none; stroke: #FFFFFF; stroke-width: 5; stroke-linejoin: round; }
  .hv5-pocket { fill: var(--color-action); }
  .hv5-cap, .hv5-brim { fill: var(--color-action); }
  .hv5-brim { fill: var(--color-action-hover); }
  .hv5-sleeve { fill: none; stroke: #474747; stroke-width: 26; stroke-linecap: round; }
  .hv5-phonebody { fill: #1C1C1C; }
  .hv5-rings { stroke: var(--color-action); stroke-width: 5; opacity: 0; }
  .hv5-arm { transform-box: view-box; transform-origin: 186px 176px; }
  @media (min-width: 900px) {
    .hv5-grid { grid-template-columns: minmax(0, 26rem) 1fr; gap: 3.5rem; align-items: center; }
    .hv5-art { max-width: 26rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv5-rings { animation: sm-blink .55s ease-out 1 both; }
    .hv5-arm { animation: sm-raise .6s .35s cubic-bezier(.3, 1.2, .5, 1) 1 backwards; }
  }

  /* ---------- shared one-shot keyframes (resting state = the CSS above) ---------- */
  @keyframes sm-ring { 0%, 100% { transform: rotate(0); } 20% { transform: rotate(-9deg); } 40% { transform: rotate(8deg); } 60% { transform: rotate(-6deg); } 80% { transform: rotate(4deg); } }
  @keyframes sm-blink { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sm-draw { from { stroke-dashoffset: 100; } }
  @keyframes sm-uncover { from { transform: scaleX(1); } }
  @keyframes sm-lift { from { transform: translate(0, 0) rotate(0); } }
  @keyframes sm-turn { from { transform: rotate(-30deg); } }
  @keyframes sm-slide { from { transform: translateX(-12%); } }
  @keyframes sm-raise { from { transform: rotate(-60deg); } }
</style>
