---
// Option 4: Rough to finished. Two photos from the same job in src/jobs.json ("Kitchen & Bath Remodel": the rough stage
// and the finished kitchen) in one frame. The divider sweeps once on load, then the visitor can drag it (mouse, touch)
// or use the arrow keys: it is a real, labelled range control. Without JavaScript it rests at half and half.
// Rules: ./README.md.
import HeroCopy from '../HeroCopy.astro';
import HeroPhoto from './HeroPhoto.astro';
import LogoPicture from '../LogoPicture.astro';
---

<section class="home-hero hr" id="top" aria-labelledby="hero-h" data-hero="4">
  <div class="container hr-grid">
    <HeroCopy />
    <figure class="hr-figure">
      <div class="hr-frame" data-reveal>
        <HeroPhoto class="hr-after" name="finished" widths={[480, 680, 840, 1120]} width={1120} height={1400} sizes="(min-width: 900px) 460px, 92vw" alt="The finished kitchen: grey shaker cabinets, white quartz counters and new appliances" priority />
        <div class="hr-before">
          <HeroPhoto name="rough" widths={[480, 680, 840, 1120]} width={1120} height={1400} sizes="(min-width: 900px) 460px, 92vw" alt="The same job at the rough stage: open stud walls and new drain lines in the floor" />
        </div>
        <span class="hr-tag hr-tag-l" aria-hidden="true">Rough stage</span>
        <span class="hr-tag hr-tag-r" aria-hidden="true">Finished</span>
        <span class="hr-track" aria-hidden="true"><span class="hr-line"><span class="hr-grip"><svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg></span></span></span>
        <span class="hr-badge" aria-hidden="true"><LogoPicture sizes="40px" priority={false} /><span>Shane's job</span></span>
        <input class="hr-range" type="range" min="0" max="100" value="50" step="1" aria-label="Compare the rough stage with the finished kitchen" data-reveal-range />
      </div>
      <figcaption>One of Shane's kitchen and bath jobs, from the rough stage to the finished room. Drag to compare.</figcaption>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>('[data-reveal-range]')!;
    frame.classList.add('is-live');
    const set = () => {
      frame.classList.add('is-touched');
      frame.style.setProperty('--pos', `${range.value}%`);
    };
    range.addEventListener('input', set);
  });
</script>

<style>
  @property --pos { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  .hr { --hero-h1: clamp(3.1rem, 13.2vw, 6.8rem); position: relative; overflow: hidden; padding: 1.5rem 0 2.5rem; background:
      radial-gradient(46rem 30rem at 85% 40%, rgba(211, 43, 44, .1), transparent 70%),
      var(--color-bg); }
  .hr-grid { display: grid; gap: 1.75rem; }
  .hr-figure { margin: 0; max-width: 30rem; width: 100%; justify-self: center; }
  .hr-frame { --pos: 50%; position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 10px; background: #222; box-shadow: 0 34px 60px -30px rgba(49, 49, 49, .55), 0 0 0 1px rgba(49, 49, 49, .12); user-select: none; }
  .hr-frame :global(picture), .hr-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hr-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  /* The divider moves with a transform (a moving left offset would count as layout shift). */
  .hr-track { position: absolute; inset: 0; transform: translateX(var(--pos)); pointer-events: none; }
  .hr-line { position: absolute; top: 0; bottom: 0; left: 0; width: 4px; margin-left: -2px; background: #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, .15), 0 0 24px rgba(0, 0, 0, .35); pointer-events: none; }
  .hr-grip { position: absolute; top: 50%; left: 50%; width: 52px; height: 52px; margin: -26px 0 0 -26px; border-radius: 50%; background: var(--color-action); border: 3px solid #fff; display: grid; place-items: center; box-shadow: 0 8px 20px rgba(0, 0, 0, .35); }
  .hr-grip svg { width: 26px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .hr-tag { position: absolute; top: 14px; padding: .3rem .65rem; border-radius: 4px; font-family: var(--font-display); font-weight: 700; font-size: 1rem; letter-spacing: .06em; text-transform: uppercase; background: rgba(20, 20, 20, .78); color: #fff; pointer-events: none; }
  .hr-tag-l { left: 14px; }
  .hr-tag-r { right: 14px; background: #fff; color: var(--color-text); }
  .hr-badge { position: absolute; left: 12px; bottom: 12px; display: flex; align-items: center; gap: .45rem; padding: 4px 10px 4px 4px; border-radius: 999px; background: #fff; font-size: .82rem; font-weight: 700; color: var(--color-text); box-shadow: 0 6px 16px rgba(0, 0, 0, .25); pointer-events: none; }
  .hr-badge :global(picture) { width: 40px; }
  .hr-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; display: none; }
  .hr-frame.is-live .hr-range { display: block; }
  .hr-frame:has(.hr-range:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .hr-figure figcaption { margin-top: .7rem; font-size: .9rem; color: var(--color-text-muted); }

  @media (min-width: 900px) {
    .hr { --hero-h1: clamp(3.4rem, 6.8vw, 6.8rem); padding: 3.5rem 0; }
    .hr-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 29rem); gap: 3.5rem; align-items: center; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hr-frame:not(.is-touched) { animation: hr-sweep 1.9s .5s cubic-bezier(.6, 0, .3, 1) backwards; }
    .hr-grip { animation: hr-nudge .5s 2.45s ease-in-out; }
  }
  @keyframes hr-sweep { 0% { --pos: 94%; } 55% { --pos: 16%; } 100% { --pos: 50%; } }
  @keyframes hr-nudge { 50% { transform: scale(1.12); } }
</style>
