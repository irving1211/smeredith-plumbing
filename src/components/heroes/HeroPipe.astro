---
// Option 1: phone, pipe, logo. Rules every hero follows are in ./README.md (shared copy, unchanged logo,
// one-shot CSS-only motion whose resting state is the static design, aria-hidden drawings).
import HeroCopy from '../HeroCopy.astro';
import LogoPicture from '../LogoPicture.astro';
---

  <section class="home-hero hv1" id="top" aria-labelledby="hero-h" data-hero="1">
    <div class="container hv1-grid">
      <div class="hv1-art">
        <svg class="hv1-svg" viewBox="0 0 520 300" aria-hidden="true" focusable="false">
          <g class="hv1-phone">
            <path transform="translate(14 70) scale(.86)" d="M0 28 C 0 12 12 2 30 0 L 90 0 C 108 2 120 12 120 28 L 120 34 Q 120 40 114 40 L 92 40 Q 86 40 86 34 L 86 24 Q 86 18 80 18 L 40 18 Q 34 18 34 24 L 34 34 Q 34 40 28 40 L 6 40 Q 0 40 0 34 Z" />
          </g>
          <g class="hv1-ring" fill="none" stroke-linecap="round">
            <path d="M38 58 a 34 34 0 0 1 54 0" />
            <path d="M24 46 a 52 52 0 0 1 82 0" />
          </g>
          <path class="hv1-pipe" d="M118 95 H 236 a 28 28 0 0 1 28 28 V 172 a 28 28 0 0 0 28 28 H 356" />
          <g class="hv1-fit">
            <rect x="114" y="84" width="9" height="22" rx="2" />
            <rect x="232" y="84" width="9" height="22" rx="2" />
            <rect x="253" y="119" width="22" height="9" rx="2" />
            <rect x="253" y="167" width="22" height="9" rx="2" />
            <rect x="287" y="189" width="9" height="22" rx="2" />
            <rect x="346" y="189" width="9" height="22" rx="2" />
          </g>
          <path class="hv1-flow" pathLength="100" d="M118 95 H 236 a 28 28 0 0 1 28 28 V 172 a 28 28 0 0 0 28 28 H 356" />
        </svg>
        <div class="hv1-logo">
          <LogoPicture class="hero-logo" sizes="(min-width: 900px) 170px, 32vw" />
          <span class="hv1-cover" aria-hidden="true"></span>
        </div>
      </div>
      <HeroCopy />
    </div>
  </section>

<style>

  .home-hero { padding: 1.25rem 0 2rem; }
  @media (min-width: 900px) { .home-hero { padding: 3rem 0 3.25rem; } }

  /* ---------- Option 1: phone -> pipe -> logo ---------- */
  .hv1-grid { display: grid; gap: 1rem; }
  .hv1-art { position: relative; aspect-ratio: 520 / 300; width: 100%; max-width: 30rem; }
  .hv1-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hv1-phone { fill: var(--color-text); }
  .hv1-ring { stroke: var(--color-action); stroke-width: 6; opacity: 0; }
  .hv1-pipe { fill: none; stroke: var(--color-text); stroke-width: 14; }
  .hv1-fit { fill: var(--color-text); }
  .hv1-flow { fill: none; stroke: var(--color-action); stroke-width: 4; stroke-dasharray: 100; stroke-dashoffset: 0; }
  /* The pipe ends at x=356, y=200 of the 520 x 300 drawing; the logo (164 units wide) is centred on that end. */
  .hv1-logo { position: absolute; left: 68.5%; top: 39.3%; width: 31.5%; }
  .hv1-cover { position: absolute; inset: -2px; background: var(--color-bg); transform: scaleX(0); transform-origin: 100% 50%; }
  @media (min-width: 900px) {
    .hv1-grid { grid-template-columns: 1fr minmax(0, 30rem); gap: 3rem; align-items: center; }
    .hv1-grid > :global(.hero-copy) { order: -1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv1-phone { animation: sm-ring .5s ease-in-out 1 both; transform-box: view-box; transform-origin: 66px 87px; }
    .hv1-ring { animation: sm-blink .7s ease-out 1 both; }
    .hv1-flow { animation: sm-draw .65s .35s cubic-bezier(.4, 0, .2, 1) 1 backwards; }
    .hv1-cover { animation: sm-uncover .4s .95s cubic-bezier(.4, 0, .2, 1) 1 backwards; }
  }

  /* ---------- shared one-shot keyframes (resting state = the CSS above) ---------- */
  @keyframes sm-ring { 0%, 100% { transform: rotate(0); } 20% { transform: rotate(-9deg); } 40% { transform: rotate(8deg); } 60% { transform: rotate(-6deg); } 80% { transform: rotate(4deg); } }
  @keyframes sm-blink { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sm-draw { from { stroke-dashoffset: 100; } }
  @keyframes sm-uncover { from { transform: scaleX(1); } }
  @keyframes sm-lift { from { transform: translate(0, 0) rotate(0); } }
  @keyframes sm-turn { from { transform: rotate(-30deg); } }
  @keyframes sm-slide { from { transform: translateX(-12%); } }
  @keyframes sm-raise { from { transform: rotate(-60deg); } }
</style>
