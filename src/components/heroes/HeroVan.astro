---
// Option 4: van lettering workbench. Rules every hero follows are in ./README.md (shared copy, unchanged logo,
// one-shot CSS-only motion whose resting state is the static design, aria-hidden drawings).
import HeroCopy from '../HeroCopy.astro';
import LogoPicture from '../LogoPicture.astro';
---

  <section class="home-hero hv4" id="top" aria-labelledby="hero-h" data-hero="4">
    <div class="container hv4-grid">
      <HeroCopy />
      <div class="hv4-panel" aria-hidden="true">
        <ul class="hv4-list">
          <li>Remodels</li>
          <li>Boilers</li>
          <li>New Construction</li>
          <li>General Plumbing</li>
          <li>Water Heaters</li>
        </ul>
        <div class="hv4-decal"><LogoPicture class="hero-logo" sizes="(min-width: 900px) 220px, 34vw" /></div>
        <p class="hv4-lic">License #9630040</p>
        <svg class="hv4-strip" viewBox="0 0 600 90" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
          <rect class="hv4-pipe" x="0" y="56" width="600" height="16" rx="2" />
          <rect class="hv4-cpl" x="140" y="50" width="18" height="28" rx="3" />
          <rect class="hv4-cpl" x="300" y="50" width="18" height="28" rx="3" />
          <g class="hv4-wrench">
            <g transform="translate(458 64) rotate(70) scale(1.4)">
              <rect x="-13" y="-100" width="13" height="84" rx="6" />
              <rect x="-17" y="-34" width="21" height="9" rx="2" class="hv4-nut" />
              <path d="M-17 -18 H 13 Q 17 -18 17 -14 V -10 H -6 V 10 H 10 V 19 H -17 Z" />
            </g>
          </g>
        </svg>
      </div>
    </div>
  </section>

<style>

  .home-hero { padding: 1.25rem 0 2rem; }
  @media (min-width: 900px) { .home-hero { padding: 3rem 0 3.25rem; } }

  /* ---------- Option 4: van lettering workbench ---------- */
  .hv4-grid { display: grid; gap: 1.5rem; }
  .hv4-panel { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .78fr); gap: .75rem 1rem; align-items: center; background: #FFFFFF; border: 1px solid var(--color-border); border-radius: 14px 14px 6px 6px; padding: 1.1rem 1rem 0; overflow: hidden; }
  .hv4-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .1rem; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-weight: 700; font-style: italic; font-size: clamp(1rem, 4.3vw, 1.45rem); line-height: 1.3; color: #1F1F1F; letter-spacing: -.01em; }
  .hv4-list li::before { content: '\2022'; margin-right: .1em; }
  .hv4-decal { align-self: center; }
  .hv4-lic { grid-column: 1 / -1; margin: 0; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: .8rem; font-weight: 700; color: var(--color-text-muted); }
  .hv4-strip { grid-column: 1 / -1; width: calc(100% + 2rem); margin: 0 -1rem; height: auto; aspect-ratio: 600 / 90; }
  .hv4-pipe { fill: var(--color-text); }
  .hv4-cpl { fill: var(--color-action); }
  .hv4-wrench { fill: var(--color-text); transform-box: view-box; transform-origin: 458px 64px; }
  .hv4-nut { fill: var(--color-action); }
  @media (min-width: 900px) {
    .hv4-grid { grid-template-columns: 1fr minmax(0, 32rem); gap: 3rem; align-items: center; }
    .hv4-panel { padding: 1.6rem 1.6rem 0; }
    .hv4-strip { width: calc(100% + 3.2rem); margin: 0 -1.6rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv4-wrench { animation: sm-turn .7s .25s cubic-bezier(.3, 1.3, .5, 1) 1 backwards; }
    .hv4-pipe, .hv4-cpl { animation: sm-slide .5s cubic-bezier(.2, 0, .2, 1) 1 backwards; }
  }

  /* ---------- shared one-shot keyframes (resting state = the CSS above) ---------- */
  @keyframes sm-ring { 0%, 100% { transform: rotate(0); } 20% { transform: rotate(-9deg); } 40% { transform: rotate(8deg); } 60% { transform: rotate(-6deg); } 80% { transform: rotate(4deg); } }
  @keyframes sm-blink { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes sm-draw { from { stroke-dashoffset: 100; } }
  @keyframes sm-uncover { from { transform: scaleX(1); } }
  @keyframes sm-lift { from { transform: translate(0, 0) rotate(0); } }
  @keyframes sm-turn { from { transform: rotate(-30deg); } }
  @keyframes sm-slide { from { transform: translateX(-12%); } }
  @keyframes sm-raise { from { transform: rotate(-60deg); } }
</style>
