---
// Baseline: copy only (the current preview hero, portrait removed). Rules every hero follows are in ./README.md (shared copy, unchanged logo,
// one-shot CSS-only motion whose resting state is the static design, aria-hidden drawings).
import HeroCopy from '../HeroCopy.astro';
---

  <section class="home-hero hv0" id="top" aria-labelledby="hero-h" data-hero="baseline">
    <div class="container">
      <HeroCopy compact />
    </div>
  </section>

<style>

  .home-hero { padding: 1.5rem 0 2rem; }
  @media (min-width: 900px) { .home-hero { padding: 3rem 0 3.25rem; } }

  </style>
