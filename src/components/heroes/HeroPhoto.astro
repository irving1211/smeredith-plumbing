---
// One of Shane's photos, cropped by scripts/make-hero-photos.mjs, served as AVIF with a WebP fallback.
interface Props {
  name: string;
  widths: number[];
  /** Pixel size of the largest file (for width/height attributes, which reserve the space). */
  width: number;
  height: number;
  sizes: string;
  alt: string;
  class?: string;
  /** Above the fold: fetch early and do not lazy-load. */
  priority?: boolean;
}
const { name, widths, width, height, sizes, alt, class: className = '', priority = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const set = (ext: string) => widths.map((w) => `${base}images/hero/${name}-${w}.${ext} ${w}w`).join(', ');
const fallback = `${base}images/hero/${name}-${widths[Math.min(1, widths.length - 1)]}.webp`;
---

<picture class={className}>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <img
    src={fallback}
    srcset={set('webp')}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    decoding="async"
    loading={priority ? undefined : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>
