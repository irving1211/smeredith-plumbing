---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'S. Meredith Plumbing & Heating — Saugus, MA Plumber | 24/7 Emergency · Northshore & Boston',
  description = 'Owner-operated plumbing, heating, gas & new construction across the Northshore & Boston. Licensed, insured, 10+ years. The plumber who answers the phone. Call 781-820-4592.',
} = Astro.props;

const phone = '781-820-4592';
const phoneTel = '+17818204592';
const email = 'ShaneMeredith17@gmail.com';
const business = 'S. Meredith Plumbing & Heating';
const areaServed = ['Saugus', 'Lynn', 'Revere', 'Malden', 'Melrose', 'Wakefield', 'Peabody', 'Stoneham', 'Everett', 'Somerville', 'Boston', 'Lexington', 'Tewksbury', 'Haverhill'];

// Verbatim (lightly trimmed) from Shane's verified 5-star Google reviews. Source screenshots
// in _context/harvest/2026-05-28-owner-photo-drop/Reviews screenshot/.
const reviewsList = [
  { name: 'Steven B.', body: 'Shane did a great job with the plumbing for my bathroom remodel. On time, good communication, and minded every detail. Will definitely keep his name and number for the future.' },
  { name: 'Daniel M.', body: 'Shane responded quickly to an urgent furnace repair in the middle of a winter deep freeze. Other plumbers said it could not be fixed — Shane said “I can fix it,” and he did. Highly recommend.' },
  { name: 'Clare G.', body: 'We had a last-minute plumbing issue in our bathroom and Shane came out the same day without hesitation. Incredibly fair, honest, and responsive from start to finish. 10/10 service.' },
  { name: 'Carly C.', body: 'Shane came out quickly and replaced the water heater without any delays. He was so understanding of my situation with four kids at home and got our hot water back as soon as possible.' },
  { name: 'Luke B.', body: 'Same-day visit, and he arrived exactly when he said he would. Quickly diagnosed and resolved the problem, explained it in plain terms, and his pricing was very reasonable.' },
  { name: 'Iva V.', body: 'Great job on a holiday morning for a plumbing emergency. Fast, quality work that started even before the visit via video, so we didn’t waste time. Very accommodating.' },
  { name: 'Val K.', body: 'Very professional and pays close attention to detail. He added safety, functionality, and modernity to our plumbing at a very fair price, and explained red flags to watch for.' },
  { name: 'Laura C.', body: 'After more than a week and multiple professionals trying to fix a complex problem in our building, Shane did it. Professional, knowledgeable, and willing to take the time to get it right.' },
  { name: 'Amy C.', body: 'Excellent at his craft, smart, and a true problem solver. Honest, dependable, and operates with real integrity. I’ve used his services multiple times and referred him to others.' },
  { name: 'Emilio D.', body: 'As a facilities manager responsible for multiple properties, I can confidently say S. Meredith Plumbing is one of the best in the business. Always prompt and dependable, and their pricing is very fair.' },
];

const faqs = [
  { q: 'Do you offer free estimates?', a: 'Yes. Every job starts with a free, written estimate. No surprise pricing, no upsell scripts, and no third-party dispatcher.' },
  { q: 'Are you licensed and insured?', a: 'Yes. Fully licensed in Massachusetts and fully insured. MA license #9630040-PL-M is listed on every written estimate and invoice.' },
  { q: 'How fast do you respond?', a: 'Calls are answered live during business hours and returned within one hour after-hours. For true emergencies like no heat in January, a burst pipe, or no hot water, we come out nights and weekends too.' },
  { q: 'What areas do you serve?', a: 'Based in Saugus, MA. Working homes and jobsites across the Northshore and into Boston, including Lynn, Revere, Malden, Melrose, Wakefield, Peabody, Stoneham, Everett, Somerville, Boston, Lexington, Tewksbury, Haverhill, and beyond. Outside the list? Call. If we’re close, we’ll help.' },
  { q: 'Do you stand behind your work?', a: 'Yes. Shane is licensed and insured, and work is done to code and inspected where required. Manufacturer warranties apply to the equipment installed, and workmanship is gone over with you in writing for each job. No boilerplate.' },
  { q: 'Do you handle new construction and additions?', a: 'Yes. From rough-in to finish, Shane handles plumbing for new builds, additions, and gut renovations. Inspected, signed off, and ready to occupy.' },
  { q: 'Do you work weekends and holidays?', a: '24/7 for true emergencies. Same-day Saturday for boiler and water heater failures whenever possible. You call, Shane answers.' },
];

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: business,
  image: 'https://smeredithplumbing.com/images/logo.jpg',
  '@id': 'https://smeredithplumbing.com',
  url: 'https://smeredithplumbing.com',
  telephone: phone,
  email,
  priceRange: '$$',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saugus',
    addressRegion: 'MA',
    postalCode: '01906',
    addressCountry: 'US',
  },
  areaServed: [...new Set(areaServed)].map((city) => ({ '@type': 'City', name: `${city}, MA` })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  sameAs: [
    'https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/',
    'https://www.instagram.com/s.meredith_plumbing_heating/',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: String(reviewsList.length),
    bestRating: '5',
    worstRating: '1',
  },
  review: reviewsList.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: r.body,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Plumbing & Heating Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Plumbing Service & Repair' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Water Heater Replacement & Repair' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'High-Efficiency Boiler Service & Replacement' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Kitchen & Bathroom Remodels' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'New Construction Plumbing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gas Installation' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '24/7 Emergency Plumbing & Heating' } },
    ],
  },
};

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://smeredithplumbing.com').href;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://smeredithplumbing.com/images/logo.jpg" />
    <meta name="theme-color" content="#1a120a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.jpg`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fraunces:opsz,wght,SOFT@9..144,500..800,30..100&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <slot name="head" />
    <style is:global>
      :root {
        /* Tough, industrial-grade modern palette: deep soot charcoal base, solid masonry whites/greys, safety red.
           Retains subtle paper texture for premium craft personality but increases visual contrast and trade authority. */
        --black: #111111;
        --ink: #1f2937;
        --ink-soft: #4b5563;
        --ink-muted: #6b7280;
        --line: rgba(17, 17, 17, 0.08);
        --line-2: rgba(17, 17, 17, 0.15);
        --paper: #FAF9F6; /* premium linen warmth */
        --paper-2: #F3F1EB; /* masonry grey-white */
        --paper-3: #E7E4DC;
        --highlight: #fee2e2; /* pale safety red tint */
        --red: #d32f2f; /* safety red */
        --red-dark: #b71c1c;
        --gold: #c2902c;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        letter-spacing: -0.011em;
      }
      h1, h2, h3, h4 {
        font-family: 'Inter', sans-serif;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: var(--black);
        margin: 0;
        line-height: 1.05;
      }
      h1 { letter-spacing: -0.04em; line-height: 1.02; }
      .display-serif {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 900;
        font-style: normal;
        letter-spacing: -0.025em;
        color: var(--red);
        text-decoration: underline;
        text-decoration-color: rgba(211, 47, 47, 0.25);
        text-underline-offset: 4px;
        text-decoration-thickness: 3px;
      }
      a { color: var(--black); text-decoration: none; transition: color .15s ease, opacity .15s ease; }
      a:hover { opacity: 0.7; }
      img { max-width: 100%; display: block; }
      .container { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
      .btn {
        display: inline-flex; align-items: center; gap: .55rem;
        padding: 1rem 1.7rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.005em;
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease, color .18s ease;
        cursor: pointer; border: none;
        font-family: inherit;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .btn-primary {
        background: var(--red); color: #fff;
        box-shadow: 0 2px 4px rgba(17, 17, 17, 0.08);
      }
      .btn-primary:hover { background: var(--red-dark); color: #fff; opacity: 1; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(211,47,47,.28); }
      .btn-dark { background: var(--black); color: #fff; }
      .btn-dark:hover { background: #000; color: #fff; opacity: 1; transform: translateY(-1px); }
      .btn-ghost { background: transparent; color: var(--black); border: 2px solid var(--line-2); }
      .btn-ghost:hover { border-color: var(--black); opacity: 1; }
      .btn-secondary {
        background: var(--paper-3);
        color: var(--black);
        border: 1px solid var(--line-2);
        box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
      }
      .btn-secondary:hover {
        background: var(--paper-2);
        border-color: var(--black);
        transform: translateY(-1px);
        opacity: 1;
      }
      .btn-ghost-dark { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.3); }
      .btn-ghost-dark:hover { border-color: #fff; color: #fff; opacity: 1; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
