---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'S. Meredith Plumbing & Heating — Saugus, MA Plumber | 24/7 Emergency · Northshore & Boston',
  description = 'Owner-operated plumbing, heating, gas & new construction across the Northshore & Boston. Licensed, insured, 10+ years. The plumber who answers the phone. Call 781-820-4592.',
} = Astro.props;

const phone = '781-820-4592';
const phoneTel = '+17818204592';
const email = 'ShaneMeredith17@gmail.com';
const business = 'S. Meredith Plumbing & Heating';
const areaServed = ['Saugus', 'Lynn', 'Revere', 'Malden', 'Melrose', 'Wakefield', 'Peabody', 'Stoneham', 'Everett', 'Somerville', 'Boston', 'Lexington', 'Tewksbury', 'Georgetown', 'Haverhill'];

const reviewsList = [
  { name: 'Christina C.', body: 'Reliable and quick to respond every single time. Shane has done extensive work for us and we won’t call anyone else.' },
  { name: 'Rob F.', body: 'Professional, responsive, and there when you need him — even after hours. Hard to find that anymore.' },
  { name: 'Clare G.', body: 'Fair, honest, and skilled. Friendly on top of it. Exactly what you want in a plumber.' },
  { name: 'Sarah S.', body: 'Quick, knowledgeable, and honest. Easy to work with from the first call to the finished job.' },
];

const faqs = [
  { q: 'Do you offer free estimates?', a: 'Yes — every job starts with a free, written estimate. No surprise pricing, no upsell scripts, no third-party dispatcher.' },
  { q: 'Are you licensed and insured?', a: 'Yes. Fully licensed in Massachusetts and fully insured. License number provided on every written estimate and invoice.' },
  { q: 'How fast do you respond?', a: 'Calls answered live during business hours, and returned within one hour after-hours. True emergencies (no heat in January, burst pipe, no hot water) — we come out, including nights and weekends.' },
  { q: 'What areas do you serve?', a: 'Based in Saugus, MA. Working homes and jobsites across the Northshore and into Boston — Lynn, Revere, Malden, Melrose, Wakefield, Peabody, Stoneham, Everett, Somerville, Boston, Lexington, Tewksbury, Georgetown, Haverhill, and beyond. Outside the list? Call — if we’re close, we’ll help.' },
  { q: 'What payment methods do you take?', a: 'Cash, check, all major credit cards, and Venmo. Payment is due on completion of the work.' },
  { q: 'Do you guarantee your work?', a: 'Yes. One-year guarantee on all labor. Manufacturer warranty covers parts and equipment (typically 5–12 years on boilers and water heaters — we’ll spell out the exact warranty before install).' },
  { q: 'Do you handle new construction and additions?', a: 'Yes — rough-in to finish. Plumbing for new builds, additions, and gut renovations. Inspected, signed off, ready to occupy.' },
  { q: 'Do you work weekends and holidays?', a: '24/7 for true emergencies. Same-day Saturday for boiler and water heater failures whenever possible. You call, Shane answers.' },
];

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: business,
  image: 'https://smeredithplumbing.com/images/logo.jpg',
  '@id': 'https://smeredithplumbing.com',
  url: 'https://smeredithplumbing.com',
  telephone: phone,
  email,
  priceRange: '$$',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saugus',
    addressRegion: 'MA',
    postalCode: '01906',
    addressCountry: 'US',
  },
  areaServed: [...new Set(areaServed)].map((city) => ({ '@type': 'City', name: `${city}, MA` })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  sameAs: [
    'https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/',
    'https://www.instagram.com/s.meredith_plumbing_heating/',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: String(reviewsList.length),
    bestRating: '5',
    worstRating: '5',
  },
  review: reviewsList.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: r.body,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Plumbing & Heating Services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Plumbing Service & Repair' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Water Heater Replacement & Repair' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'High-Efficiency Boiler Service & Replacement' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Kitchen & Bathroom Remodels' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'New Construction Plumbing' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gas Installation' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: '24/7 Emergency Plumbing & Heating' } },
    ],
  },
};

const base = import.meta.env.BASE_URL;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/logo.jpg" />
    <meta name="theme-color" content="#1a120a" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.jpg`} />
    <link rel="canonical" href="https://smeredithplumbing.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fraunces:opsz,wght,SOFT@9..144,500..800,30..100&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <slot name="head" />
    <style is:global>
      :root {
        /* Warm-craft palette: cream base, warm dark ink, terracotta accent.
           Subtle shift from pure white — keeps trades-credibility, adds hand-feel. */
        --black: #1a120a;
        --ink: #2a1f14;
        --ink-soft: #5a4a3a;
        --ink-muted: #8a7867;
        --line: rgba(42, 31, 20, 0.10);
        --line-2: rgba(42, 31, 20, 0.18);
        --paper: #faf7f2;
        --paper-2: #f2ebe0;
        --paper-3: #e8dfd2;
        --highlight: #f4e4c9;
        --red: #c2492c;
        --red-dark: #9d3a23;
        --gold: #b88a3a;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        letter-spacing: -0.011em;
      }
      h1, h2, h3, h4 {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: var(--black);
        margin: 0;
        line-height: 1.05;
      }
      h1 { letter-spacing: -0.035em; line-height: 1.02; }
      .display-serif {
        font-family: 'Fraunces', 'Source Serif Pro', Georgia, serif;
        font-weight: 700;
        font-style: italic;
        letter-spacing: -0.02em;
        font-variation-settings: "SOFT" 50, "opsz" 144;
      }
      a { color: var(--black); text-decoration: none; transition: color .15s ease, opacity .15s ease; }
      a:hover { opacity: 0.7; }
      img { max-width: 100%; display: block; }
      .container { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
      .btn {
        display: inline-flex; align-items: center; gap: .55rem;
        padding: 1rem 1.7rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: -0.005em;
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease, color .18s ease;
        cursor: pointer; border: none;
        font-family: inherit;
        text-decoration: none;
      }
      .btn-primary {
        background: var(--red); color: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.06);
      }
      .btn-primary:hover { background: var(--red-dark); color: #fff; opacity: 1; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(194,73,44,.28); }
      .btn-dark { background: var(--black); color: #fff; }
      .btn-dark:hover { background: #2c1f12; color: #fff; opacity: 1; transform: translateY(-1px); }
      .btn-ghost { background: transparent; color: var(--black); border: 1.5px solid var(--line-2); }
      .btn-ghost:hover { border-color: var(--black); opacity: 1; }
      .btn-ghost-dark { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,.3); }
      .btn-ghost-dark:hover { border-color: #fff; color: #fff; opacity: 1; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
