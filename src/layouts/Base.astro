---
import { jsonLd } from '../lib/jsonld.js';
// Design tokens are generated from design/tokens.json (client-design-system). Fonts: one variable Inter
// (a single ~48 KB file) for reading text and one Barlow Condensed weight (22 KB) for headings and buttons.
import "../../design/tokens.css";
import "../styles/fonts.css";
import "../styles/site.css";

import barlowUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import services from '../services.json';
import { TOWNS } from '../lib/service-area.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Utility pages (thank-you, 404) stay out of the index and carry no canonical. */
  noindex?: boolean;
  /** Used by the event layer: home | services-hub | service | town | contact | lead-confirmation | not-found */
  pageType?: string;
  /** Extra event parameters, e.g. { service: 'boiler-service' } */
  pageMeta?: Record<string, string>;
  /** FAQ entries that are VISIBLY rendered on this page. Only then is FAQPage schema emitted. */
  faqs?: { q: string; a: string }[];
  /** Highlighted item in the header navigation: services | work | about | service-area */
  current?: string;
  /** Pages that supply their own header/footer (none today) can switch the shared ones off. */
  header?: boolean;
  footer?: boolean;
}

const {
  title = 'S. Meredith Plumbing & Heating | Saugus, MA Plumber',
  description = 'Owner-operated plumber in Saugus, MA. Water heaters, boilers, gas lines, remodels and 24/7 emergency service. Call 781-820-4592.',
  noindex = false,
  pageType = 'page',
  pageMeta = {},
  faqs = [],
  current = '',
  header = true,
  footer = true,
} = Astro.props;

const site = 'https://smeredithplumbing.com';
const phone = '781-820-4592';
const publicEmail = 'shane@smeredithplumbing.com';
const business = 'S. Meredith Plumbing & Heating';
// Approved website service-area set (owner boundary map, 2026-05-28), read from the single canonical
// list in src/service-area.json. It must match the GBP service areas.
const areaServed = TOWNS.map((t) => t.name);

// Service-area business: locality only, never a street address. No aggregateRating/review markup
// (self-serving LocalBusiness reviews are not eligible for review snippets) and no regular
// openingHours until Shane confirms routine hours beyond 24/7 emergency availability.
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': `${site}/#business`,
  name: business,
  url: `${site}/`,
  image: `${site}/images/logo.jpg`,
  logo: `${site}/images/logo.jpg`,
  telephone: '+1-781-820-4592',
  email: publicEmail,
  priceRange: '$$',
  description: 'Owner-operated plumbing and heating company based in Saugus, MA, serving the North Shore and Boston: water heaters, boilers, gas lines, remodel and new-construction plumbing, and 24/7 emergency service.',
  founder: { '@type': 'Person', name: 'Shane Meredith' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saugus',
    addressRegion: 'MA',
    postalCode: '01906',
    addressCountry: 'US',
  },
  areaServed: areaServed.map((city) => ({ '@type': 'City', name: `${city}, MA` })),
  sameAs: [
    'https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/',
    'https://www.instagram.com/s.meredith_plumbing_heating/',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Plumbing & Heating Services',
    itemListElement: [
      ...services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${site}/services/${s.slug}/` },
      })),
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'General Plumbing Service & Repair' } },
    ],
  },
};

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site).href;

const faqJsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// Optional analytics. Nothing third-party loads unless an ID is configured at build time
// (and the privacy notice has been updated to disclose it).
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content={business} />
    <meta property="og:image" content="https://smeredithplumbing.com/images/logo.jpg" />
    <meta name="theme-color" content="#313131" />
    <!-- Only the heading/wordmark font is preloaded: it is the brand face above the fold on every page, so it must not
         swap in after first paint. The body font (Inter) is deliberately NOT preloaded: measured with an interleaved A/B on
         a throttled phone (4x CPU, 9 Mbps), preloading it made first paint about 100 ms later with no layout-shift benefit.
         The two font files together stay well under 100 KB either way. -->
    <link rel="preload" href={barlowUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={`${base}images/logo-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}images/logo-icon.png`} />
    <script type="application/ld+json" set:html={jsonLd(localBusinessJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={jsonLd(faqJsonLd)} />}
    <slot name="head" />
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        // A GTM "Data Layer Variable" named page_url_clean is the page URL without one-time ids or typed towns: use it
        // instead of the built-in Page URL in GA4 tags (see the activation notes).
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ page_url_clean: (function () { try { var u = new URL(location.href); ['lead', 'svc', 'src', 'ha', 'town_other', 'status'].forEach(function (k) { u.searchParams.delete(k); }); return u.toString(); } catch (e) { return location.href; } })() });
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    {ga4Id && !gtmId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          // Report the page URL without one-time confirmation ids or visitor-typed towns (UTM tags are kept for attribution).
          window.gtag('config', ga4Id, {
            page_location: (function () {
              try {
                var u = new URL(location.href);
                ['lead', 'svc', 'src', 'ha', 'town_other', 'status'].forEach(function (k) { u.searchParams.delete(k); });
                return u.toString();
              } catch (e) { return location.href; }
            })(),
          });
        </script>
      </>
    )}
    <style is:global>
      :root {
        /* The tokens come from design/tokens.json (rendered to design/tokens.css). The names below are the old
           variable names that page-level styles still use; they now point at the design tokens so every page
           shares one palette. */
        --black: var(--color-dark);
        --ink: var(--color-text);
        --ink-soft: var(--color-text-muted);
        --ink-muted: var(--color-text-muted);
        --line: var(--color-border);
        --line-2: var(--color-border);
        --paper: var(--color-bg);
        --paper-2: var(--color-surface);
        --paper-3: var(--color-border);
        --highlight: var(--color-tint);
        --red: var(--color-action);
        --red-dark: var(--color-action-hover);
        --gold: var(--color-star);
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { -webkit-text-size-adjust: 100%; scroll-padding-top: 1rem; }
      @media (min-width: 900px) { html { scroll-padding-top: 5rem; } }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: var(--leading-body);
        -webkit-font-smoothing: antialiased;
      }
      .skip-link { position: absolute; left: .5rem; top: -4rem; z-index: 100; background: var(--color-dark); color: var(--color-ink-on-dark); padding: .75rem 1rem; border-radius: var(--radius-md); font-weight: 700; }
      .skip-link:focus { top: .5rem; }
      main:focus { outline: none; }
      :focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
      .on-dark :focus-visible, .on-dark:focus-visible { outline-color: var(--color-ink-on-dark); }
      /* Touch targets: at least 44 px tall. Stand-alone text links get a 44 px hit area; links inside sentences get 24+ px (WCAG 2.5.8). */
      .hero-alt a, .more-link a, .back-link a, .services-all a, .direct-email-alt a, .contact-list a, .trust-email a, .nf-links a { display: inline-flex; align-items: center; min-height: 44px; }
      .breadcrumb a { display: inline-flex; align-items: center; min-height: 44px; }
      .homeowner-qa p a, .qa-send a { padding-block: 3px; }
      h1, h2 {
        font-family: var(--font-display);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .005em;
        line-height: var(--leading-tight);
        color: var(--color-text);
        margin: 0;
      }
      h3, h4 {
        font-family: var(--font-body);
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.25;
        color: var(--color-text);
        margin: 0;
      }
      h1 { font-size: clamp(2.7rem, 9.5vw, 4.5rem); }
      h2 { font-size: clamp(2rem, 6.5vw, 2.9rem); }
      .display-serif { font: inherit; letter-spacing: inherit; color: inherit; text-decoration: none; }
      a { color: var(--color-text); text-decoration: none; }
      p a:not(.btn), figcaption a, li > a.inline, dd a { text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }
      p a:not(.btn):hover { text-decoration-thickness: 2px; }
      img { max-width: 100%; display: block; }
      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
      @media (min-width: 768px) { .container { padding: 0 1.5rem; } }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
        min-height: 48px;
        padding: .6rem 1.4rem;
        border: 2px solid transparent;
        border-radius: var(--radius-md);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.2rem;
        line-height: 1.1;
        letter-spacing: .03em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
      }
      .btn-sm { min-height: 44px; padding: .4rem .9rem; font-size: 1.1rem; }
      .btn-primary { background: var(--color-action); border-color: var(--color-action); color: var(--color-action-text); }
      .btn-primary:hover { background: var(--color-action-hover); border-color: var(--color-action-hover); color: var(--color-action-text); }
      .btn-dark { background: var(--color-dark); border-color: var(--color-dark); color: var(--color-ink-on-dark); }
      .btn-dark:hover { background: var(--color-action); border-color: var(--color-action); color: var(--color-action-text); }
      .btn-secondary, .btn-ghost { background: var(--color-surface); border-color: var(--color-text); color: var(--color-text); }
      .btn-secondary:hover, .btn-ghost:hover { background: var(--color-text); color: var(--color-ink-on-dark); }
      .btn-ghost-dark { background: transparent; border-color: var(--color-ink-on-dark); color: var(--color-ink-on-dark); }
      .btn-ghost-dark:hover { background: var(--color-ink-on-dark); color: var(--color-dark); }
    </style>
  </head>
  <body data-track-events data-page-type={pageType} data-page-meta={JSON.stringify(pageMeta)}>
    <a class="skip-link" href="#main">Skip to main content</a>
    {header && <SiteHeader current={current} />}
    <slot />
    {footer && <SiteFooter />}
    <script is:inline>
      // First-party event layer. Pushes conversion events to window.dataLayer (consumed by GTM/GA4
      // only when configured) and remembers first-touch attribution for the service form.
      (() => {
        const w = window;
        const body = document.body;
        const pageType = body.dataset.pageType || 'page';
        let pageMeta = {};
        try { pageMeta = JSON.parse(body.dataset.pageMeta || '{}'); } catch (_) {}
        w.dataLayer = w.dataLayer || [];
        const track = (event, params) => {
          const payload = Object.assign({ page_type: pageType, page_path: location.pathname }, pageMeta, params || {});
          w.dataLayer.push(Object.assign({ event }, payload));
          if (typeof w.gtag === 'function') w.gtag('event', event, payload);
        };
        w.smTrack = track;

        // Attribution is kept in sessionStorage only (cleared when the tab closes; never sent to analytics).
        //   first  : the first page of the visit. Written once and never overwritten.
        //   latest : a DIFFERENT campaign tag seen later in the same visit, kept separately.
        try {
          const q = new URLSearchParams(location.search);
          const clip = (v, n) => String(v || '').replace(/[\u0000-\u001F\u007F]/g, '').trim().slice(0, n);
          const tag = { utm_source: clip(q.get('utm_source'), 100), utm_medium: clip(q.get('utm_medium'), 100), utm_campaign: clip(q.get('utm_campaign'), 100) };
          const tagged = tag.utm_source || tag.utm_medium || tag.utm_campaign;
          const stored = JSON.parse(sessionStorage.getItem('sm_attr') || '{}');
          if (!stored.first) {
            let ref = '';
            try {
              const r = new URL(document.referrer);
              if (r.origin !== location.origin) ref = r.origin + r.pathname;
            } catch (_) {}
            stored.first = Object.assign({ landing_page: location.pathname, referrer: ref.slice(0, 300) }, tag);
            sessionStorage.setItem('sm_attr', JSON.stringify(stored));
          } else if (tagged && JSON.stringify([stored.first.utm_source, stored.first.utm_medium, stored.first.utm_campaign]) !== JSON.stringify([tag.utm_source, tag.utm_medium, tag.utm_campaign])) {
            stored.latest = tag;
            sessionStorage.setItem('sm_attr', JSON.stringify(stored));
          }
        } catch (_) {}

        if (pageType === 'service') track('service_page_view');
        if (pageType === 'town') track('town_page_view');

        // Only enumerated ids ever go into event parameters (never names, phones, emails, addresses or free text).
        const ID = /^[a-z0-9-]{1,60}$/;
        document.addEventListener('click', (e) => {
          const link = e.target.closest && e.target.closest('a[href]');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          const section = link.closest('[id], section, header, footer');
          const where = section ? section.id || section.className.split(' ')[0] || section.tagName.toLowerCase() : 'page';
          const params = { link_location: where };
          if (href.startsWith('tel:')) track('phone_click', params);
          else if (href.startsWith('sms:')) track('sms_click', params);
          else if (/\/contact\/?(?:[?#]|$)/.test(href)) {
            try {
              const q = new URL(href, location.href).searchParams;
              if (ID.test(q.get('service') || '')) params.service_type = q.get('service');
              if (ID.test(q.get('town') || '')) params.town = q.get('town');
            } catch (_) {}
            track('request_form_click', params);
          }
        });
      })();
    </script>
  </body>
</html>
