---
// One variable Inter (400-900 in a single ~48 KB file) replaces six static weights, and only the
// Fraunces weight the wordmark actually uses is loaded.
import "../styles/fonts.css";
import "@fontsource/fraunces/latin-500.css";

import interVariableUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import services from '../services.json';
import { TOWNS } from '../lib/service-area.js';

export interface Props {
  title?: string;
  description?: string;
  /** Utility pages (thank-you, 404) stay out of the index and carry no canonical. */
  noindex?: boolean;
  /** Used by the event layer: home | services-hub | service | town | contact | lead-confirmation | not-found */
  pageType?: string;
  /** Extra event parameters, e.g. { service: 'boiler-service' } */
  pageMeta?: Record<string, string>;
  /** FAQ entries that are VISIBLY rendered on this page. Only then is FAQPage schema emitted. */
  faqs?: { q: string; a: string }[];
}

const {
  title = 'S. Meredith Plumbing & Heating | Saugus, MA Plumber',
  description = 'Owner-operated plumber in Saugus, MA. Water heaters, boilers, gas lines, remodels and 24/7 emergency service. Licensed and insured. Call 781-820-4592.',
  noindex = false,
  pageType = 'page',
  pageMeta = {},
  faqs = [],
} = Astro.props;

const site = 'https://smeredithplumbing.com';
const phone = '781-820-4592';
const publicEmail = 'shane@smeredithplumbing.com';
const business = 'S. Meredith Plumbing & Heating';
// Approved website service-area set (owner boundary map, 2026-05-28), read from the single canonical
// list in src/service-area.json. It must match the GBP service areas.
const areaServed = TOWNS.map((t) => t.name);

// Service-area business: locality only, never a street address. No aggregateRating/review markup
// (self-serving LocalBusiness reviews are not eligible for review snippets) and no regular
// openingHours until Shane confirms routine hours beyond 24/7 emergency availability.
const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': `${site}/#business`,
  name: business,
  url: `${site}/`,
  image: `${site}/images/logo.jpg`,
  logo: `${site}/images/logo.jpg`,
  telephone: '+1-781-820-4592',
  email: publicEmail,
  priceRange: '$$',
  description: 'Owner-operated plumbing and heating company based in Saugus, MA, serving the North Shore and Boston: water heaters, boilers, gas lines, remodel and new-construction plumbing, and 24/7 emergency service.',
  founder: { '@type': 'Person', name: 'Shane Meredith' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Saugus',
    addressRegion: 'MA',
    postalCode: '01906',
    addressCountry: 'US',
  },
  areaServed: areaServed.map((city) => ({ '@type': 'City', name: `${city}, MA` })),
  sameAs: [
    'https://www.facebook.com/people/S-Meredith-Plumbing-Heating/61577781267131/',
    'https://www.instagram.com/s.meredith_plumbing_heating/',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Plumbing & Heating Services',
    itemListElement: [
      ...services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, url: `${site}/services/${s.slug}/` },
      })),
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'General Plumbing Service & Repair' } },
    ],
  },
};

const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? site).href;

const faqJsonLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

// Optional analytics. Nothing third-party loads unless an ID is configured at build time
// (and the privacy notice has been updated to disclose it).
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';
const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:site_name" content={business} />
    <meta property="og:image" content="https://smeredithplumbing.com/images/logo.jpg" />
    <meta name="theme-color" content="#1a120a" />
    <!-- The one body + headline font file, preloaded so the swap doesn't reflow the hero (CLS). -->
    <link rel="preload" href={interVariableUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={`${base}images/logo-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}images/logo-icon.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <slot name="head" />
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      </script>
    )}
    {ga4Id && !gtmId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', ga4Id);
        </script>
      </>
    )}
    <style is:global>
      :root {
        /* Tough, industrial-grade modern palette: deep soot charcoal base, solid masonry whites/greys, safety red.
           Retains subtle paper texture for premium craft personality but increases visual contrast and trade authority. */
        --black: #111111;
        --ink: #1f2937;
        --ink-soft: #4b5563;
        --ink-muted: #6b7280;
        --line: rgba(17, 17, 17, 0.08);
        --line-2: rgba(17, 17, 17, 0.15);
        --paper: #FAF9F6; /* premium linen warmth */
        --paper-2: #F3F1EB; /* masonry grey-white */
        --paper-3: #E7E4DC;
        --highlight: #fee2e2; /* pale safety red tint */
        --red: #d32f2f; /* safety red */
        --red-dark: #b71c1c;
        --gold: #c2902c;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { scroll-behavior: smooth; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        letter-spacing: -0.011em;
      }
      h1, h2, h3, h4 {
        font-family: 'Inter Variable', 'Inter', sans-serif;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: var(--black);
        margin: 0;
        line-height: 1.05;
      }
      h1 { letter-spacing: -0.04em; line-height: 1.02; }
      .display-serif {
        font-family: 'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
        font-weight: 900;
        font-style: normal;
        letter-spacing: -0.025em;
        color: var(--red);
        text-decoration: underline;
        text-decoration-color: rgba(211, 47, 47, 0.25);
        text-underline-offset: 4px;
        text-decoration-thickness: 3px;
      }
      a { color: var(--black); text-decoration: none; transition: color .15s ease, opacity .15s ease; }
      a:hover { opacity: 0.7; }
      img { max-width: 100%; display: block; }
      .container { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
      .btn {
        display: inline-flex; align-items: center; gap: .55rem;
        padding: 1rem 1.7rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.005em;
        transition: transform .18s ease, background .18s ease, box-shadow .18s ease, color .18s ease;
        cursor: pointer; border: none;
        font-family: inherit;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.02em;
      }
      .btn-primary {
        background: var(--red); color: #fff;
        box-shadow: 0 2px 4px rgba(17, 17, 17, 0.08);
      }
      .btn-primary:hover { background: var(--red-dark); color: #fff; opacity: 1; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(211,47,47,.28); }
      .btn-dark { background: var(--black); color: #fff; }
      .btn-dark:hover { background: #000; color: #fff; opacity: 1; transform: translateY(-1px); }
      .btn-ghost { background: transparent; color: var(--black); border: 2px solid var(--line-2); }
      .btn-ghost:hover { border-color: var(--black); opacity: 1; }
      .btn-secondary {
        background: var(--paper-3);
        color: var(--black);
        border: 1px solid var(--line-2);
        box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
      }
      .btn-secondary:hover {
        background: var(--paper-2);
        border-color: var(--black);
        transform: translateY(-1px);
        opacity: 1;
      }
      .btn-ghost-dark { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,.3); }
      .btn-ghost-dark:hover { border-color: #fff; color: #fff; opacity: 1; }
    </style>
  </head>
  <body data-track-events data-page-type={pageType} data-page-meta={JSON.stringify(pageMeta)}>
    <slot />
    <script is:inline>
      // First-party event layer. Pushes conversion events to window.dataLayer (consumed by GTM/GA4
      // only when configured) and remembers first-touch attribution for the service form.
      (() => {
        const w = window;
        const body = document.body;
        const pageType = body.dataset.pageType || 'page';
        let pageMeta = {};
        try { pageMeta = JSON.parse(body.dataset.pageMeta || '{}'); } catch (_) {}
        w.dataLayer = w.dataLayer || [];
        const track = (event, params) => {
          const payload = Object.assign({ page_type: pageType, page_path: location.pathname }, pageMeta, params || {});
          w.dataLayer.push(Object.assign({ event }, payload));
          if (typeof w.gtag === 'function') w.gtag('event', event, payload);
        };
        w.smTrack = track;

        // Attribution is kept in sessionStorage only (cleared when the tab closes; never sent to analytics).
        //   first  : the first page of the visit. Written once and never overwritten.
        //   latest : a DIFFERENT campaign tag seen later in the same visit, kept separately.
        try {
          const q = new URLSearchParams(location.search);
          const clip = (v, n) => String(v || '').replace(/[\u0000-\u001F\u007F]/g, '').trim().slice(0, n);
          const tag = { utm_source: clip(q.get('utm_source'), 100), utm_medium: clip(q.get('utm_medium'), 100), utm_campaign: clip(q.get('utm_campaign'), 100) };
          const tagged = tag.utm_source || tag.utm_medium || tag.utm_campaign;
          const stored = JSON.parse(sessionStorage.getItem('sm_attr') || '{}');
          if (!stored.first) {
            let ref = '';
            try {
              const r = new URL(document.referrer);
              if (r.origin !== location.origin) ref = r.origin + r.pathname;
            } catch (_) {}
            stored.first = Object.assign({ landing_page: location.pathname, referrer: ref.slice(0, 300) }, tag);
            sessionStorage.setItem('sm_attr', JSON.stringify(stored));
          } else if (tagged && JSON.stringify([stored.first.utm_source, stored.first.utm_medium, stored.first.utm_campaign]) !== JSON.stringify([tag.utm_source, tag.utm_medium, tag.utm_campaign])) {
            stored.latest = tag;
            sessionStorage.setItem('sm_attr', JSON.stringify(stored));
          }
        } catch (_) {}

        if (pageType === 'service') track('service_page_view');
        if (pageType === 'town') track('town_page_view');

        // Only enumerated ids ever go into event parameters (never names, phones, emails, addresses or free text).
        const ID = /^[a-z0-9-]{1,60}$/;
        document.addEventListener('click', (e) => {
          const link = e.target.closest && e.target.closest('a[href]');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          const section = link.closest('[id], section, header, footer');
          const where = section ? section.id || section.className.split(' ')[0] || section.tagName.toLowerCase() : 'page';
          const params = { link_location: where };
          if (href.startsWith('tel:')) track('phone_click', params);
          else if (href.startsWith('sms:')) track('sms_click', params);
          else if (/\/contact\/?(?:[?#]|$)/.test(href)) {
            try {
              const q = new URL(href, location.href).searchParams;
              if (ID.test(q.get('service') || '')) params.service_type = q.get('service');
              if (ID.test(q.get('town') || '')) params.town = q.get('town');
            } catch (_) {}
            track('request_form_click', params);
          }
        });
      })();
    </script>
  </body>
</html>
