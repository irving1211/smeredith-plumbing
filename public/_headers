# Cloudflare Pages response headers (static assets only; the /api/contact Function sets its own).
# nosniff and a strict referrer policy are already added by Pages, so they are not repeated here.

# Content-hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and logos keep their file names, so allow a day of freshness and serve stale while revalidating.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
