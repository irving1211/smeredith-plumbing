{
  "name": "smeredith-plumbing",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "astro build && node --test \"tests/*.test.mjs\"",
    "optimize:images": "node scripts/optimize-job-images.mjs",
    "test:e2e": "astro build && node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "build:geo": "node scripts/build-service-area-geo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "1.60",
    "sharp": "^0.35.5"
  }
}
